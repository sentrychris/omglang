  "semanticTokenColors": {
    "namespace": "#df8e1d",
    "function": "#1e66f5",
    "method": "#1e66f5",
    "function.defaultLibrary": "#209fb5",
    "method.defaultLibrary": "#209fb5",
    "variable": "#4c4f69",
    "variable.readonly": "#fe640b",
    "variable.defaultLibrary": "#d20f39",
    "variable.defaultLibrary.readonly": "#d20f39",
    "parameter": {
      "foreground": "#e64553",
      "italic": true
    },
    "property": "#7287fd",
    "type": "#df8e1d",
    "class": "#df8e1d",
    "enumMember": "#fe640b",
    "macro": "#179299"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7c7f93",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc tags",
      "scope": [
        "keyword.other.documentation.tag",
        "storage.type.class.jsdoc"
      ],
      "settings": {
        "foreground": "#8839ef",
        "fontStyle": ""
      }
    },
    {
      "name": "Doc parameter names",
      "scope": [
        "variable.parameter.documentation",
        "variable.other.jsdoc"
      ],
      "settings": {
        "foreground": "#e64553",
        "fontStyle": "italic"
      }
    },
    {
      "name": "TODO marks",
      "scope": "keyword.other.todo",
      "settings": {
        "foreground": "#df8e1d",
        "fontStyle": "bold"
      }
    },
    {
      "name": "File header",
      "scope": [
        "meta.preprocessor.header.omg",
        "punctuation.definition.directive.omg"
      ],
      "settings": {
        "foreground": "#7c7f93",
        "fontStyle": ""
      }
    },
    {
      "name": "File header name",
      "scope": "keyword.control.directive.omg",
      "settings": {
        "foreground": "#ea76cb",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#8839ef",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#04a5e5",
        "fontStyle": ""
      }
    },
    {
      "name": "Word operators",
      "scope": [
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.new",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#8839ef",
        "fontStyle": ""
      }
    },
    {
      "name": "Raising an error",
      "scope": "keyword.control.exception.throw",
      "settings": {
        "foreground": "#d20f39",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#40a02b",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#ea76cb",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers and booleans",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#fe640b",
        "fontStyle": ""
      }
    },
    {
      "name": "Constants",
      "scope": [
        "variable.other.constant",
        "constant.other",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#fe640b",
        "fontStyle": ""
      }
    },
    {
      "name": "Procs and calls",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#1e66f5",
        "fontStyle": ""
      }
    },
    {
      "name": "Builtins",
      "scope": [
        "support.function.builtin",
        "support.function.intrinsic"
      ],
      "settings": {
        "foreground": "#209fb5",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#e64553",
