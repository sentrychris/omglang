  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7f849c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc tags",
      "scope": [
        "keyword.other.documentation.tag",
        "storage.type.class.jsdoc"
      ],
      "settings": {
        "foreground": "#cba6f7",
        "fontStyle": ""
      }
    },
    {
      "name": "Doc parameter names",
      "scope": [
        "variable.parameter.documentation",
        "variable.other.jsdoc"
      ],
      "settings": {
        "foreground": "#eba0ac",
        "fontStyle": "italic"
      }
    },
    {
      "name": "TODO marks",
      "scope": "keyword.other.todo",
      "settings": {
        "foreground": "#f9e2af",
        "fontStyle": "bold"
      }
    },
    {
      "name": "File header",
      "scope": [
        "meta.preprocessor.header.omg",
        "punctuation.definition.directive.omg"
      ],
      "settings": {
        "foreground": "#7f849c",
        "fontStyle": ""
      }
    },
    {
      "name": "File header name",
      "scope": "keyword.control.directive.omg",
      "settings": {
        "foreground": "#f5c2e7",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#cba6f7",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#89dceb",
        "fontStyle": ""
      }
    },
    {
      "name": "Word operators",
      "scope": [
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.new",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#cba6f7",
        "fontStyle": ""
      }
    },
    {
      "name": "Raising an error",
      "scope": "keyword.control.exception.throw",
      "settings": {
        "foreground": "#f38ba8",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#a6e3a1",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#f5c2e7",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers and booleans",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#fab387",
        "fontStyle": ""
      }
    },
    {
      "name": "Constants",
      "scope": [
        "variable.other.constant",
        "constant.other",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#fab387",
        "fontStyle": ""
      }
    },
    {
      "name": "Procs and calls",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#89b4fa",
        "fontStyle": ""
      }
    },
    {
      "name": "Builtins",
      "scope": [
        "support.function.builtin",
        "support.function.intrinsic"
      ],
      "settings": {
        "foreground": "#74c7ec",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#eba0ac",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#cdd6f4",
        "fontStyle": ""
      }
