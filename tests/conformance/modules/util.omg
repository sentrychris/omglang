;;;omg

# A module imported by shapes.omg and by tests/conformance/modules.omg.

alloc PREFIX := "<"
alloc SUFFIX := "> "
alloc calls := 0

proc times(a, b) {
    calls := calls + 1
    return a * b
}

proc label(name) {
    return PREFIX + name + SUFFIX
}

proc call_count() {
    return calls
}

proc fact(n) {
    if n <= 1 {
        return 1
    }
    return n * fact(n - 1)
}

proc apply_twice(f, x) {
    return f(f(x))
}
