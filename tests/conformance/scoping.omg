;;;omg

# Conformance: `alloc`, `:=` and where a name lives.
#
# The rules every backend must agree on:
#   1. A new name needs `alloc`. A bare `:=` on a name that was never
#      declared raises UndefinedIdentError.
#   2. After that, a bare `:=` assigns to the existing name.
#   3. A name declared inside a proc is local to it.
#   4. A proc can read and assign a global with a bare `:=`.
#
# Only the error kind is printed, because the wording after the colon is
# allowed to differ between backends.

proc kind(err) {
    alloc s := "" + err
    alloc i := 0
    loop i < length(s) {
        if s[i] == ":" {
            return s[0:i]
        }
        i := i + 1
    }
    return s
}

# --- Rule 1: a new name needs alloc -----------------------------------------
try {
    nope := 99
    emit "a bare := created a global"
} except err {
    emit "new name at top level: " + kind(err)
}

# The usual way to meet this rule: a typo for a name that does exist.
alloc counter := 0
proc typo_inside() {
    couner := 1
    return couner
}
try {
    typo_inside()
    emit "a bare := created a local"
} except err {
    emit "typo inside a proc: " + kind(err)
}
emit counter

# --- Rule 2: := assigns to what alloc declared ------------------------------
alloc a := 5
a := 1
emit a

alloc i := 0
loop i < 3 {
    i := i + 1
}
emit i

# Parameters are locals that are already declared.
proc bump(x) {
    x := x + 100
    return x
}
emit bump(1)

proc reparam(x) {
    x := x * 10
    x := x + 1
    return x
}
emit reparam(5)

# --- Rule 3: locals stay inside their proc ----------------------------------
proc local_only() {
    alloc tmp := "hidden"
    return length(tmp)
}
emit local_only()
try {
    emit tmp
} except err {
    emit "local read from outside: " + kind(err)
}
try {
    tmp := "set from outside"
    emit "a local was assigned from outside"
} except err {
    emit "local assigned from outside: " + kind(err)
}

# A block is not a scope. A name declared inside a loop or an `if` body
# belongs to the enclosing proc (or to the top level) and outlives the
# block.
alloc k := 0
loop k < 1 {
    alloc inside_loop := "declared in a loop"
    k := k + 1
}
emit inside_loop

if k == 1 {
    alloc inside_if := "declared in an if"
}
emit inside_if

proc block_local() {
    alloc n := 0
    loop n < 2 {
        alloc last := n * 10
        n := n + 1
    }
    return last
}
emit block_local()

# Inside a proc, the branches of an `if` may each declare the same name.
proc pick(flag) {
    if flag {
        alloc chosen := "then"
    } else {
        alloc chosen := "else"
    }
    return chosen
}
emit pick(true)
emit pick(false)

# --- Rule 4: a proc reads and assigns globals -------------------------------
proc hoist(n) {
    a := n
}
hoist(3)
emit a

alloc r := 1
proc bump_r() {
    r := r + 1
}
bump_r()
bump_r()
bump_r()
emit r

# The names the runtime provides are ordinary globals. (What
# `module_file` holds depends on how the program is run, so it is only
# compared with itself.)
proc read_module_file() {
    return module_file
}
emit read_module_file() == module_file

proc read_args() {
    return length(args)
}
emit read_args() == length(args)

# --- alloc inside a proc shadows a global of the same name ------------------
alloc s := "outer"
proc shadow_test() {
    alloc s := "inner"
    s := s + "!"
    return s
}
emit shadow_test()
emit s

# That holds for the runtime's globals too: a proc with its own `args`
# leaves the program's `args` alone.
proc with_local_args() {
    alloc args := [99, 100, 101]
    return length(args)
}
alloc args_before := length(args)
emit with_local_args()
emit length(args) == args_before

emit "done"
