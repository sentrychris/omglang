;;;omg

# Literals with many items. Each piece of code keeps the values it is
# working on in a stack, and a list or a dict written out in one piece
# puts all its items there before it is made: the stack has to be as
# large as the largest of them, in a proc and at the top level, also
# when one sits inside another. (A program built through C once kept
# 256 values for a proc and 1024 at the top level, whatever it held.)
# This file is generated: the numbers are the items' positions.

proc sum_list(xs) {
    alloc total := 0
    for x in xs {
        if type_of(x) == 2 {
            total := total + x
        }
    }
    return total
}

proc sum_dict(d) {
    alloc total := 0
    for k in dict_keys(d) {
        total := total + d[k]
    }
    return total
}

