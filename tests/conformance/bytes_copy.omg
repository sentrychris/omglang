;;;omg
# bytes_copy(src, from, dst, to, count): a run of bytes from one byte
# list into another, or into the same one. Sizes round the ones the
# runtime copies in one move (4, 8, 16), overlap both ways, the edges
# of both lists, and what it refuses, by kind of error.

proc show(label, v) {
    emit label + ": " + v
    return false
}

proc kind(e) {
    alloc text := "" + e
    alloc n := 0
    loop n < length(text) and text[n] != ":" {
        n := n + 1
    }
    return text[0:n]
}

proc count_up(n) {
    alloc b := bytes_repeat(0, n)
    alloc i := 0
    loop i < n {
        b[i] := i + 1
        i := i + 1
    }
    return b
}

# --- between two lists ---------------------------------------------------------
proc sizes() {
    alloc a := count_up(20)
    for n in [0, 1, 2, 3, 4, 5, 7, 8, 9, 15, 16, 17, 20] {
        alloc c := bytes_repeat(0, 22)
        bytes_copy(a, 20 - n, c, 1, n)
        show("" + n + " bytes", c)
    }
    alloc d := bytes_repeat(9, 6)
    show("what it gives back", bytes_copy(a, 0, d, 0, 3) == bytes_copy(a, 0, d, 3, 3))
    show("twice into one", d)
    bytes_copy(a, 17, d, 3, 3)
    show("the end of one to the end of the other", d)
    bytes_copy(a, 20, d, 6, 0)
    show("nothing, from the end to the end", d)
    return false
}
sizes()

# --- inside one list -----------------------------------------------------------
proc overlap() {
    for n in [1, 3, 4, 7, 8, 10, 16, 17] {
        alloc up := count_up(20)
        bytes_copy(up, 0, up, 3, n)
        show("" + n + " up by three", up)
        alloc down := count_up(20)
        bytes_copy(down, 3, down, 0, n)
        show("" + n + " down by three", down)
        alloc one := count_up(20)
        bytes_copy(one, 0, one, 1, n)
        show("" + n + " up by one", one)
        alloc same := count_up(20)
        bytes_copy(same, 2, same, 2, n)
        show("" + n + " onto itself", same == count_up(20))
    }
    return false
}
overlap()

# --- rows of a picture, as a decoder copies them --------------------------------
proc rows(w, h) {
    alloc src := count_up(w * h)
    alloc dst := bytes_repeat(0, (w + 2) * h)
    alloc y := 0
    loop y < h {
        bytes_copy(src, y * w, dst, y * (w + 2) + 1, w)
        y := y + 1
    }
    alloc total := 0
    for v in dst { total := total + v }
    return total
}
show("rows of 4", rows(4, 4))
show("rows of 8", rows(8, 8))
show("rows of 16", rows(16, 12))

# --- what it refuses -----------------------------------------------------------
proc tryit(label, s, f, d, t, n) {
    try {
        bytes_copy(s, f, d, t, n)
        show(label, "copied")
    } except e {
        show(label, kind(e))
    }
    return false
}
proc refusals() {
    alloc a := count_up(20)
    alloc b := bytes_repeat(0, 24)
    tryit("one more than the source has", a, 0, b, 0, 21)
    tryit("off the end of the source", a, 1, b, 0, 20)
    tryit("a source index below zero", a, -1, b, 0, 2)
    tryit("off the end of the destination", a, 0, b, 5, 20)
    tryit("a destination index below zero", a, 0, b, -1, 2)
    tryit("a count below zero", a, 0, b, 0, -1)
    tryit("nothing from past the end", a, 21, b, 0, 0)
    tryit("nothing to past the end", a, 0, b, 25, 0)
    tryit("numbers that would wrap round", a, 9223372036854775807, b, 0, 9223372036854775807)
    tryit("an index that would wrap round", a, 0, b, 9223372036854775807, 2)
    tryit("from a list", [1, 2], 0, b, 0, 2)
    tryit("to a list", a, 0, [1, 2], 0, 2)
    tryit("from a string", "abc", 0, b, 0, 2)
    tryit("a float index", a, 0.0, b, 0, 2)
    tryit("a string index", a, 0, b, "0", 2)
    tryit("a float count", a, 0, b, 0, 2.0)
    show("untouched by all that", b == bytes_repeat(0, 24))
    return false
}
refusals()

# --- by name, as the interpreter calls every builtin ----------------------------
alloc g := count_up(8)
alloc out := bytes_repeat(0, 4)
call_builtin("bytes_copy", [g, 2, out, 0, 4])
show("call_builtin", out)
