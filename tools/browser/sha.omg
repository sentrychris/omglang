;;;omg

# tools/browser/sha.omg
#
# The SHA-2 hashes (FIPS 180-4) and what is built on them: HMAC
# (RFC 2104) and HKDF (RFC 5869). Everything takes and gives byte
# lists.
#
# OMG's integers are 64 bits and `+` refuses to overflow, so SHA-256
# keeps its 32-bit words in the low half of an integer and masks, and
# SHA-512 adds its 64-bit words as two 32-bit halves.

alloc K256 := [
    1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,
    3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,
    3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,
    2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895,
    666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037,
    2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,
    430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,
    1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298
]

alloc H256 := [
    1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225
]

alloc K512H := [
    1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,
    3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,
    3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,
    2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895,
    666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037,
    2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,
    430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,
    1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298,
    3391569614, 3515267271, 3940187606, 4118630271, 116418474, 174292421, 289380356, 460393269,
    685471733, 852142971, 1017036298, 1126000580, 1288033470, 1501505948, 1607167915, 1816402316
]

alloc K512L := [
    3609767458, 602891725, 3964484399, 2173295548, 4081628472, 3053834265, 2937671579, 3664609560,
    2734883394, 1164996542, 1323610764, 3590304994, 4068182383, 991336113, 633803317, 3479774868,
    2666613458, 944711139, 2341262773, 2007800933, 1495990901, 1856431235, 3175218132, 2198950837,
    3999719339, 766784016, 2566594879, 3203337956, 1034457026, 2466948901, 3758326383, 168717936,
    1188179964, 1546045734, 1522805485, 2643833823, 2343527390, 1014477480, 1206759142, 344077627,
    1290863460, 3158454273, 3505952657, 106217008, 3606008344, 1432725776, 1467031594, 851169720,
    3100823752, 1363258195, 3750685593, 3785050280, 3318307427, 3812723403, 2003034995, 3602036899,
    1575990012, 1125592928, 2716904306, 442776044, 593698344, 3733110249, 2999351573, 3815920427,
    3928383900, 566280711, 3454069534, 4000239992, 1914138554, 2731055270, 3203993006, 320620315,
    587496836, 1086792851, 365543100, 2618297676, 3409855158, 4234509866, 987167468, 1246189591
]

alloc H512 := [
    1779033703, 4089235720, 3144134277, 2227873595, 1013904242, 4271175723, 2773480762, 1595750129,
    1359893119, 2917565137, 2600822924, 725511199, 528734635, 4215389547, 1541459225, 327033209
]

alloc H384 := [
    3418070365, 3238371032, 1654270250, 914150663, 2438529370, 812702999, 355462360, 4144912697,
    1731405415, 4290775857, 2394180231, 1750603025, 3675008525, 1694076839, 1203062813, 3204075428
]

alloc M32 := 4294967295

proc sha256(msg) {
    alloc n := length(msg)
    alloc total := ((n + 9 + 63) // 64) * 64
    alloc m := bytes_repeat(0, total)
    bytes_copy(msg, 0, m, 0, n)
    m[n] := 128
    alloc bits := n * 8
    alloc i := 0
    loop i < 8 {
        m[total - 1 - i] := (bits >> (i * 8)) & 255
        i := i + 1
    }
    alloc h0 := H256[0]
    alloc h1 := H256[1]
    alloc h2 := H256[2]
    alloc h3 := H256[3]
    alloc h4 := H256[4]
    alloc h5 := H256[5]
    alloc h6 := H256[6]
    alloc h7 := H256[7]
    alloc w := list_repeat(0, 64)
    alloc off := 0
    loop off < total {
        i := 0
        alloc p := off
        loop i < 16 {
            w[i] := (m[p] << 24) | (m[p + 1] << 16) | (m[p + 2] << 8) | m[p + 3]
            p := p + 4
            i := i + 1
        }
        loop i < 64 {
            alloc x := w[i - 15]
            alloc y := w[i - 2]
            alloc s0 := ((x >> 7) | (x << 25)) ^ ((x >> 18) | (x << 14)) ^ (x >> 3)
            alloc s1 := ((y >> 17) | (y << 15)) ^ ((y >> 19) | (y << 13)) ^ (y >> 10)
            w[i] := (w[i - 16] + (s0 & M32) + w[i - 7] + (s1 & M32)) & M32
            i := i + 1
        }
        alloc a := h0
        alloc b := h1
        alloc c := h2
        alloc d := h3
        alloc e := h4
        alloc f := h5
        alloc g := h6
        alloc hh := h7
        i := 0
        loop i < 64 {
            alloc t1 := hh + ((((e >> 6) | (e << 26)) ^ ((e >> 11) | (e << 21)) ^ ((e >> 25) | (e << 7))) & M32) + ((e & f) ^ ((~e) & g)) + K256[i] + w[i]
            alloc t2 := ((((a >> 2) | (a << 30)) ^ ((a >> 13) | (a << 19)) ^ ((a >> 22) | (a << 10))) & M32) + ((a & b) ^ (a & c) ^ (b & c))
            hh := g
            g := f
            f := e
            e := (d + t1) & M32
            d := c
            c := b
            b := a
            a := (t1 + t2) & M32
            i := i + 1
        }
        h0 := (h0 + a) & M32
        h1 := (h1 + b) & M32
        h2 := (h2 + c) & M32
        h3 := (h3 + d) & M32
        h4 := (h4 + e) & M32
        h5 := (h5 + f) & M32
        h6 := (h6 + g) & M32
        h7 := (h7 + hh) & M32
        off := off + 64
    }
    alloc out := bytes_repeat(0, 32)
    alloc hs := [h0, h1, h2, h3, h4, h5, h6, h7]
    i := 0
    loop i < 8 {
        alloc v := hs[i]
        out[i * 4] := v >> 24
        out[i * 4 + 1] := (v >> 16) & 255
        out[i * 4 + 2] := (v >> 8) & 255
        out[i * 4 + 3] := v & 255
        i := i + 1
    }
    return out
}

# a + b for 64-bit words, wrapping round
proc add64(a, b) {
    alloc lo := (a & M32) + (b & M32)
    return ((((a >> 32) & M32) + ((b >> 32) & M32) + (lo >> 32)) << 32) | (lo & M32)
}

# SHA-512 and its shorter sister: `iv` is the starting state as 16
# halves, `size` how many bytes of the result are kept.
proc sha512_core(msg, iv, size) {
    alloc n := length(msg)
    alloc total := ((n + 17 + 127) // 128) * 128
    alloc m := bytes_repeat(0, total)
    bytes_copy(msg, 0, m, 0, n)
    m[n] := 128
    alloc bits := n * 8
    alloc i := 0
    loop i < 8 {
        m[total - 1 - i] := (bits >> (i * 8)) & 255
        i := i + 1
    }
    alloc h := list_repeat(0, 8)
    i := 0
    loop i < 8 {
        h[i] := (iv[i * 2] << 32) | iv[i * 2 + 1]
        i := i + 1
    }
    alloc w := list_repeat(0, 80)
    alloc off := 0
    loop off < total {
        i := 0
        alloc p := off
        loop i < 16 {
            w[i] := (m[p] << 56) | (m[p + 1] << 48) | (m[p + 2] << 40) | (m[p + 3] << 32) | (m[p + 4] << 24) | (m[p + 5] << 16) | (m[p + 6] << 8) | m[p + 7]
            p := p + 8
            i := i + 1
        }
        loop i < 80 {
            alloc x := w[i - 15]
            alloc y := w[i - 2]
            alloc s0 := (((x >> 1) & 9223372036854775807) | (x << 63)) ^ (((x >> 8) & 72057594037927935) | (x << 56)) ^ ((x >> 7) & 144115188075855871)
            alloc s1 := (((y >> 19) & 35184372088831) | (y << 45)) ^ (((y >> 61) & 7) | (y << 3)) ^ ((y >> 6) & 288230376151711743)
            alloc a1 := w[i - 16]
            alloc a2 := w[i - 7]
            alloc lo := (a1 & M32) + (s0 & M32) + (a2 & M32) + (s1 & M32)
            w[i] := ((((a1 >> 32) & M32) + ((s0 >> 32) & M32) + ((a2 >> 32) & M32) + ((s1 >> 32) & M32) + (lo >> 32)) << 32) | (lo & M32)
            i := i + 1
        }
        alloc a := h[0]
        alloc b := h[1]
        alloc c := h[2]
        alloc d := h[3]
        alloc e := h[4]
        alloc f := h[5]
        alloc g := h[6]
        alloc hh := h[7]
        i := 0
        loop i < 80 {
            alloc big1 := (((e >> 14) & 1125899906842623) | (e << 50)) ^ (((e >> 18) & 70368744177663) | (e << 46)) ^ (((e >> 41) & 8388607) | (e << 23))
            alloc ch := (e & f) ^ ((~e) & g)
            alloc wi := w[i]
            alloc tl := (hh & M32) + (big1 & M32) + (ch & M32) + K512L[i] + (wi & M32)
            alloc th := (((hh >> 32) & M32) + ((big1 >> 32) & M32) + ((ch >> 32) & M32) + K512H[i] + ((wi >> 32) & M32) + (tl >> 32)) & M32
            tl := tl & M32
            alloc big0 := (((a >> 28) & 68719476735) | (a << 36)) ^ (((a >> 34) & 1073741823) | (a << 30)) ^ (((a >> 39) & 33554431) | (a << 25))
            alloc maj := (a & b) ^ (a & c) ^ (b & c)
            hh := g
            g := f
            f := e
            alloc el := (d & M32) + tl
            e := ((((d >> 32) & M32) + th + (el >> 32)) << 32) | (el & M32)
            d := c
            c := b
            b := a
            alloc al := tl + (big0 & M32) + (maj & M32)
            a := ((th + ((big0 >> 32) & M32) + ((maj >> 32) & M32) + (al >> 32)) << 32) | (al & M32)
            i := i + 1
        }
        h[0] := add64(h[0], a)
        h[1] := add64(h[1], b)
        h[2] := add64(h[2], c)
        h[3] := add64(h[3], d)
        h[4] := add64(h[4], e)
        h[5] := add64(h[5], f)
        h[6] := add64(h[6], g)
        h[7] := add64(h[7], hh)
        off := off + 128
    }
    alloc out := bytes_repeat(0, size)
    i := 0
    loop i < size {
        out[i] := (h[i >> 3] >> (56 - (i & 7) * 8)) & 255
        i := i + 1
    }
    return out
}

proc sha384(msg) {
    return sha512_core(msg, H384, 48)
}

proc sha512(msg) {
    return sha512_core(msg, H512, 64)
}

# The hash called `alg`: "sha256", "sha384" or "sha512".
proc hash(alg, msg) {
    if alg == "sha256" {
        return sha256(msg)
    }
    if alg == "sha384" {
        return sha384(msg)
    }
    return sha512(msg)
}

# How many bytes hash `alg` gives.
proc size(alg) {
    if alg == "sha256" {
        return 32
    }
    if alg == "sha384" {
        return 48
    }
    return 64
}

proc hmac(alg, key, msg) {
    alloc block := 128
    if alg == "sha256" {
        block := 64
    }
    if length(key) > block {
        key := hash(alg, key)
    }
    alloc n := length(msg)
    alloc inner := bytes_repeat(54, block + n)
    alloc outer := bytes_repeat(92, block)
    alloc i := 0
    loop i < length(key) {
        inner[i] := key[i] ^ 54
        outer[i] := key[i] ^ 92
        i := i + 1
    }
    bytes_copy(msg, 0, inner, block, n)
    return hash(alg, outer + hash(alg, inner))
}

proc hkdf_extract(alg, salt, ikm) {
    if length(salt) == 0 {
        salt := bytes_repeat(0, size(alg))
    }
    return hmac(alg, salt, ikm)
}

proc hkdf_expand(alg, prk, info, count) {
    alloc out := to_bytes([])
    alloc t := to_bytes([])
    alloc k := 1
    loop length(out) < count {
        t := hmac(alg, prk, t + info + to_bytes([k]))
        out := out + t
        k := k + 1
    }
    return out[0:count]
}
