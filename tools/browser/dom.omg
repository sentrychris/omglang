    return wrap_list(query(node, to_str(arg(args, 0)), false))
}

proc n_matches(this, args) {
    return node_matches(el_of(this, "matches"), to_str(arg(args, 0)))
}

proc n_closest(this, args) {
    alloc node := el_of(this, "closest")
    alloc text := to_str(arg(args, 0))
    alloc cur := node
    loop cur != false and cur.t == 1 {
        if node_matches(cur, text) {
            return wrap(cur)
        }
        cur := parent_of(cur)
    }
    return 0
}

proc n_get_elements_by_tag_name(this, args) {
    alloc node := node_of(this, "getElementsByTagName")
    if node.t == 3 or node.t == 8 {
        return wrap_list([])
    }
    return wrap_list(collect(node, u.lower(to_str(arg(args, 0))), [], []))
}

proc n_get_elements_by_class_name(this, args) {
    alloc node := node_of(this, "getElementsByClassName")
    alloc names := u.words(to_str(arg(args, 0)))
    if node.t == 3 or node.t == 8 or length(names) == 0 {
        return wrap_list([])
    }
    return wrap_list(collect(node, "", names, []))
}

proc find_id(node, id) {
    for k in node.kids {
        if k.t == 1 {
            if has_key(k.attrs, "id") and k.attrs["id"] == id {
                return k
            }
            alloc r := find_id(k, id)
            if r != false {
                return r
            }
        }
    }
    return false
}

proc n_get_element_by_id(this, args) {
    alloc node := node_of(this, "getElementById")
    alloc id := to_str(arg(args, 0))
    if node.t == 9 {
        return wrap(by_id(id))
    }
    if node.t == 3 or node.t == 8 {
        return 0
    }
    return wrap(find_id(node, id))
}

proc n_insert_adjacent_html(this, args) {
    alloc node := el_of(this, "insertAdjacentHTML")
    alloc where := u.lower(to_str(arg(args, 0)))
    alloc text := to_str(arg(args, 1))
    alloc parent := node
    alloc ref := false
    if where == "beforebegin" or where == "afterend" {
        parent := parent_of(node)
        if parent == false {
            dom_error("NoModificationAllowedError", "The element has no parent.")
        }
        ref := node
        if where == "afterend" {
            ref := sibling(node, 1, false)
        }
    } elif where == "afterbegin" {
        if length(node.kids) > 0 {
            ref := node.kids[0]
        }
    } elif where != "beforeend" {
        dom_error("SyntaxError", "The value provided ('" + where + "') is not one of 'beforebegin', 'afterbegin', 'beforeend', or 'afterend'.")
    }
    alloc context := "div"
    if parent.t == 1 {
        context := parent.tag
    }
    for n in fragment_nodes(text, context) {
        insert_before(parent, n, ref)
    }
    return U
}

proc insert_adjacent(node, where, what) {
    if where == "beforebegin" or where == "afterend" {
        alloc parent := parent_of(node)
        if parent == false {
            return false
        }
        if where == "afterend" {
            insert_before(parent, what, sibling(node, 1, false))
        } else {
            insert_before(parent, what, node)
        }
    } elif where == "afterbegin" {
        alloc first := false
        if length(node.kids) > 0 {
            first := node.kids[0]
        }
        insert_before(node, what, first)
    } else {
        insert_before(node, what, false)
    }
    return true
}

proc n_insert_adjacent_element(this, args) {
    alloc node := el_of(this, "insertAdjacentElement")
    insert_adjacent(node, u.lower(to_str(arg(args, 0))), arg_node(args, 1, "insertAdjacentElement"))
    return arg(args, 1)
}

proc n_insert_adjacent_text(this, args) {
    alloc node := el_of(this, "insertAdjacentText")
    insert_adjacent(node, u.lower(to_str(arg(args, 0))), new_text(to_str(arg(args, 1))))
    return U
}

proc new_rect(x, y, w, h) {
    alloc o := new_object()
    put(o, "x", x * 1.0)
    put(o, "y", y * 1.0)
    put(o, "width", w * 1.0)
    put(o, "height", h * 1.0)
    put(o, "top", y * 1.0)
    put(o, "left", x * 1.0)
    put(o, "right", (x + w) * 1.0)
    put(o, "bottom", (y + h) * 1.0)
    return o
}

proc n_get_bounding_client_rect(this, args) {
    alloc node := node_of(this, "getBoundingClientRect")
    alloc r := rect_of(node)
    alloc v := view()
    return new_rect(r[0] - v[2], r[1] - v[3], r[2], r[3])
}

proc n_get_client_rects(this, args) {
    return new_array([n_get_bounding_client_rect(this, args)])
}

proc n_scroll_into_view(this, args) {
    alloc node := node_of(this, "scrollIntoView")
    if has_key(HOST, "scroll") {
        alloc r := rect_of(node)
        HOST["scroll"](view()[2], int(r[1]))
    }
    return U
}

