# Another document, made from text: for createHTMLDocument and
# DOMParser. It is never shown.
proc other_document(text) {
    alloc d := html.parse(string_bytes(text))
    adopt(d, -1)
    css.prepare_doc(d)
    return wrap(d)
}

proc n_create_html_document(this, args) {
    alloc title := ""
    if length(args) > 0 and type_of(args[0]) != 0 {
        title := html.escape_text(to_str(args[0]), false)
    }
    return other_document("<!DOCTYPE html><html><head><title>" + title + "</title></head><body></body></html>")
}

proc n_parse_from_string(this, args) {
    return other_document(to_str(arg(args, 0)))
}

proc n_dom_parser(this, args) {
    return new_obj(0, P["DOMParser"])
}

proc g_implementation(h, node) {
    alloc o := new_object()
    def(o, "hasFeature", n_true, 0)
    def(o, "createHTMLDocument", n_create_html_document, 1)
    return o
}

proc g_fonts(h, node) {
    alloc o := new_obj(0, P["EventTarget"])
    put(o, "ready", promise.to_promise(o))
    put(o, "status", "loaded")
    def(o, "load", n_play, 0)
    def(o, "check", n_true, 0)
    return o
}

proc g_namespace(h, node) {
    return "http://www.w3.org/1999/xhtml"
}

proc g_false(h, node) {
    return false
}

proc g_content_editable(h, node) {
    return attr_or(node, "contenteditable", "inherit")
}

proc s_tab_index(h, node, v) {
    set_attr(node, "tabindex", to_str(v))
}

proc s_inner_text(h, node, v) {
    s_text_content(h, node, v)
}

proc s_nothing(h, node, v) {
    return true
}

proc setup() {
    P := {}
    TAG_PROTO := {}
    GETS := []
    SETS := []
    GET_ANY := []
    SET_ANY := []
    KEYS_OF := []
    alloc i := 0
    loop i < NCLASS {
        append(GETS, {})
        append(SETS, {})
        append(GET_ANY, false)
        append(SET_ANY, false)
        append(KEYS_OF, false)
        i := i + 1
    }
    c.set_host_hooks(host_get, host_set, host_keys)
    alloc g := I[0]
    alloc object_proto := I[1]

    # -- what can be listened to, and the kinds of node
    alloc et := iface_with("EventTarget", object_proto, n_event_target_ctor, 0, 0)
    def(et, "addEventListener", n_add_event_listener, 2)
    def(et, "removeEventListener", n_remove_event_listener, 2)
    def(et, "dispatchEvent", n_dispatch_event, 1)
    def(g, "addEventListener", n_add_event_listener, 2)
    def(g, "removeEventListener", n_remove_event_listener, 2)
    def(g, "dispatchEvent", n_dispatch_event, 1)

    alloc np := iface("Node", et)
    alloc node_ctor := get(np, "constructor")
    # el.onclick reads as null until someone sets it, and
    # `"onclick" in el` is how libraries ask what can be listened for
    for name in ["click", "dblclick", "mousedown", "mouseup", "mousemove", "mouseover", "mouseout",
                 "mouseenter", "mouseleave", "keydown", "keyup", "keypress", "input", "change",
                 "submit", "reset", "focus", "blur", "focusin", "focusout", "load", "error",
                 "scroll", "wheel", "contextmenu", "select", "toggle"] {
        define_hidden(np, "on" + name, 0)
        define_hidden(g, "on" + name, 0)
    }
    for name in ["unload", "beforeunload", "resize", "hashchange", "popstate", "message", "storage",
                 "online", "offline", "pageshow", "pagehide", "unhandledrejection"] {
        define_hidden(g, "on" + name, 0)
    }
    alloc consts := {ELEMENT_NODE: 1.0, ATTRIBUTE_NODE: 2.0, TEXT_NODE: 3.0, CDATA_SECTION_NODE: 4.0,
                     PROCESSING_INSTRUCTION_NODE: 7.0, COMMENT_NODE: 8.0, DOCUMENT_NODE: 9.0,
                     DOCUMENT_TYPE_NODE: 10.0, DOCUMENT_FRAGMENT_NODE: 11.0,
                     DOCUMENT_POSITION_DISCONNECTED: 1.0, DOCUMENT_POSITION_PRECEDING: 2.0,
                     DOCUMENT_POSITION_FOLLOWING: 4.0, DOCUMENT_POSITION_CONTAINS: 8.0,
                     DOCUMENT_POSITION_CONTAINED_BY: 16.0}
    for name in dict_keys(consts) {
        define_hidden(np, name, consts[name])
        define_hidden(node_ctor, name, consts[name])
    }
    alloc methods := {
        appendChild: n_append_child, insertBefore: n_insert_before, removeChild: n_remove_child,
        replaceChild: n_replace_child, cloneNode: n_clone_node, contains: n_contains,
        hasChildNodes: n_has_child_nodes, remove: n_remove, append: n_append, prepend: n_prepend,
        before: n_before, after: n_after, replaceWith: n_replace_with,
        replaceChildren: n_replace_children, getAttribute: n_get_attribute,
        setAttribute: n_set_attribute, removeAttribute: n_remove_attribute,
        hasAttribute: n_has_attribute, toggleAttribute: n_toggle_attribute,
        getAttributeNames: n_get_attribute_names, hasAttributes: n_has_attributes,
        getAttributeNode: n_get_attribute_node, getAttributeNS: n_get_attribute_ns,
        setAttributeNS: n_set_attribute_ns, removeAttributeNS: n_remove_attribute_ns,
        hasAttributeNS: n_has_attribute_ns, querySelector: n_query_selector,
        querySelectorAll: n_query_selector_all, matches: n_matches, webkitMatchesSelector: n_matches,
        closest: n_closest, getElementsByTagName: n_get_elements_by_tag_name,
        getElementsByClassName: n_get_elements_by_class_name, getElementById: n_get_element_by_id,
        insertAdjacentHTML: n_insert_adjacent_html, insertAdjacentElement: n_insert_adjacent_element,
        insertAdjacentText: n_insert_adjacent_text, getBoundingClientRect: n_get_bounding_client_rect,
        getClientRects: n_get_client_rects, scrollIntoView: n_scroll_into_view,
        scrollIntoViewIfNeeded: n_scroll_into_view, focus: n_focus, blur: n_blur, click: n_click,
        submit: n_submit, requestSubmit: n_request_submit, reset: n_reset,
        compareDocumentPosition: n_compare_document_position, getRootNode: n_get_root_node,
        isSameNode: n_is_same_node, isEqualNode: n_is_equal_node, normalize: n_normalize,
        splitText: n_split_text, appendData: n_append_data, toString: n_node_to_string,
        getContext: n_get_context, play: n_play, pause: n_nothing, load: n_nothing,
        select: n_nothing, setSelectionRange: n_nothing, setCustomValidity: n_nothing,
        checkValidity: n_true, reportValidity: n_true, scrollTo: n_nothing, scroll: n_nothing,
        scrollBy: n_nothing, getAnimations: n_empty_array, setPointerCapture: n_nothing,
        releasePointerCapture: n_nothing, hasPointerCapture: n_false, showModal: n_nothing,
        close: n_nothing, show: n_nothing, attachInternals: n_null
    }
    alloc ep := iface("Element", np)
    alloc hp := iface("HTMLElement", ep)
    iface("SVGElement", ep)
    alloc cd := iface("CharacterData", np)
    iface("Text", cd)
    iface("Comment", cd)
    alloc fp := iface("DocumentFragment", np)
    iface("ShadowRoot", fp)
    alloc dp := iface("Document", np)
    # Each method goes where the DOM has it: scripts ask
    # `node.getAttribute && ...` to tell an element from a text node.
    alloc on_node := {appendChild: 1, insertBefore: 1, removeChild: 1, replaceChild: 1, cloneNode: 1,
                      contains: 1, hasChildNodes: 1, compareDocumentPosition: 1, getRootNode: 1,
                      isSameNode: 1, isEqualNode: 1, normalize: 1, toString: 1}
    alloc on_child := {remove: 1, before: 1, after: 1, replaceWith: 1}
    alloc on_parent := {append: 1, prepend: 1, replaceChildren: 1, querySelector: 1, querySelectorAll: 1}
    alloc on_text := {splitText: 1, appendData: 1}
    for name2 in dict_keys(methods) {
        alloc fn2 := methods[name2]
        if has_key(on_node, name2) {
            def(np, name2, fn2, 1)
        } elif has_key(on_child, name2) {
            def(ep, name2, fn2, 1)
            def(cd, name2, fn2, 1)
        } elif has_key(on_parent, name2) {
            def(ep, name2, fn2, 1)
            def(dp, name2, fn2, 1)
            def(fp, name2, fn2, 1)
        } elif has_key(on_text, name2) {
            def(cd, name2, fn2, 1)
        } elif name2 == "getElementById" {
            def(dp, name2, fn2, 1)
            def(fp, name2, fn2, 1)
        } elif name2 == "getElementsByTagName" or name2 == "getElementsByClassName" {
            def(ep, name2, fn2, 1)
            def(dp, name2, fn2, 1)
        } else {
            def(ep, name2, fn2, 1)
        }
    }
    define_hidden(g, "HTMLDocument", get(dp, "constructor"))
    for tag in dict_keys(TAG_NAMES) {
        alloc iname := TAG_NAMES[tag]
        if has_key(P, iname) == false {
            iface(iname, hp)
        }
        TAG_PROTO[tag] := P[iname]
    }
    TAG_PROTO["svg"] := P["SVGElement"]
    # React (and what tests it) takes the setter of `value` off the
    # prototype, to set a field behind the back of its own tracking
    for pair in [["HTMLInputElement", "value"], ["HTMLInputElement", "checked"],
                 ["HTMLTextAreaElement", "value"], ["HTMLSelectElement", "value"],
                 ["HTMLSelectElement", "selectedIndex"], ["HTMLOptionElement", "selected"]] {
        if has_key(P, pair[0]) {
            X["define_accessor"](P[pair[0]], pair[1], 0, new_native_with(n_prop_get, "get " + pair[1], 0, pair[1]))
            X["define_accessor"](P[pair[0]], pair[1], 1, new_native_with(n_prop_set, "set " + pair[1], 1, pair[1]))
        }
    }
    iface("HTMLUnknownElement", hp)
    iface("HTMLMediaElement", hp)
    NODELIST := new_obj(0, I[3])
    P["NodeList"] := NODELIST
    alloc nl_ctor := new_native(n_illegal_ctor, "NodeList", 0)
    define_hidden(nl_ctor, "prototype", NODELIST)
    define_hidden(g, "NodeList", nl_ctor)
    define_hidden(g, "HTMLCollection", nl_ctor)
    def(NODELIST, "item", n_list_item, 1)
    def(NODELIST, "namedItem", n_list_named_item, 1)

    alloc doc_methods := {
        createElement: n_create_element, createElementNS: n_create_element_ns,
        createTextNode: n_create_text_node, createComment: n_create_comment,
        createDocumentFragment: n_create_document_fragment, createEvent: n_create_event,
        getElementsByName: n_get_elements_by_name, write: n_write, writeln: n_write,
        open: n_nothing, close: n_nothing, hasFocus: n_true, importNode: n_import_node,
        adoptNode: n_adopt_node, elementFromPoint: n_element_from_point, execCommand: n_false,
        queryCommandSupported: n_false, getSelection: n_get_selection, createRange: n_create_range
    }
    for name3 in dict_keys(doc_methods) {
        def(dp, name3, doc_methods[name3], 1)
    }

    NODE_G := {nodeType: g_node_type, nodeName: g_node_name, nodeValue: g_node_value,
               parentNode: g_parent_node, parentElement: g_parent_element, childNodes: g_child_nodes,
               firstChild: g_first_child, lastChild: g_last_child,
               previousSibling: g_previous_sibling, nextSibling: g_next_sibling,
               textContent: g_text_content, ownerDocument: g_owner_document,
               isConnected: g_is_connected, baseURI: g_base_uri, children: g_children,
               firstElementChild: g_first_element_child, lastElementChild: g_last_element_child,
               childElementCount: g_child_element_count,
               previousElementSibling: g_previous_element_sibling,
               nextElementSibling: g_next_element_sibling}
    NODE_S := {nodeValue: s_node_value, textContent: s_text_content}
    EL_G := {tagName: g_tag_name, localName: g_local_name, id: g_id, className: g_class_name,
             classList: g_class_list, innerHTML: g_inner_html, outerHTML: g_outer_html,
             innerText: g_inner_text, attributes: g_attributes, hidden: g_hidden, style: g_style,
             dataset: g_dataset, tabIndex: g_tab_index, value: g_value, checked: g_checked,
             selected: g_selected, selectedIndex: g_selected_index, options: g_options,
             form: g_form, elements: g_elements, length: g_length, text: g_text,
             label: g_label_text, type: g_type, protocol: g_protocol, host: g_host,
             hostname: g_hostname, pathname: g_pathname, search: g_search, hash: g_hash,
             origin: g_origin, offsetWidth: g_offset_width, offsetHeight: g_offset_height,
             offsetLeft: g_offset_left, offsetTop: g_offset_top, offsetParent: g_offset_parent,
             clientWidth: g_client_width, clientHeight: g_client_height, clientLeft: g_zero,
             clientTop: g_zero, scrollWidth: g_scroll_width, scrollHeight: g_scroll_height,
             scrollTop: g_scroll_top, scrollLeft: g_scroll_left, naturalWidth: g_natural_width,
             naturalHeight: g_natural_height, complete: g_complete, width: g_width,
             height: g_height, content: g_content_template, namespaceURI: g_namespace,
             shadowRoot: g_null, isContentEditable: g_false, contentEditable: g_content_editable,
             sheet: g_sheet, assignedSlot: g_null}
    EL_S := {id: s_id, className: s_class_name, classList: s_class_list, innerHTML: s_inner_html,
             outerHTML: s_outer_html, innerText: s_inner_text, hidden: s_hidden, style: s_style,
             tabIndex: s_tab_index, value: s_value, checked: s_checked, selected: s_selected,
             selectedIndex: s_selected_index, text: s_text, type: s_type, scrollTop: s_scroll_top,
             scrollLeft: s_scroll_left, width: s_width, height: s_height, content: s_content}
    DOC_G := {documentElement: g_document_element, head: g_head, body: g_body, title: g_title,
              cookie: g_cookie, readyState: g_ready_state, URL: g_doc_url, documentURI: g_doc_url,
              location: g_doc_location, defaultView: g_default_view,
              activeElement: g_active_element, currentScript: g_current_script, forms: g_forms,
              images: g_images, links: g_links, scripts: g_scripts, anchors: g_links,
              characterSet: g_charset, charset: g_charset, inputEncoding: g_charset,
              compatMode: g_compat_mode, contentType: g_content_type, doctype: g_doctype,
              referrer: g_empty_text, domain: g_domain, hidden: g_doc_hidden,
              visibilityState: g_visibility_state, styleSheets: g_style_sheets,
              scrollingElement: g_document_element, fullscreenElement: g_null,
              designMode: g_design_mode, dir: g_empty_text, lastModified: g_empty_text,
              implementation: g_implementation, fonts: g_fonts}
    DOC_S := {title: s_title, cookie: s_cookie, location: s_doc_location, domain: s_nothing,
              designMode: s_nothing, dir: s_nothing}
    TEXT_G := {data: g_data, length: g_text_length, wholeText: g_data}
    TEXT_S := {data: s_data}

    # -- style, dataset, classList
    alloc ssp := iface("CSSStyleSheet", object_proto)
    def(ssp, "insertRule", n_insert_rule, 2)
    def(ssp, "deleteRule", n_delete_rule, 1)
    def(ssp, "removeRule", n_delete_rule, 1)
    X["def_getter"](ssp, "cssRules", n_css_rules)
    X["def_getter"](ssp, "rules", n_css_rules)
    X["def_getter"](ssp, "ownerNode", n_owner_node)
    define_hidden(ssp, "disabled", false)
    define_hidden(ssp, "href", 0)
    define_hidden(ssp, "type", "text/css")
    SHEET_OBJ := {}
    alloc sp := iface("CSSStyleDeclaration", object_proto)
    def(sp, "setProperty", n_style_set_property, 2)
    def(sp, "getPropertyValue", n_style_get_property_value, 1)
    def(sp, "removeProperty", n_style_remove_property, 1)
    def(sp, "getPropertyPriority", n_style_get_property_priority, 1)
    def(sp, "item", n_style_item, 1)
    GETS[C_STYLE - 32] := {cssText: g_css_text, length: g_style_length}
    SETS[C_STYLE - 32] := {cssText: s_css_text}
    GET_ANY[C_STYLE - 32] := style_get
    SET_ANY[C_STYLE - 32] := style_set
    KEYS_OF[C_STYLE - 32] := style_keys
    GET_ANY[C_COMPUTED - 32] := computed_get
    SET_ANY[C_COMPUTED - 32] := computed_set
    iface("DOMStringMap", object_proto)
    GET_ANY[C_DATASET - 32] := dataset_get
    SET_ANY[C_DATASET - 32] := dataset_set
    KEYS_OF[C_DATASET - 32] := dataset_keys
    alloc tp := iface("DOMTokenList", object_proto)
    def(tp, "add", n_tokens_add, 1)
    def(tp, "remove", n_tokens_remove, 1)
    def(tp, "toggle", n_tokens_toggle, 1)
    def(tp, "contains", n_tokens_contains, 1)
    def(tp, "replace", n_tokens_replace, 2)
    def(tp, "item", n_tokens_item, 1)
    def(tp, "toString", n_tokens_to_string, 0)
    def(tp, "forEach", n_tokens_for_each, 1)
    alloc tv := def(tp, "values", n_tokens_values, 0)
    define_hidden(tp, "@@iterator", tv)
    GETS[C_TOKENS - 32] := {length: g_tokens_length, value: g_tokens_value}
    SETS[C_TOKENS - 32] := {value: s_tokens_value}
    GET_ANY[C_TOKENS - 32] := tokens_get

    # -- storage
    alloc stp := iface("Storage", object_proto)
    def(stp, "getItem", n_storage_get_item, 1)
    def(stp, "setItem", n_storage_set_item, 2)
    def(stp, "removeItem", n_storage_remove_item, 1)
    def(stp, "clear", n_storage_clear, 0)
    def(stp, "key", n_storage_key, 1)
    GETS[C_STORAGE - 32] := {length: g_storage_length}
    GET_ANY[C_STORAGE - 32] := storage_get
    SET_ANY[C_STORAGE - 32] := storage_set
    KEYS_OF[C_STORAGE - 32] := storage_keys
    for kind in ["localStorage", "sessionStorage"] {
        alloc st := new_obj(C_STORAGE, stp)
        H[st][3] := store_of(kind)
        define_hidden(g, kind, st)
    }

    # -- events
    alloc evp := iface_with("Event", object_proto, n_event_ctor, 1, "Event")
    def(evp, "preventDefault", n_prevent_default, 0)
    def(evp, "stopPropagation", n_stop_propagation, 0)
    def(evp, "stopImmediatePropagation", n_stop_immediate_propagation, 0)
    def(evp, "composedPath", n_composed_path, 0)
    def(evp, "initEvent", n_init_event, 3)
    def(evp, "initCustomEvent", n_init_event, 4)
    def(evp, "initMouseEvent", n_init_event, 3)
    def(evp, "initUIEvent", n_init_event, 3)
    def(evp, "getModifierState", n_false, 1)
    alloc phases := {NONE: 0.0, CAPTURING_PHASE: 1.0, AT_TARGET: 2.0, BUBBLING_PHASE: 3.0}
    for pn in dict_keys(phases) {
        define_hidden(evp, pn, phases[pn])
        define_hidden(get(evp, "constructor"), pn, phases[pn])
    }
    alloc uip := iface_with("UIEvent", evp, n_event_ctor, 1, "UIEvent")
    alloc mp := iface_with("MouseEvent", uip, n_event_ctor, 1, "MouseEvent")
    iface_with("PointerEvent", mp, n_event_ctor, 1, "PointerEvent")
    iface_with("WheelEvent", mp, n_event_ctor, 1, "WheelEvent")
    for ek in ["KeyboardEvent", "FocusEvent", "InputEvent", "TouchEvent"] {
        iface_with(ek, uip, n_event_ctor, 1, ek)
    }
    for ek2 in ["CustomEvent", "ErrorEvent", "MessageEvent", "HashChangeEvent", "PopStateEvent", "ProgressEvent", "StorageEvent", "TransitionEvent", "AnimationEvent", "SubmitEvent"] {
        iface_with(ek2, evp, n_event_ctor, 1, ek2)
    }
    GETS[C_EVENT - 32] := {type: g_ev_type, bubbles: g_ev_bubbles, cancelable: g_ev_cancelable,
                           defaultPrevented: g_ev_default_prevented, target: g_ev_target,
                           srcElement: g_ev_target, currentTarget: g_ev_current_target,
                           eventPhase: g_ev_phase, timeStamp: g_ev_time, isTrusted: g_ev_trusted,
                           cancelBubble: g_ev_cancel_bubble, returnValue: g_ev_return_value}
    SETS[C_EVENT - 32] := {cancelBubble: s_ev_cancel_bubble, returnValue: s_ev_return_value}

    # -- addresses
    alloc lp := iface("Location", object_proto)
    def(lp, "assign", n_loc_assign, 1)
    def(lp, "replace", n_loc_replace, 1)
    def(lp, "reload", n_loc_reload, 0)
    def(lp, "toString", n_loc_to_string, 0)
    GETS[C_LOCATION - 32] := {href: g_loc_href, protocol: g_loc_protocol, host: g_loc_host,
                              hostname: g_loc_hostname, port: g_loc_port, pathname: g_loc_pathname,
                              search: g_loc_search, hash: g_loc_hash, origin: g_loc_origin}
    SETS[C_LOCATION - 32] := {href: s_loc_href, pathname: s_loc_pathname, search: s_loc_search,
                              hash: s_loc_hash}
    LOCATION := new_obj(C_LOCATION, lp)
    H[LOCATION][3] := 0
    X["def_getter"](g, "location", g_win_location)
    X["def_setter"](g, "location", s_win_location)
    alloc hip := iface("History", object_proto)
    def(hip, "pushState", n_push_state, 2)
    def(hip, "replaceState", n_replace_state, 2)
    def(hip, "go", n_hist_go, 1)
    def(hip, "back", n_hist_back, 0)
    def(hip, "forward", n_hist_forward, 0)
    GETS[C_HISTORY - 32] := {length: g_hist_length, state: g_hist_state, scrollRestoration: g_hist_scroll}
    SETS[C_HISTORY - 32] := {scrollRestoration: s_nothing}
    alloc hist := new_obj(C_HISTORY, hip)
    H[hist][3] := 0
    define_hidden(g, "history", hist)

    alloc up := iface_with("URL", object_proto, n_url_ctor, 1, 0)
    def(up, "toString", n_url_to_string, 0)
    def(up, "toJSON", n_url_to_string, 0)
    alloc url_ctor := get(up, "constructor")
    def(url_ctor, "canParse", n_url_can_parse, 1)
    def(url_ctor, "createObjectURL", n_create_object_url, 1)
    def(url_ctor, "revokeObjectURL", n_nothing, 1)
    define_hidden(g, "webkitURL", url_ctor)
    GETS[C_URL - 32] := {href: g_url_href, protocol: g_url_protocol, host: g_url_host,
                         hostname: g_url_hostname, port: g_url_port, pathname: g_url_pathname,
                         search: g_url_search, hash: g_url_hash, origin: g_url_origin,
                         searchParams: g_url_search_params, username: g_empty_text,
                         password: g_empty_text}
    SETS[C_URL - 32] := {href: s_url_href, pathname: s_url_pathname, search: s_url_search,
                         hash: s_url_hash}
    alloc pp := iface_with("URLSearchParams", object_proto, n_params_ctor, 0, 0)
    alloc hdp := iface_with("Headers", object_proto, n_headers_ctor, 0, 0)
    alloc fdp := iface_with("FormData", object_proto, n_form_data_ctor, 0, 0)
    for pr in [pp, hdp, fdp] {
        def(pr, "get", n_params_get, 1)
        def(pr, "getAll", n_params_get_all, 1)
        def(pr, "has", n_params_has, 1)
        def(pr, "append", n_params_append, 2)
        def(pr, "set", n_params_set, 2)
        def(pr, "delete", n_params_delete, 1)
        def(pr, "forEach", n_params_for_each, 1)
        def(pr, "keys", n_params_keys, 0)
        def(pr, "values", n_params_values, 0)
        alloc pe := def(pr, "entries", n_params_entries, 0)
        define_hidden(pr, "@@iterator", pe)
    }
    def(pp, "toString", n_params_to_string, 0)
    def(pp, "sort", n_params_sort, 0)
    GETS[C_PARAMS - 32] := {size: g_params_size}

    # -- requests
    alloc rp := iface_with("Response", object_proto, n_response_ctor, 0, 0)
    def(rp, "text", n_response_text, 0)
    def(rp, "json", n_response_json, 0)
    def(rp, "clone", n_response_clone, 0)
    def(rp, "arrayBuffer", n_response_unsupported, 0)
    def(rp, "blob", n_response_unsupported, 0)
    def(rp, "formData", n_response_unsupported, 0)
    iface_with("Request", object_proto, n_request_ctor, 1, 0)
    def(g, "fetch", n_fetch, 1)
    alloc xp := iface_with("XMLHttpRequest", et, n_xhr_ctor, 0, 0)
    def(xp, "open", n_xhr_open, 2)
    def(xp, "send", n_xhr_send, 0)
    def(xp, "abort", n_xhr_abort, 0)
    def(xp, "setRequestHeader", n_xhr_set_request_header, 2)
    def(xp, "getResponseHeader", n_xhr_get_response_header, 1)
    def(xp, "getAllResponseHeaders", n_xhr_get_all_response_headers, 0)
    def(xp, "overrideMimeType", n_nothing, 1)
    alloc states := {UNSENT: 0.0, OPENED: 1.0, HEADERS_RECEIVED: 2.0, LOADING: 3.0, DONE: 4.0}
    for sn in dict_keys(states) {
        define_hidden(xp, sn, states[sn])
        define_hidden(get(xp, "constructor"), sn, states[sn])
    }
    GETS[C_XHR - 32] := {readyState: g_xhr_ready_state, status: g_xhr_status,
                         statusText: g_xhr_status_text, responseText: g_xhr_response_text,
                         response: g_xhr_response, responseType: g_xhr_response_type,
                         responseURL: g_xhr_response_url, timeout: g_xhr_timeout,
                         withCredentials: g_xhr_with_credentials, upload: g_xhr_upload,
                         responseXML: g_xhr_null}
    SETS[C_XHR - 32] := {responseType: s_xhr_response_type, timeout: s_xhr_timeout,
                         withCredentials: s_xhr_with_credentials}

    # -- observers and the rest of what pages expect to find
    for ob in ["MutationObserver", "IntersectionObserver", "ResizeObserver", "PerformanceObserver"] {
        alloc obp := iface_with(ob, object_proto, n_observer_ctor, 1, ob)
        def(obp, "observe", n_observe, 1)
        def(obp, "unobserve", n_nothing, 1)
        def(obp, "disconnect", n_nothing, 0)
        def(obp, "takeRecords", n_empty_array, 0)
    }
    define_hidden(g, "WebKitMutationObserver", get(P["MutationObserver"], "constructor"))
    alloc dpp := iface_with("DOMParser", object_proto, n_dom_parser, 0, 0)
    def(dpp, "parseFromString", n_parse_from_string, 2)
    alloc acp := iface_with("AbortController", object_proto, n_abort_controller, 0, 0)
    def(acp, "abort", n_abort, 0)
    alloc dxp := iface_with("DOMException", I[8], n_dom_exception, 0, 0)
    define_hidden(g, "Image", new_native_with(n_image_ctor, "Image", 0, "img"))
    define_hidden(g, "Audio", new_native_with(n_image_ctor, "Audio", 0, "audio"))
    define_hidden(g, "Option", new_native(n_option_ctor, "Option", 0))
    H[get(g, "Image")][2]["prototype"] := P["HTMLImageElement"]
    H[get(g, "Option")][2]["prototype"] := P["HTMLOptionElement"]

    for name4 in ["window", "self", "top", "parent", "frames", "globalThis"] {
        define_hidden(g, name4, g)
    }
    define_hidden(g, "document", wrap(DOC))
    alloc win_getters := {innerWidth: g_inner_width, innerHeight: g_inner_height,
                          outerWidth: g_inner_width, outerHeight: g_inner_height,
                          scrollX: g_scroll_x, scrollY: g_scroll_y, pageXOffset: g_scroll_x,
                          pageYOffset: g_scroll_y, origin: g_win_origin}
    for name5 in dict_keys(win_getters) {
        X["def_getter"](g, name5, win_getters[name5])
    }
    alloc win_fns := {alert: n_alert, confirm: n_confirm, prompt: n_prompt,
                      getComputedStyle: n_get_computed_style, matchMedia: n_match_media,
                      requestAnimationFrame: n_request_animation_frame,
                      webkitRequestAnimationFrame: n_request_animation_frame,
                      cancelAnimationFrame: n_cancel_timer, requestIdleCallback: n_request_idle_callback,
                      cancelIdleCallback: n_cancel_timer, scrollTo: n_scroll_to, scroll: n_scroll_to,
                      scrollBy: n_scroll_by, postMessage: n_post_message,
                      structuredClone: n_structured_clone, reportError: n_report_error,
                      open: n_open, close: n_nothing, focus: n_nothing, blur: n_nothing,
                      print: n_nothing, stop: n_nothing, getSelection: n_get_selection,
                      captureEvents: n_nothing, releaseEvents: n_nothing}
    for name6 in dict_keys(win_fns) {
        def(g, name6, win_fns[name6], 1)
    }
    alloc statics := {devicePixelRatio: 1.0, name: "", closed: false, length: 0.0, opener: 0,
                      frameElement: 0, isSecureContext: true, status: "", screenX: 0.0, screenY: 0.0,
                      screenLeft: 0.0, screenTop: 0.0, event: U, onload: 0, onerror: 0,
                      onunhandledrejection: 0, onresize: 0, onscroll: 0, onhashchange: 0,
                      onpopstate: 0, onmessage: 0, onbeforeunload: 0, onunload: 0, onpageshow: 0,
                      ontouchstart: U}
    for name7 in dict_keys(statics) {
        if name7 != "ontouchstart" and name7 != "event" {
            define_hidden(g, name7, statics[name7])
        }
    }

    alloc console := new_object()
    for level in ["log", "info", "warn", "error", "debug", "trace", "dir", "table", "group", "groupCollapsed"] {
        define_hidden(console, level, new_native_with(n_console, level, 0, level))
    }
    for quiet in ["groupEnd", "time", "timeEnd", "timeLog", "count", "countReset", "clear", "profile", "profileEnd", "timeStamp"] {
        def(console, quiet, n_nothing, 0)
    }
    def(console, "assert", n_console_assert, 2)
    define_hidden(g, "console", console)

    alloc nav := new_object()
    alloc nav_values := {userAgent: "Mozilla/5.0 (X11; Linux x86_64) OMGBrowser/0.1", appName: "Netscape",
                         appCodeName: "Mozilla", appVersion: "5.0 (X11)", platform: "Linux x86_64",
                         product: "Gecko", productSub: "20030107", vendor: "", vendorSub: "",
                         language: "en-US", onLine: true, cookieEnabled: true, javaEnabled: 0,
                         hardwareConcurrency: 1.0, maxTouchPoints: 0.0, doNotTrack: 0,
                         webdriver: false, pdfViewerEnabled: false}
    for name8 in dict_keys(nav_values) {
        if name8 != "javaEnabled" {
            put(nav, name8, nav_values[name8])
        }
    }
    put(nav, "languages", new_array(["en-US", "en"]))
    put(nav, "plugins", new_array([]))
    put(nav, "mimeTypes", new_array([]))
    def(nav, "javaEnabled", n_false, 0)
    def(nav, "sendBeacon", n_false, 2)
    define_hidden(g, "navigator", nav)
    define_hidden(g, "clientInformation", nav)

    alloc v := view()
    alloc screen := new_object()
    alloc screen_values := {width: v[0] * 1.0, height: v[1] * 1.0, availWidth: v[0] * 1.0,
                            availHeight: v[1] * 1.0, colorDepth: 24.0, pixelDepth: 24.0,
                            availLeft: 0.0, availTop: 0.0}
    for name9 in dict_keys(screen_values) {
        put(screen, name9, screen_values[name9])
    }
    alloc orientation := new_obj(0, et)
    put(orientation, "type", "landscape-primary")
    put(orientation, "angle", 0.0)
    put(screen, "orientation", orientation)
    define_hidden(g, "screen", screen)

    alloc perf := new_obj(0, et)
    def(perf, "now", n_performance_now, 0)
    def(perf, "mark", n_nothing, 1)
    def(perf, "measure", n_nothing, 1)
    def(perf, "clearMarks", n_nothing, 0)
    def(perf, "clearMeasures", n_nothing, 0)
    def(perf, "getEntries", n_empty_array, 0)
    def(perf, "getEntriesByType", n_empty_array, 1)
    def(perf, "getEntriesByName", n_empty_array, 1)
    put(perf, "timeOrigin", START)
    alloc timing := new_object()
    put(timing, "navigationStart", START)
    put(timing, "domContentLoadedEventEnd", START)
    put(timing, "loadEventEnd", START)
    put(perf, "timing", timing)
    define_hidden(g, "performance", perf)

    alloc crypto := new_object()
    def(crypto, "randomUUID", n_random_uuid, 0)
    def(crypto, "getRandomValues", n_get_random_values, 1)
    define_hidden(g, "crypto", crypto)
    alloc cssns := new_object()
    def(cssns, "supports", n_css_supports, 1)
    def(cssns, "escape", n_css_escape, 1)
    define_hidden(g, "CSS", cssns)
    alloc ce := new_object()
    def(ce, "define", n_ce_define, 2)
    def(ce, "get", n_ce_get, 1)
    def(ce, "whenDefined", n_ce_when_defined, 1)
    def(ce, "upgrade", n_nothing, 1)
    define_hidden(g, "customElements", ce)
    return true
}

proc n_list_item(this, args) {
    alloc v := X["get_elem"](this, to_integer(arg(args, 0)))
    if type_of(v) == 0 {
        return 0
    }
    return v
}

proc n_list_named_item(this, args) {
    alloc want := to_str(arg(args, 0))
    if X["is_array"](this) {
        for h in items_of(this) {
            if is_node(h) {
                alloc node := NODES[H[h][3]]
                if node.t == 1 and (attr_or(node, "id", "") == want or attr_or(node, "name", "") == want) {
                    return h
                }
            }
        }
    }
    return 0
}

# Start a fresh engine for the document `doc`, which came from
# `address`; `base` is what the addresses written in it are counted
# from, and `host` what the browser does for the page (see the top).
proc attach(doc, address, base, host) {
    js.start()
    NODES := []
    PARENT := []
    WRAP := []
    LIS := []
    DOC := doc
    ADDRESS := address
    BASE := base
    HOST := host
    DIRTY := false
    SHEETS := false
    VERSION := 0
    ID_VERSION := -1
    ID_MAP := {}
    SEL_CACHE := {}
    TASKS := []
    TASK_AT := 0
    READY := "loading"
    CURRENT_SCRIPT := false
    FOCUS := false
    HIST := [[address, 0]]
    HIST_AT := 0
    LOG := []
    INLINE_COUNT := 0
    START := time_ms() * 1.0
    register({t: 0, kids: []}, -1)
    adopt(doc, -1)
    css.prepare_doc(doc)
    setup()
    return true
}

# Is a page with scripts on show?
proc attached() {
    return DOC != false
}

# The page is going away.
proc leave() {
    DOC := false
    NODES := []
    PARENT := []
    WRAP := []
    LIS := []
    TASKS := []
    TASK_AT := 0
    HOST := {}
    return true
}
