;;;omg

# tools/browser/dom.omg
#
# The page as scripts see it: document, elements, text, events.
#
# The tree is the one html.omg made, and layout reads the same one: a
# script that adds an element has changed what the page is. Since the
# nodes of that tree do not point at their parents, this file gives
# each node a number (.nid) and keeps what a script may ask about it
# in lists with that number as the index: the node itself, its
# parent's number, the object scripts hold for it, who listens to it.
#
# To a script a node is an object of class 32 whose payload is the
# node's number. Its properties are not stored: the engine asks
# host_get() and host_set() below, which look the name up in a table
# of procs (NODE_G, EL_G and so on). Methods are ordinary functions on
# the prototypes (Node.prototype has nearly all of them).
#
# What the page cannot do by itself it asks the browser for through
# HOST, a dict of procs that browser.omg hands to attach(): fetch a
# file, go to another address, lay the page out now, say where an
# element is on the screen.
#
# After a script has run the browser asks take_dirty(), and lays the
# page out again when something changed.

import "js/core.omg" as c
import "js/engine.omg" as js
import "js/lib_promise.omg" as promise
import "html.omg" as html
import "css.omg" as css
import "url.omg" as url
import "util.omg" as u

alloc X := c.exports()
alloc H := X["H"]
alloc I := X["I"]
alloc arg := X["arg"]
alloc def := X["def"]
alloc define_hidden := X["define_hidden"]
alloc get := X["get"]
alloc put := X["put"]
alloc has_own := X["has_own"]
alloc new_obj := X["new_obj"]
alloc new_object := X["new_object"]
alloc new_array := X["new_array"]
alloc new_native := X["new_native"]
alloc new_native_with := X["new_native_with"]
alloc native_data := X["native_data"]
alloc throw_type := X["throw_type"]
alloc throw_val := X["throw_val"]
alloc make_error := X["make_error"]
alloc to_num := X["to_num"]
alloc to_str := X["to_str"]
alloc to_bool := X["to_bool"]
alloc to_integer := X["to_integer"]
alloc is_callable := X["is_callable"]
alloc is_nullish := X["is_nullish"]
alloc call := X["call"]
alloc new_target := X["new_target"]
alloc own_keys := X["own_keys"]
alloc items_of := X["items_of"]
alloc caught := X["caught"]
alloc show := X["show"]
alloc num_to_str := X["num_to_str"]

proc nothing() {
}

alloc U := nothing()
alloc MISS := [0]

alloc C_NODE := 32
alloc C_STYLE := 33
alloc C_DATASET := 34
alloc C_STORAGE := 35
alloc C_COMPUTED := 36
alloc C_LOCATION := 37
alloc C_EVENT := 38
alloc C_XHR := 39
alloc C_TOKENS := 40
alloc C_URL := 41
alloc C_HISTORY := 42
alloc C_PARAMS := 43
alloc NCLASS := 12

alloc NODES := []        # number -> node
alloc PARENT := []       # number -> its parent's number, or -1
alloc WRAP := []         # number -> the object scripts hold, or 0
alloc LIS := []          # number -> false, or {event name: [[function, capture?, once?, alive?], ...]}
alloc DOC := false       # the document on show
alloc DOC_NID := 1       # its number; 0 is the window
alloc DIRTY := false     # the tree changed since the browser last asked
alloc SHEETS := false    # a style sheet came, went or changed
alloc SHEET_OBJ := {}    # the sheet object of each <style> that was asked for one
alloc RESTYLE := {}      # the elements whose styles (and those below) are stale, by number
alloc RESTYLE_ALL := false
alloc VERSION := 0       # goes up with every change to the tree
alloc HOST := {}         # what the browser does for the page
alloc ADDRESS := "about:blank"
alloc BASE := "about:blank"
alloc READY := "loading"
alloc CURRENT_SCRIPT := false
alloc TASKS := []        # work for later: scripts to fetch, events to send
alloc TASK_AT := 0
alloc FOCUS := false     # the node that has the keyboard, as the browser told it
alloc LOG := []          # what console.log printed, when nobody else takes it
alloc START := 0.0       # when the page was started, in ms
alloc LOCATION := 0      # the object window.location is

alloc P := {}            # name -> prototype, for "Node", "Element" and the rest
alloc TAG_PROTO := {}    # tag -> prototype
alloc NODELIST := 0

# The tables host_get() and host_set() look names up in, one of each
# for every class of object from 32 on.
alloc GETS := []
alloc SETS := []
alloc GET_ANY := []
alloc SET_ANY := []
alloc KEYS_OF := []
alloc NODE_G := {}
alloc NODE_S := {}
alloc EL_G := {}
alloc EL_S := {}
alloc DOC_G := {}
alloc DOC_S := {}
alloc TEXT_G := {}
alloc TEXT_S := {}

# --- the engine asks ------------------------------------------------------------------------

proc host_get(h, o, k) {
    alloc cls := o[0]
    if cls == 32 {
        alloc node := NODES[o[3]]
        if has_key(NODE_G, k) {
            return NODE_G[k](h, node)
        }
        alloc t := node.t
        if t == 1 {
            if has_key(EL_G, k) {
                return EL_G[k](h, node)
            }
            if has_key(REFLECT, k) {
                return reflect_get(node, REFLECT[k])
            }
            if node.tag == "form" and X["has_prop"](o[1], k) == false {
                # form.q is the control named q
                for ctl in controls_in(node, []) {
                    if attr_or(ctl, "name", "") == k or attr_or(ctl, "id", "") == k {
                        return wrap(ctl)
                    }
                }
            }
        } elif t == 9 {
            if has_key(DOC_G, k) {
                return DOC_G[k](h, node)
            }
        } elif t == 3 or t == 8 {
            if has_key(TEXT_G, k) {
                return TEXT_G[k](h, node)
            }
        }
        return MISS
    }
    alloc i := cls - 32
    if i >= NCLASS {
        return MISS
    }
    alloc tab := GETS[i]
    if has_key(tab, k) {
        return tab[k](h, o[3])
    }
    alloc any := GET_ANY[i]
    if any != false {
        return any(h, o[3], k)
    }
    return MISS
}

# A property of a node as a getter and a setter of its own, for the
# few that scripts take off the prototype.
proc n_prop_get(this, args) {
    alloc key := native_data()
    if is_node(this) == false {
        throw_type("Illegal invocation")
    }
    alloc v := host_get(this, H[this], key)
    if type_of(v) == 5 {
        return U
    }
    return v
}

proc n_prop_set(this, args) {
    alloc key := native_data()
    if is_node(this) == false {
        throw_type("Illegal invocation")
    }
    host_set(this, H[this], key, arg(args, 0))
    return U
}

proc host_set(h, o, k, v) {
    alloc cls := o[0]
    if cls == 32 {
        alloc node := NODES[o[3]]
        if has_key(NODE_S, k) {
            NODE_S[k](h, node, v)
            return true
        }
        alloc t := node.t
        if t == 1 {
            if has_key(EL_S, k) {
                return EL_S[k](h, node, v) != false
            }
            if has_key(REFLECT, k) {
                return reflect_set(node, REFLECT[k], v)
            }
        } elif t == 9 {
            if has_key(DOC_S, k) {
                DOC_S[k](h, node, v)
                return true
            }
        } elif t == 3 or t == 8 {
            if has_key(TEXT_S, k) {
                TEXT_S[k](h, node, v)
                return true
            }
        }
        # a property scripts may read but not write stays as it is
        return has_key(NODE_G, k) or (t == 1 and has_key(EL_G, k) and type_of(EL_G[k](h, node)) != 5) or (t == 9 and has_key(DOC_G, k))
    }
    alloc i := cls - 32
    if i >= NCLASS {
        return false
    }
    alloc tab := SETS[i]
    if has_key(tab, k) {
        tab[k](h, o[3], v)
        return true
    }
    alloc any := SET_ANY[i]
    if any != false {
        return any(h, o[3], k, v)
    }
    return has_key(GETS[i], k)
}

proc host_keys(h, o) {
    alloc i := o[0] - 32
    if i > 0 and i < NCLASS and KEYS_OF[i] != false {
        return KEYS_OF[i](h, o[3])
    }
    return []
}

# --- numbers for nodes ----------------------------------------------------------------------

proc register(node, parent) {
    alloc id := length(NODES)
    node.nid := id
    append(NODES, node)
    append(PARENT, parent)
    append(WRAP, 0)
    append(LIS, false)
    return id
}

# Number a node and everything under it.
proc adopt(node, parent) {
    alloc id := register(node, parent)
    if node.t != 3 {
        for k in node.kids {
            adopt(k, id)
        }
        if node.t == 1 and node.tag == "template" and length(node.kids) > 0 {
            # what a <template> holds is not in the document
            template_content(node)
        }
    }
    return id
}

proc parent_of(node) {
    alloc p := PARENT[node.nid]
    if p < 0 {
        return false
    }
    return NODES[p]
}

proc proto_of(node) {
    alloc t := node.t
    if t == 1 {
        if has_key(TAG_PROTO, node.tag) {
            return TAG_PROTO[node.tag]
        }
        return P["HTMLElement"]
    }
    if t == 3 {
        return P["Text"]
    }
    if t == 9 {
        return P["Document"]
    }
    if t == 8 {
        return P["Comment"]
    }
    if t == 11 {
        return P["DocumentFragment"]
    }
    return P["EventTarget"]
}

# The object scripts hold for a node; null for `false`.
proc wrap(node) {
    if type_of(node) != 6 {
        return 0
    }
    alloc id := node.nid
    alloc h := WRAP[id]
    if h != 0 {
        return h
    }
    h := new_obj(32, proto_of(node))
    H[h][3] := id
    WRAP[id] := h
    return h
}

proc is_node(v) {
    return type_of(v) == 2 and v != 0 and H[v][0] == 32
}

# The node behind `this`, for a method called `what`.
proc node_of(v, what) {
    if type_of(v) == 2 and v != 0 and H[v][0] == 32 {
        return NODES[H[v][3]]
    }
    throw_type("Failed to execute '" + what + "': the value is not a Node")
}

proc wrap_list(nodes) {
    alloc out := []
    for n in nodes {
        append(out, wrap(n))
    }
    alloc h := new_array(out)
    H[h][1] := NODELIST
    return h
}

proc dom_error(name, msg) {
    alloc e := make_error(8, msg)
    define_hidden(e, "name", name)
    throw_val(e)
}

# --- the tree -------------------------------------------------------------------------------

proc is_connected(node) {
    alloc id := node.nid
    loop id >= 0 {
        if id == DOC_NID {
            return true
        }
        id := PARENT[id]
    }
    return false
}

proc index_in(parent, node) {
    alloc kids := parent.kids
    alloc id := node.nid
    alloc i := 0
    alloc n := length(kids)
    loop i < n {
        if kids[i].nid == id {
            return i
        }
        i := i + 1
    }
    return -1
}

# The tree changed at `parent`.
# The styles of `node` and of what is below it are stale. The browser
# works them out again for these subtrees only (see take_dirty), which
# on a large page is most of the cost of showing a small change.
proc restyle(node) {
    if node.t == 1 {
        RESTYLE["" + node.nid] := 1
    } elif node.t == 9 {
        RESTYLE_ALL := true
    }
    return true
}

# An element changed in a way a selector can see (an attribute, its
# class): rules like `.a + .b` make that its siblings' business too,
# so it is the parent that is done again.
proc restyle_around(node) {
    alloc p := parent_of(node)
    if p == false {
        return restyle(node)
    }
    return restyle(p)
}

proc touched(parent) {
    DIRTY := true
    VERSION := VERSION + 1
    restyle(parent)
    if parent.t == 1 {
        css.number_kids(parent)
    } elif parent.t == 9 {
        for k in parent.kids {
            if k.t == 1 {
                k.ei := 1
            }
        }
    }
    return true
}

# Something in the subtree that matters beyond the tree itself: a
# style sheet, or a script that has not run.
proc notice(node, added) {
    if node.t != 1 {
        return true
    }
    alloc tag := node.tag
    if tag == "style" or tag == "link" {
        SHEETS := true
    } elif tag == "script" {
        if added and has_key(node, "ran") == false {
            node.ran := true
            if has_key(node.attrs, "src") {
                append(TASKS, [0, node])
            } else {
                run_script_node(node, false)
            }
        }
        return true
    }
    for k in node.kids {
        if k.t == 1 {
            notice(k, added)
        }
    }
    return true
}

# Take a node out of its parent.
proc detach(node) {
    alloc pid := PARENT[node.nid]
    if pid < 0 {
        return false
    }
    alloc parent := NODES[pid]
    alloc i := index_in(parent, node)
    if i >= 0 {
        alloc kids := parent.kids
        alloc rest := kids[0:i]
        alloc j := i + 1
        alloc n := length(kids)
        loop j < n {
            append(rest, kids[j])
            j := j + 1
        }
        parent.kids := rest
    }
    alloc was := is_connected(parent)
    PARENT[node.nid] := -1
    touched(parent)
    if was {
        notice(node, false)
    }
    return true
}

# Put `node` among parent's children, in front of `ref` (at the end
# when ref is false). A fragment gives its children instead.
proc insert_before(parent, node, ref) {
    if parent.t == 3 or parent.t == 8 {
        dom_error("HierarchyRequestError", "This node type does not support this method.")
    }
    if node.t == 11 {
        alloc moving := node.kids
        node.kids := []
        for k in moving {
            PARENT[k.nid] := -1
        }
        for k2 in moving {
            insert_before(parent, k2, ref)
        }
        return node
    }
    if node.t == 9 {
        dom_error("HierarchyRequestError", "A document cannot be put inside a node.")
    }
    # a node cannot go inside itself
    alloc up := parent.nid
    loop up >= 0 {
        if up == node.nid {
            dom_error("HierarchyRequestError", "The new child element contains the parent.")
        }
        up := PARENT[up]
    }
    if ref != false and ref.nid == node.nid {
        # in front of itself: where it is
        return node
    }
    detach(node)
    alloc kids := parent.kids
    alloc at := length(kids)
    if ref != false {
        at := index_in(parent, ref)
        if at < 0 {
            dom_error("NotFoundError", "The node before which the new node is to be inserted is not a child of this node.")
        }
    }
    if at == length(kids) {
        append(kids, node)
    } else {
        alloc out := kids[0:at]
        append(out, node)
        alloc j := at
        alloc n := length(kids)
        loop j < n {
            append(out, kids[j])
            j := j + 1
        }
        parent.kids := out
    }
    PARENT[node.nid] := parent.nid
    touched(parent)
    if is_connected(parent) {
        notice(node, true)
    }
    return node
}

proc remove_all(parent) {
    alloc was := is_connected(parent)
    alloc old := parent.kids
    parent.kids := []
    for k in old {
        PARENT[k.nid] := -1
        if was {
            notice(k, false)
        }
    }
    touched(parent)
    return true
}

proc new_text(s) {
    alloc node := {t: 3, text: s}
    register(node, -1)
    return node
}

proc new_element(tag) {
    alloc node := html.element(tag, {})
    register(node, -1)
    css.prepare_attrs(node)
    node.ei := 1
    node.ne := 0
    return node
}

# What innerHTML is given, as nodes that are numbered and ready.
proc fragment_nodes(text, context) {
    alloc nodes := html.parse_fragment(text, context)
    for n in nodes {
        adopt(n, -1)
        if n.t == 1 {
            css.prepare(n)
            n.ei := 1
        }
    }
    return nodes
}

proc set_text_content(node, s) {
    if node.t == 3 or node.t == 8 {
        node.text := s
        DIRTY := true
        VERSION := VERSION + 1
        alloc p := parent_of(node)
        if p != false and p.t == 1 and p.tag == "style" {
            SHEETS := true
        }
        return true
    }
    remove_all(node)
    if s != "" {
        insert_before(node, new_text(s), false)
    }
    if node.t == 1 and node.tag == "style" {
        SHEETS := true
    }
    return true
}

proc copy_node(node, deep) {
    if node.t == 3 or node.t == 8 {
        alloc tcopy := {t: node.t, text: node.text}
        if node.t == 8 {
            tcopy.kids := []
        }
        register(tcopy, -1)
        return tcopy
    }
    alloc out := false
    if node.t == 1 {
        alloc attrs := {}
        for name in dict_keys(node.attrs) {
            attrs[name] := node.attrs[name]
        }
        out := html.element(node.tag, attrs)
        if has_key(node, "value") {
            out.value := node.value
        }
        if has_key(node, "checked") {
            out.checked := node.checked
        }
    } else {
        out := {t: 11, kids: []}
    }
    alloc id := register(out, -1)
    if node.t == 1 {
        css.prepare_attrs(out)
        out.ei := 1
        out.ne := 0
    }
    if deep {
        for k in node.kids {
            alloc kc := copy_node(k, true)
            append(out.kids, kc)
            PARENT[kc.nid] := id
        }
        if node.t == 1 {
            css.number_kids(out)
        }
        if node.t == 1 and has_key(node, "content") {
            alloc fc := copy_node(NODES[node.content], true)
            out.content := fc.nid
            out.frag := fc
        }
    }
    return out
}

# The elements from the top of the tree down to node, and where each
# sits among its parent's children: what css.omg matches against.
proc chain_of(node) {
    alloc up := []
    alloc cur := node
    loop cur != false and cur.t == 1 {
        append(up, cur)
        cur := parent_of(cur)
    }
    alloc chain := []
    alloc idx := []
    alloc i := length(up) - 1
    loop i >= 0 {
        alloc el := up[i]
        append(chain, el)
        alloc p := parent_of(el)
        if p == false {
            append(idx, 0)
        } else {
            append(idx, index_in(p, el))
        }
        i := i - 1
    }
    return [chain, idx]
}

alloc SEL_CACHE := {}

proc selectors_of(text) {
    if has_key(SEL_CACHE, text) {
        return SEL_CACHE[text]
    }
    alloc sels := css.selectors(text)
    if length(sels) == 0 {
        dom_error("SyntaxError", "'" + text + "' is not a valid selector.")
    }
    SEL_CACHE[text] := sels
    return sels
}

proc query(node, text, first) {
    alloc sels := selectors_of(text)
    alloc out := []
    if node.t == 1 {
        alloc ch := chain_of(node)
        css.select(sels, node, ch[0], ch[1], first, out)
    } else {
        css.select(sels, node, [], [], first, out)
    }
    return out
}

proc node_matches(node, text) {
    alloc ch := chain_of(node)
    return css.matches(selectors_of(text), ch[0], ch[1])
}

alloc ID_MAP := {}
alloc ID_VERSION := -1

proc index_ids(node) {
    for k in node.kids {
        if k.t == 1 {
            if has_key(k.attrs, "id") and has_key(ID_MAP, k.attrs["id"]) == false {
                ID_MAP[k.attrs["id"]] := k
            }
            index_ids(k)
        }
    }
    return true
}

proc by_id(id) {
    if ID_VERSION != VERSION {
        ID_MAP := {}
        index_ids(DOC)
        ID_VERSION := VERSION
    }
    if has_key(ID_MAP, id) {
        return ID_MAP[id]
    }
    return false
}

proc collect(node, tag, cls, out) {
    for k in node.kids {
        if k.t == 1 {
            if tag != "" {
                if tag == "*" or k.tag == tag {
                    append(out, k)
                }
            } else {
                alloc all := true
                for want in cls {
                    alloc found := false
                    for have in k.cls {
                        if have == want {
                            found := true
                            break
                        }
                    }
                    if found == false {
                        all := false
                        break
                    }
                }
                if all {
                    append(out, k)
                }
            }
            collect(k, tag, cls, out)
        }
    }
    return out
}

# --- attributes -----------------------------------------------------------------------------

proc set_attr(node, name, value) {
    node.attrs[name] := value
    DIRTY := true
    restyle_around(node)
    VERSION := VERSION + 1
    if name == "class" or name == "id" or name == "style" {
        css.prepare_attrs(node)
    } elif node.tag == "link" or (node.tag == "style" and name == "media") {
        if is_connected(node) {
            SHEETS := true
        }
    } elif name == "value" and node.tag == "input" and has_key(node, "value") {
        # the attribute is the starting value; what was typed stays
        return true
    }
    return true
}

proc remove_attr(node, name) {
    if has_key(node.attrs, name) == false {
        return false
    }
    alloc attrs := {}
    for k in dict_keys(node.attrs) {
        if k != name {
            attrs[k] := node.attrs[k]
        }
    }
    node.attrs := attrs
    DIRTY := true
    restyle_around(node)
    VERSION := VERSION + 1
    if name == "class" or name == "id" or name == "style" {
        css.prepare_attrs(node)
    }
    return true
}

proc attr_or(node, name, otherwise) {
    if has_key(node.attrs, name) {
        return node.attrs[name]
    }
    return otherwise
}

# --- what a node's properties are -----------------------------------------------------------

proc g_node_type(h, node) {
    return float(node.t)
}

proc g_node_name(h, node) {
    alloc t := node.t
    if t == 1 {
        return u.upper(node.tag)
    }
    if t == 3 {
        return "#text"
    }
    if t == 8 {
        return "#comment"
    }
    if t == 9 {
        return "#document"
    }
    return "#document-fragment"
}

proc g_node_value(h, node) {
    if node.t == 3 or node.t == 8 {
        return node.text
    }
    return 0
}

proc s_node_value(h, node, v) {
    if node.t == 3 or node.t == 8 {
        set_text_content(node, to_str(v))
    }
}

proc g_parent_node(h, node) {
    return wrap(parent_of(node))
}

proc g_parent_element(h, node) {
    alloc p := parent_of(node)
    if p != false and p.t == 1 {
        return wrap(p)
    }
    return 0
}

proc kids_of(node) {
    if node.t == 3 {
        return []
    }
    return node.kids
}

proc g_child_nodes(h, node) {
    return wrap_list(kids_of(node))
}

proc g_first_child(h, node) {
    alloc kids := kids_of(node)
    if length(kids) == 0 {
        return 0
    }
    return wrap(kids[0])
}

proc g_last_child(h, node) {
    alloc kids := kids_of(node)
    if length(kids) == 0 {
        return 0
    }
    return wrap(kids[length(kids) - 1])
}

# The node `step` places along from node among its sisters; elements
# only when asked.
proc sibling(node, step, elements) {
    alloc p := parent_of(node)
    if p == false {
        return false
    }
    alloc kids := p.kids
    alloc i := index_in(p, node) + step
    loop i >= 0 and i < length(kids) {
        if elements == false or kids[i].t == 1 {
            return kids[i]
        }
        i := i + step
    }
    return false
}

proc g_previous_sibling(h, node) {
    return wrap(sibling(node, -1, false))
}

proc g_next_sibling(h, node) {
    return wrap(sibling(node, 1, false))
}

proc g_text_content(h, node) {
    if node.t == 9 {
        return 0
    }
    return html.text_of(node)
}

proc s_text_content(h, node, v) {
    if node.t == 9 {
        return true
    }
    if is_nullish(v) {
        set_text_content(node, "")
    } else {
        set_text_content(node, to_str(v))
    }
}

proc g_owner_document(h, node) {
    if node.t == 9 {
        return 0
    }
    return wrap(DOC)
}

proc g_is_connected(h, node) {
    return is_connected(node)
}

proc g_base_uri(h, node) {
    return BASE
}

# -- elements

proc g_tag_name(h, node) {
    return u.upper(node.tag)
}

proc g_local_name(h, node) {
    return node.tag
}

proc g_id(h, node) {
    return attr_or(node, "id", "")
}

proc s_id(h, node, v) {
    set_attr(node, "id", to_str(v))
}

proc g_class_name(h, node) {
    return attr_or(node, "class", "")
}

proc s_class_name(h, node, v) {
    set_attr(node, "class", to_str(v))
}

proc g_inner_html(h, node) {
    if node.t == 1 and node.tag == "template" and has_key(node, "content") {
        return html.inner_html(NODES[node.content])
    }
    return html.inner_html(node)
}

proc set_inner_html(node, text) {
    alloc context := "div"
    if node.t == 1 {
        context := node.tag
        if context == "template" {
            context := "div"
            node := template_content(node)
        }
    }
    alloc nodes := fragment_nodes(text, context)
    remove_all(node)
    for n in nodes {
        insert_before(node, n, false)
    }
    return true
}

proc s_inner_html(h, node, v) {
    if is_nullish(v) {
        set_inner_html(node, "")
    } else {
        set_inner_html(node, to_str(v))
    }
}

proc g_outer_html(h, node) {
    return html.outer_html(node)
}

proc s_outer_html(h, node, v) {
    alloc p := parent_of(node)
    if p == false {
        return true
    }
    alloc context := "div"
    if p.t == 1 {
        context := p.tag
    }
    for n in fragment_nodes(to_str(v), context) {
        insert_before(p, n, node)
    }
    detach(node)
}

proc visible_text(node, parts) {
    if node.t == 3 {
        append(parts, node.text)
        return true
    }
    if node.t == 1 {
        alloc tag := node.tag
        if tag == "script" or tag == "style" or tag == "template" {
            return true
        }
        if tag == "br" {
            append(parts, "\n")
        }
    }
    for k in node.kids {
        visible_text(k, parts)
    }
    return true
}

proc g_inner_text(h, node) {
    alloc parts := []
    visible_text(node, parts)
    return u.join(parts, "")
}

proc element_kids(node) {
    alloc out := []
    for k in kids_of(node) {
        if k.t == 1 {
            append(out, k)
        }
    }
    return out
}

proc g_children(h, node) {
    return wrap_list(element_kids(node))
}

proc g_first_element_child(h, node) {
    for k in kids_of(node) {
        if k.t == 1 {
            return wrap(k)
        }
    }
    return 0
}

proc g_last_element_child(h, node) {
    alloc kids := kids_of(node)
    alloc i := length(kids) - 1
    loop i >= 0 {
        if kids[i].t == 1 {
            return wrap(kids[i])
        }
        i := i - 1
    }
    return 0
}

proc g_previous_element_sibling(h, node) {
    return wrap(sibling(node, -1, true))
}

proc g_next_element_sibling(h, node) {
    return wrap(sibling(node, 1, true))
}

proc g_child_element_count(h, node) {
    return float(length(element_kids(node)))
}

proc g_attributes(h, node) {
    alloc out := []
    for name in dict_keys(node.attrs) {
        alloc a := new_object()
        put(a, "name", name)
        put(a, "nodeName", name)
        put(a, "localName", name)
        put(a, "value", node.attrs[name])
        put(a, "nodeValue", node.attrs[name])
        put(a, "specified", true)
        append(out, a)
    }
    return new_array(out)
}

proc g_hidden(h, node) {
    return has_key(node.attrs, "hidden")
}

proc set_bool_attr(node, name, on) {
    if on {
        set_attr(node, name, "")
    } else {
        remove_attr(node, name)
    }
    return true
}

proc s_hidden(h, node, v) {
    set_bool_attr(node, "hidden", to_bool(v))
}

proc sub_object(h, node, key, cls) {
    alloc o := H[h]
    alloc hk := "@@" + key
    if has_key(o[2], hk) {
        return o[2][hk]
    }
    alloc s := new_obj(cls, P[key])
    H[s][3] := node.nid
    define_hidden(h, hk, s)
    return s
}

proc g_style(h, node) {
    return sub_object(h, node, "CSSStyleDeclaration", C_STYLE)
}

proc s_style(h, node, v) {
    set_attr(node, "style", to_str(v))
}

proc g_dataset(h, node) {
    return sub_object(h, node, "DOMStringMap", C_DATASET)
}

proc g_class_list(h, node) {
    return sub_object(h, node, "DOMTokenList", C_TOKENS)
}

proc s_class_list(h, node, v) {
    set_attr(node, "class", to_str(v))
}

proc g_tab_index(h, node) {
    alloc tag := node.tag
    alloc d := -1.0
    if tag == "a" or tag == "input" or tag == "button" or tag == "select" or tag == "textarea" {
        d := 0.0
    }
    return float(u.to_int(attr_or(node, "tabindex", ""), int(d)))
}

# -- form controls: what was typed or ticked lives on the node, where
# the window keeps it too

proc options_of(node, out) {
    for k in node.kids {
        if k.t == 1 {
            if k.tag == "option" {
                append(out, k)
            } else {
                options_of(k, out)
            }
        }
    }
    return out
}

proc selected_index(node) {
    alloc opts := options_of(node, [])
    if length(opts) == 0 {
        return -1
    }
    if has_key(node, "sel") and node.sel < length(opts) {
        return node.sel
    }
    alloc i := 0
    loop i < length(opts) {
        if has_key(opts[i].attrs, "selected") {
            return i
        }
        i := i + 1
    }
    return 0
}

proc option_value(o) {
    if has_key(o.attrs, "value") {
        return o.attrs["value"]
    }
    return u.join(u.words(html.text_of(o)), " ")
}

proc control_value(node) {
    alloc tag := node.tag
    if tag == "select" {
        alloc i := selected_index(node)
        if i < 0 {
            return ""
        }
        return option_value(options_of(node, [])[i])
    }
    if tag == "option" {
        return option_value(node)
    }
    if has_key(node, "value") {
        return node.value
    }
    if tag == "textarea" {
        alloc s := html.text_of(node)
        if u.starts_with(s, "\n") {
            s := s[1:]
        }
        return s
    }
    if tag == "input" {
        alloc ty := u.lower(attr_or(node, "type", "text"))
        if (ty == "checkbox" or ty == "radio") and has_key(node.attrs, "value") == false {
            return "on"
        }
    }
    return attr_or(node, "value", "")
}

alloc VALUE_TAGS := {input: 1, textarea: 1, select: 1, option: 1, button: 1, param: 1, data: 1, meter: 1, progress: 1, li: 1, output: 1}

proc g_value(h, node) {
    if has_key(VALUE_TAGS, node.tag) == false {
        return MISS
    }
    if node.tag == "li" or node.tag == "meter" or node.tag == "progress" {
        return u.to_number(attr_or(node, "value", "0"), 0) * 1.0
    }
    return control_value(node)
}

proc s_value(h, node, v) {
    alloc tag := node.tag
    if has_key(VALUE_TAGS, tag) == false {
        return false
    }
    alloc s := ""
    if is_nullish(v) == false {
        s := to_str(v)
    }
    if tag == "select" {
        alloc opts := options_of(node, [])
        alloc i := 0
        loop i < length(opts) {
            if option_value(opts[i]) == s {
                node.sel := i
                break
            }
            i := i + 1
        }
        DIRTY := true
        return true
    }
    if tag == "input" or tag == "textarea" {
        alloc ty := u.lower(attr_or(node, "type", "text"))
        if tag == "input" and (ty == "checkbox" or ty == "radio" or ty == "submit" or ty == "button" or ty == "hidden" or ty == "reset" or ty == "image") {
            set_attr(node, "value", s)
            return true
        }
        node.value := s
        node.caret := length(u.cps(s))
        DIRTY := true
        return true
    }
    set_attr(node, "value", s)
    return true
}

proc is_checked(node) {
    if has_key(node, "checked") {
        return node.checked
    }
    return has_key(node.attrs, "checked")
}

proc g_checked(h, node) {
    if node.tag != "input" {
        return MISS
    }
    return is_checked(node)
}

proc form_of(node) {
    alloc p := parent_of(node)
    loop p != false and p.t == 1 {
        if p.tag == "form" {
            return p
        }
        p := parent_of(p)
    }
    return false
}

proc controls_in(node, out) {
    for k in node.kids {
        if k.t == 1 {
            alloc tag := k.tag
            if tag == "input" or tag == "select" or tag == "textarea" or tag == "button" {
                append(out, k)
            }
            controls_in(k, out)
        }
    }
    return out
}

proc s_checked(h, node, v) {
    if node.tag != "input" {
        return false
    }
    alloc on := to_bool(v)
    if on and u.lower(attr_or(node, "type", "")) == "radio" and has_key(node.attrs, "name") {
        # the others of its group go off
        alloc scope := form_of(node)
        if scope == false {
            scope := DOC
        }
        for other in controls_in(scope, []) {
            if other.tag == "input" and u.lower(attr_or(other, "type", "")) == "radio" and attr_or(other, "name", "") == node.attrs["name"] {
                other.checked := false
            }
        }
    }
    node.checked := on
    DIRTY := true
    RESTYLE_ALL := true
    return true
}

proc g_selected(h, node) {
    if node.tag != "option" {
        return MISS
    }
    alloc p := parent_of(node)
    loop p != false and p.t == 1 and p.tag != "select" {
        p := parent_of(p)
    }
    if p == false or p.t != 1 {
        return has_key(node.attrs, "selected")
    }
    alloc opts := options_of(p, [])
    alloc i := selected_index(p)
    return i >= 0 and opts[i].nid == node.nid
}

proc s_selected(h, node, v) {
    if node.tag != "option" {
        return false
    }
    alloc p := parent_of(node)
    loop p != false and p.t == 1 and p.tag != "select" {
        p := parent_of(p)
    }
    if p != false and p.t == 1 and to_bool(v) {
        alloc opts := options_of(p, [])
        alloc i := 0
        loop i < length(opts) {
            if opts[i].nid == node.nid {
                p.sel := i
            }
            i := i + 1
        }
        DIRTY := true
    }
    return true
}

proc g_selected_index(h, node) {
    if node.tag != "select" {
        return MISS
    }
    return float(selected_index(node))
}

proc s_selected_index(h, node, v) {
    if node.tag != "select" {
        return false
    }
    alloc i := to_integer(v)
    if i >= 0.0 and i < 100000.0 {
        node.sel := int(i)
        DIRTY := true
    }
    return true
}

proc g_options(h, node) {
    if node.tag != "select" and node.tag != "datalist" {
        return MISS
    }
    return wrap_list(options_of(node, []))
}

proc g_form(h, node) {
    alloc tag := node.tag
    if tag == "input" or tag == "select" or tag == "textarea" or tag == "button" or tag == "label" or tag == "option" or tag == "fieldset" {
        return wrap(form_of(node))
    }
    return MISS
}

proc g_elements(h, node) {
    if node.tag != "form" {
        return MISS
    }
    return wrap_list(controls_in(node, []))
}

proc g_length(h, node) {
    if node.tag == "form" {
        return float(length(controls_in(node, [])))
    }
    if node.tag == "select" {
        return float(length(options_of(node, [])))
    }
    return MISS
}

proc g_text(h, node) {
    alloc tag := node.tag
    if tag == "script" or tag == "a" or tag == "option" or tag == "title" {
        return html.text_of(node)
    }
    return MISS
}

proc s_text(h, node, v) {
    alloc tag := node.tag
    if tag == "script" or tag == "a" or tag == "option" or tag == "title" {
        set_text_content(node, to_str(v))
        return true
    }
    return false
}

proc g_label_text(h, node) {
    if node.tag == "option" {
        if has_key(node.attrs, "label") {
            return node.attrs["label"]
        }
        return u.join(u.words(html.text_of(node)), " ")
    }
    return MISS
}

proc g_type(h, node) {
    alloc tag := node.tag
    if tag == "input" {
        return u.lower(attr_or(node, "type", "text"))
    }
    if tag == "button" {
        return u.lower(attr_or(node, "type", "submit"))
    }
    if tag == "select" {
        if has_key(node.attrs, "multiple") {
            return "select-multiple"
        }
        return "select-one"
    }
    if tag == "textarea" {
        return "textarea"
    }
    if tag == "script" or tag == "style" or tag == "link" or tag == "a" or tag == "source" or tag == "object" or tag == "embed" or tag == "ol" or tag == "ul" or tag == "li" {
        return attr_or(node, "type", "")
    }
    return MISS
}

proc s_type(h, node, v) {
    if type_of(g_type(h, node)) == 5 {
        return false
    }
    set_attr(node, "type", to_str(v))
    return true
}

# -- the parts of the address a link points at

alloc URL_TAGS := {a: 1, area: 1}

proc link_parts(node) {
    if has_key(URL_TAGS, node.tag) == false {
        return false
    }
    alloc where := url.resolve(BASE, attr_or(node, "href", ""))
    return url.parse(where)
}

proc host_text(p) {
    if p.port != 0 {
        return p.host + ":" + p.port
    }
    return p.host
}

proc g_protocol(h, node) {
    alloc p := link_parts(node)
    if p == false {
        if has_key(URL_TAGS, node.tag) {
            return ":"
        }
        return MISS
    }
    return p.scheme + ":"
}

proc g_host(h, node) {
    alloc p := link_parts(node)
    if p == false {
        if has_key(URL_TAGS, node.tag) {
            return ""
        }
        return MISS
    }
    return host_text(p)
}

proc g_hostname(h, node) {
    alloc p := link_parts(node)
    if p == false {
        if has_key(URL_TAGS, node.tag) {
            return ""
        }
        return MISS
    }
    return p.host
}

proc g_pathname(h, node) {
    alloc p := link_parts(node)
    if p == false {
        if has_key(URL_TAGS, node.tag) {
            return ""
        }
        return MISS
    }
    return p.path
}

proc g_search(h, node) {
    alloc p := link_parts(node)
    if p == false {
        if has_key(URL_TAGS, node.tag) {
            return ""
        }
        return MISS
    }
    if p.query == "?" {
        return ""
    }
    return p.query
}

proc g_hash(h, node) {
    alloc p := link_parts(node)
    if p == false {
        if has_key(URL_TAGS, node.tag) {
            return ""
        }
        return MISS
    }
    if p.frag == "#" {
        return ""
    }
    return p.frag
}

proc g_origin(h, node) {
    alloc p := link_parts(node)
    if p == false {
        if has_key(URL_TAGS, node.tag) {
            return ""
        }
        return MISS
    }
    return url.origin(p)
}

# -- where an element is on the page; the browser lays it out first

proc rect_of(node) {
    if has_key(HOST, "rect") == false {
        return [0, 0, 0, 0]
    }
    alloc r := HOST["rect"](node)
    if r == false {
        return [0, 0, 0, 0]
    }
    return r
}

proc view() {
    if has_key(HOST, "view") {
        return HOST["view"]()
    }
    return [1024, 768, 0, 0, 1024, 768]
}

proc g_offset_width(h, node) {
    return float(round(rect_of(node)[2]))
}

proc g_offset_height(h, node) {
    return float(round(rect_of(node)[3]))
}

proc g_offset_left(h, node) {
    return float(round(rect_of(node)[0]))
}

proc g_offset_top(h, node) {
    return float(round(rect_of(node)[1]))
}

proc g_offset_parent(h, node) {
    if node.tag == "body" or node.tag == "html" {
        return 0
    }
    return wrap(DOC.body)
}

proc g_client_width(h, node) {
    if node.tag == "html" or node.tag == "body" {
        return float(view()[0])
    }
    return float(round(rect_of(node)[2]))
}

proc g_client_height(h, node) {
    if node.tag == "html" {
        return float(view()[1])
    }
    return float(round(rect_of(node)[3]))
}

proc g_zero(h, node) {
    return 0.0
}

proc g_scroll_width(h, node) {
    if node.tag == "html" or node.tag == "body" {
        return float(view()[4])
    }
    return float(round(rect_of(node)[2]))
}

proc g_scroll_height(h, node) {
    if node.tag == "html" or node.tag == "body" {
        return float(view()[5])
    }
    return float(round(rect_of(node)[3]))
}

proc g_scroll_top(h, node) {
    if node.tag == "html" or node.tag == "body" {
        return float(view()[3])
    }
    return 0.0
}

proc s_scroll_top(h, node, v) {
    if (node.tag == "html" or node.tag == "body") and has_key(HOST, "scroll") {
        HOST["scroll"](view()[2], int(to_integer(v)))
    }
    return true
}

proc g_scroll_left(h, node) {
    if node.tag == "html" or node.tag == "body" {
        return float(view()[2])
    }
    return 0.0
}

proc s_scroll_left(h, node, v) {
    return true
}

proc g_natural_width(h, node) {
    if node.tag != "img" {
        return MISS
    }
    if has_key(HOST, "picture") {
        return float(HOST["picture"](node)[0])
    }
    return 0.0
}

proc g_natural_height(h, node) {
    if node.tag != "img" {
        return MISS
    }
    if has_key(HOST, "picture") {
        return float(HOST["picture"](node)[1])
    }
    return 0.0
}

proc g_complete(h, node) {
    if node.tag != "img" {
        return MISS
    }
    return true
}

proc g_width(h, node) {
    alloc tag := node.tag
    if tag == "img" or tag == "canvas" or tag == "video" or tag == "iframe" or tag == "input" or tag == "table" or tag == "td" or tag == "th" or tag == "object" or tag == "embed" or tag == "svg" {
        if tag == "img" and is_connected(node) {
            return float(round(rect_of(node)[2]))
        }
        return float(u.to_int(attr_or(node, "width", "0"), 0))
    }
    return MISS
}

proc g_height(h, node) {
    alloc tag := node.tag
    if tag == "img" or tag == "canvas" or tag == "video" or tag == "iframe" or tag == "input" or tag == "table" or tag == "td" or tag == "th" or tag == "object" or tag == "embed" or tag == "svg" {
        if tag == "img" and is_connected(node) {
            return float(round(rect_of(node)[3]))
        }
        return float(u.to_int(attr_or(node, "height", "0"), 0))
    }
    return MISS
}

proc s_width(h, node, v) {
    if type_of(g_width(h, node)) == 5 {
        return false
    }
    set_attr(node, "width", to_str(v))
    return true
}

proc s_height(h, node, v) {
    if type_of(g_height(h, node)) == 5 {
        return false
    }
    set_attr(node, "height", to_str(v))
    return true
}

proc g_content_template(h, node) {
    if node.tag == "meta" {
        return attr_or(node, "content", "")
    }
    if node.tag == "template" {
        return wrap(template_content(node))
    }
    return MISS
}

proc s_content(h, node, v) {
    if node.tag == "meta" {
        set_attr(node, "content", to_str(v))
        return true
    }
    return false
}

# Properties that are an attribute under another name. Each is
# [kind, attribute]: kind 0 text, 1 there or not, 2 an address (given
# whole), 3 a whole number.
alloc REFLECT := {
    title: [0, "title"], lang: [0, "lang"], dir: [0, "dir"], name: [0, "name"], alt: [0, "alt"],
    placeholder: [0, "placeholder"], rel: [0, "rel"], target: [0, "target"], htmlFor: [0, "for"],
    accept: [0, "accept"], media: [0, "media"], srcset: [0, "srcset"], sizes: [0, "sizes"],
    charset: [0, "charset"], crossOrigin: [0, "crossorigin"], integrity: [0, "integrity"],
    nonce: [0, "nonce"], role: [0, "role"], slot: [0, "slot"], method: [0, "method"],
    enctype: [0, "enctype"], autocomplete: [0, "autocomplete"], pattern: [0, "pattern"],
    min: [0, "min"], max: [0, "max"], step: [0, "step"], download: [0, "download"],
    loading: [0, "loading"], decoding: [0, "decoding"], referrerPolicy: [0, "referrerpolicy"],
    defaultValue: [0, "value"], httpEquiv: [0, "http-equiv"], scope: [0, "scope"],
    accessKey: [0, "accesskey"], inputMode: [0, "inputmode"], useMap: [0, "usemap"],
    disabled: [1, "disabled"], readOnly: [1, "readonly"], required: [1, "required"],
    multiple: [1, "multiple"], autofocus: [1, "autofocus"], defaultChecked: [1, "checked"],
    defaultSelected: [1, "selected"], async: [1, "async"], defer: [1, "defer"],
    noModule: [1, "nomodule"], open: [1, "open"], controls: [1, "controls"], "loop": [1, "loop"],
    muted: [1, "muted"], autoplay: [1, "autoplay"], noValidate: [1, "novalidate"],
    draggable: [1, "draggable"], inert: [1, "inert"], reversed: [1, "reversed"],
    allowFullscreen: [1, "allowfullscreen"], isMap: [1, "ismap"],
    href: [2, "href"], src: [2, "src"], action: [2, "action"], poster: [2, "poster"],
    cite: [2, "cite"], formAction: [2, "formaction"], currentSrc: [2, "src"],
    maxLength: [3, "maxlength"], minLength: [3, "minlength"], size: [3, "size"],
    cols: [3, "cols"], rows: [3, "rows"], colSpan: [3, "colspan"], rowSpan: [3, "rowspan"],
    start: [3, "start"], span: [3, "span"]
}

proc reflect_get(node, r) {
    alloc kind := r[0]
    alloc name := r[1]
    if kind == 0 {
        return attr_or(node, name, "")
    }
    if kind == 1 {
        return has_key(node.attrs, name)
    }
    if kind == 2 {
        if has_key(node.attrs, name) == false {
            return ""
        }
        alloc whole := url.resolve(BASE, node.attrs[name])
        if whole == "" {
            return node.attrs[name]
        }
        return whole
    }
    alloc d := 0
    if name == "colspan" or name == "rowspan" or name == "span" or name == "start" {
        d := 1
    } elif name == "maxlength" or name == "minlength" {
        d := -1
    } elif name == "size" or name == "cols" {
        d := 20
    } elif name == "rows" {
        d := 2
    }
    return float(u.to_int(attr_or(node, name, ""), d))
}

proc reflect_set(node, r, v) {
    alloc kind := r[0]
    if kind == 1 {
        set_bool_attr(node, r[1], to_bool(v))
    } else {
        set_attr(node, r[1], to_str(v))
        if r[1] == "src" and node.tag == "img" {
            append(TASKS, [3, node, "load"])
        }
    }
    return true
}

# -- text and comments

proc g_data(h, node) {
    return node.text
}

proc s_data(h, node, v) {
    set_text_content(node, to_str(v))
}

proc g_text_length(h, node) {
    return float(length(node.text))
}

# --- el.style -------------------------------------------------------------------------------

# "backgroundColor" as CSS writes it: "background-color".
proc css_name(k) {
    if k == "cssFloat" {
        return "float"
    }
    alloc b := string_bytes(k)
    alloc plain := true
    for ch in b {
        if ch >= 65 and ch <= 90 {
            plain := false
            break
        }
    }
    if plain {
        return k
    }
    if length(b) > 2 and b[0] == 45 and b[1] == 45 {
        return k
    }
    alloc out := bytes_repeat(0, 0)
    if u.starts_with(k, "webkit") or u.starts_with(k, "moz") or u.starts_with(k, "ms") {
        append(out, 45)
    }
    for ch2 in b {
        if ch2 >= 65 and ch2 <= 90 {
            append(out, 45)
            append(out, ch2 + 32)
        } else {
            append(out, ch2)
        }
    }
    return bytes_to_string(out)
}

# "data-user-id" as scripts write it: "userId" (without the "data-").
proc camel_name(k) {
    alloc b := string_bytes(k)
    alloc out := bytes_repeat(0, 0)
    alloc up := false
    for ch in b {
        if ch == 45 {
            up := true
        } elif up and ch >= 97 and ch <= 122 {
            append(out, ch - 32)
            up := false
        } else {
            append(out, ch)
            up := false
        }
    }
    return bytes_to_string(out)
}

# The declarations of a style="" text: [[name, value], ...].
proc style_decls(text) {
    alloc b := string_bytes(text)
    alloc n := length(b)
    alloc out := []
    alloc start := 0
    alloc depth := 0
    alloc quote := 0
    alloc colon := -1
    alloc i := 0
    loop i <= n {
        alloc ch := 59
        if i < n {
            ch := b[i]
        }
        if quote != 0 {
            if ch == quote and i < n {
                quote := 0
            } elif i == n {
                quote := 0
                continue
            }
        } elif ch == 34 or ch == 39 {
            quote := ch
        } elif ch == 40 {
            depth := depth + 1
        } elif ch == 41 {
            if depth > 0 {
                depth := depth - 1
            }
        } elif ch == 58 and colon < 0 and depth == 0 {
            colon := i
        } elif ch == 59 and (depth == 0 or i == n) {
            if colon > start {
                alloc name := u.trim(bytes_to_string(b[start:colon]))
                alloc value := u.trim(bytes_to_string(b[colon + 1:i]))
                if u.starts_with(name, "--") == false {
                    name := u.lower(name)
                }
                if name != "" and value != "" {
                    append(out, [name, value])
                }
            }
            start := i + 1
            colon := -1
            depth := 0
        }
        i := i + 1
    }
    return out
}

proc decls_text(decls) {
    alloc parts := []
    for d in decls {
        append(parts, d[0] + ": " + d[1] + ";")
    }
    return u.join(parts, " ")
}

proc style_value(node, name) {
    if has_key(node.attrs, "style") == false {
        return ""
    }
    alloc found := ""
    for d in style_decls(node.attrs["style"]) {
        if d[0] == name {
            found := d[1]
        }
    }
    if u.ends_with(found, "!important") {
        found := u.trim(found[0:length(found) - 10])
    }
    return found
}

proc style_put(node, name, value) {
    alloc decls := style_decls(attr_or(node, "style", ""))
    alloc out := []
    alloc done := false
    for d in decls {
        if d[0] == name {
            if value != "" and done == false {
                append(out, [name, value])
            }
            done := true
        } else {
            append(out, d)
        }
    }
    if done == false and value != "" {
        append(out, [name, value])
    }
    if length(out) == 0 and has_key(node.attrs, "style") == false {
        return true
    }
    set_attr(node, "style", decls_text(out))
    return true
}

alloc STYLE_SKIP := {setProperty: 1, getPropertyValue: 1, removeProperty: 1, getPropertyPriority: 1,
                     item: 1, toString: 1, valueOf: 1, constructor: 1, hasOwnProperty: 1,
                     toJSON: 1, then: 1, parentRule: 1, isPrototypeOf: 1, propertyIsEnumerable: 1,
                     toLocaleString: 1, "__proto__": 1}

proc is_symbol_name(k) {
    return length(k) > 1 and k[0:2] == "@@"
}

proc style_get(h, id, k) {
    if has_key(STYLE_SKIP, k) or is_symbol_name(k) {
        return MISS
    }
    return style_value(NODES[id], css_name(k))
}

proc style_text(v) {
    if is_nullish(v) {
        return ""
    }
    return u.trim(to_str(v))
}

proc style_set(h, id, k, v) {
    if has_key(STYLE_SKIP, k) or is_symbol_name(k) {
        return false
    }
    style_put(NODES[id], css_name(k), style_text(v))
    return true
}

proc style_keys(h, id) {
    alloc out := []
    for d in style_decls(attr_or(NODES[id], "style", "")) {
        append(out, camel_name(d[0]))
    }
    return out
}

proc g_css_text(h, id) {
    return decls_text(style_decls(attr_or(NODES[id], "style", "")))
}

proc s_css_text(h, id, v) {
    set_attr(NODES[id], "style", style_text(v))
}

proc g_style_length(h, id) {
    return float(length(style_decls(attr_or(NODES[id], "style", ""))))
}

proc style_this(this) {
    if type_of(this) == 2 and this != 0 and (H[this][0] == C_STYLE or H[this][0] == C_COMPUTED) {
        return this
    }
    throw_type("Illegal invocation")
}

proc n_style_set_property(this, args) {
    alloc s := style_this(this)
    if H[s][0] == C_STYLE {
        alloc value := style_text(arg(args, 1))
        if value != "" and style_text(arg(args, 2)) == "important" {
            value := value + " !important"
        }
        style_put(NODES[H[s][3]], css_name(to_str(arg(args, 0))), value)
    }
    return U
}

proc n_style_get_property_value(this, args) {
    alloc s := style_this(this)
    alloc name := css_name(to_str(arg(args, 0)))
    if H[s][0] == C_COMPUTED {
        return computed_value(NODES[H[s][3]], name)
    }
    return style_value(NODES[H[s][3]], name)
}

proc n_style_remove_property(this, args) {
    alloc s := style_this(this)
    if H[s][0] != C_STYLE {
        return ""
    }
    alloc name := css_name(to_str(arg(args, 0)))
    alloc old := style_value(NODES[H[s][3]], name)
    style_put(NODES[H[s][3]], name, "")
    return old
}

proc n_style_get_property_priority(this, args) {
    return ""
}

proc n_style_item(this, args) {
    alloc s := style_this(this)
    alloc decls := style_decls(attr_or(NODES[H[s][3]], "style", ""))
    alloc i := to_integer(arg(args, 0))
    if i >= 0.0 and i < float(length(decls)) {
        return decls[int(i)][0]
    }
    return ""
}

# -- getComputedStyle(el)

proc computed_value(node, name) {
    # styles only: the layout is not needed for most answers
    if has_key(HOST, "restyle") {
        HOST["restyle"]()
    } elif has_key(HOST, "reflow") {
        HOST["reflow"]()
    }
    if node.t != 1 or has_key(node, "style") == false {
        return ""
    }
    alloc st := node.style
    if name == "width" or name == "height" {
        alloc shown := css.computed_text(st, "display")
        if shown != "none" and shown != "inline" and is_connected(node) {
            alloc r := rect_of(node)
            if name == "width" {
                return css.number_text(r[2] * 1.0) + "px"
            }
            return css.number_text(r[3] * 1.0) + "px"
        }
    }
    return css.computed_text(st, name)
}

proc computed_get(h, id, k) {
    if has_key(STYLE_SKIP, k) or is_symbol_name(k) {
        return MISS
    }
    return computed_value(NODES[id], css_name(k))
}

proc computed_set(h, id, k, v) {
    return true
}

# --- el.dataset -----------------------------------------------------------------------------

proc dataset_get(h, id, k) {
    if is_symbol_name(k) {
        return MISS
    }
    alloc name := "data-" + css_name(k)
    alloc node := NODES[id]
    if has_key(node.attrs, name) {
        return node.attrs[name]
    }
    return MISS
}

proc dataset_set(h, id, k, v) {
    set_attr(NODES[id], "data-" + css_name(k), to_str(v))
    return true
}

proc dataset_keys(h, id) {
    alloc out := []
    for name in dict_keys(NODES[id].attrs) {
        if u.starts_with(name, "data-") {
            append(out, camel_name(name[5:]))
        }
    }
    return out
}

# --- el.classList ---------------------------------------------------------------------------

proc tokens_node(this) {
    if type_of(this) == 2 and this != 0 and H[this][0] == C_TOKENS {
        return NODES[H[this][3]]
    }
    throw_type("Illegal invocation")
}

proc class_words(node) {
    return u.words(attr_or(node, "class", ""))
}

proc has_word(list, w) {
    for x in list {
        if x == w {
            return true
        }
    }
    return false
}

proc n_tokens_add(this, args) {
    alloc node := tokens_node(this)
    alloc list := class_words(node)
    alloc changed := false
    for a in args {
        alloc w := to_str(a)
        if w != "" and has_word(list, w) == false {
            append(list, w)
            changed := true
        }
    }
    if changed {
        set_attr(node, "class", u.join(list, " "))
    }
    return U
}

proc n_tokens_remove(this, args) {
    alloc node := tokens_node(this)
    alloc gone := []
    for a in args {
        append(gone, to_str(a))
    }
    alloc out := []
    alloc changed := false
    for w in class_words(node) {
        if has_word(gone, w) {
            changed := true
        } else {
            append(out, w)
        }
    }
    if changed {
        set_attr(node, "class", u.join(out, " "))
    }
    return U
}

proc n_tokens_toggle(this, args) {
    alloc node := tokens_node(this)
    alloc w := to_str(arg(args, 0))
    alloc have := has_word(class_words(node), w)
    alloc want := have == false
    if length(args) > 1 and type_of(args[1]) != 0 {
        want := to_bool(args[1])
    }
    if want and have == false {
        n_tokens_add(this, [w])
    } elif want == false and have {
        n_tokens_remove(this, [w])
    }
    return want
}

proc n_tokens_contains(this, args) {
    return has_word(class_words(tokens_node(this)), to_str(arg(args, 0)))
}

proc n_tokens_replace(this, args) {
    alloc node := tokens_node(this)
    alloc from := to_str(arg(args, 0))
    alloc to := to_str(arg(args, 1))
    alloc out := []
    alloc hit := false
    for w in class_words(node) {
        if w == from {
            hit := true
            if has_word(out, to) == false {
                append(out, to)
            }
        } elif has_word(out, w) == false {
            append(out, w)
        }
    }
    if hit {
        set_attr(node, "class", u.join(out, " "))
    }
    return hit
}

proc n_tokens_item(this, args) {
    alloc list := class_words(tokens_node(this))
    alloc i := to_integer(arg(args, 0))
    if i >= 0.0 and i < float(length(list)) {
        return list[int(i)]
    }
    return 0
}

proc n_tokens_to_string(this, args) {
    return attr_or(tokens_node(this), "class", "")
}

proc n_tokens_for_each(this, args) {
    alloc list := class_words(tokens_node(this))
    alloc i := 0
    loop i < length(list) {
        call(arg(args, 0), arg(args, 1), [list[i], float(i), this])
        i := i + 1
    }
    return U
}

proc n_tokens_values(this, args) {
    alloc list := new_array(class_words(tokens_node(this)))
    return call(get(list, "values"), list, [])
}

proc g_tokens_length(h, id) {
    return float(length(class_words(NODES[id])))
}

proc g_tokens_value(h, id) {
    return attr_or(NODES[id], "class", "")
}

proc s_tokens_value(h, id, v) {
    set_attr(NODES[id], "class", to_str(v))
}

proc tokens_get(h, id, k) {
    alloc i := u.to_int(k, -1)
    if i < 0 {
        return MISS
    }
    alloc list := class_words(NODES[id])
    if i < length(list) {
        return list[i]
    }
    return MISS
}

# --- localStorage and sessionStorage --------------------------------------------------------
#
# Kept while the browser runs, one store for each site; nothing is
# written to the disk.

alloc STORES := {}       # "origin kind" -> [dict]

proc store_of(kind) {
    alloc key := ADDRESS
    alloc p := url.parse(ADDRESS)
    if p != false {
        key := url.origin(p)
    }
    key := key + " " + kind
    if has_key(STORES, key) == false {
        STORES[key] := [{}]
    }
    return STORES[key]
}

proc storage_box(this) {
    if type_of(this) == 2 and this != 0 and H[this][0] == C_STORAGE {
        return H[this][3]
    }
    throw_type("Illegal invocation")
}

proc n_storage_get_item(this, args) {
    alloc box := storage_box(this)
    alloc k := to_str(arg(args, 0))
    if has_key(box[0], k) {
        return box[0][k]
    }
    return 0
}

proc n_storage_set_item(this, args) {
    alloc box := storage_box(this)
    box[0][to_str(arg(args, 0))] := to_str(arg(args, 1))
    return U
}

proc n_storage_remove_item(this, args) {
    alloc box := storage_box(this)
    alloc k := to_str(arg(args, 0))
    if has_key(box[0], k) {
        alloc d := {}
        for name in dict_keys(box[0]) {
            if name != k {
                d[name] := box[0][name]
            }
        }
        box[0] := d
    }
    return U
}

proc n_storage_clear(this, args) {
    alloc box := storage_box(this)
    box[0] := {}
    return U
}

proc n_storage_key(this, args) {
    alloc keys := dict_keys(storage_box(this)[0])
    alloc i := to_integer(arg(args, 0))
    if i >= 0.0 and i < float(length(keys)) {
        return keys[int(i)]
    }
    return 0
}

proc g_storage_length(h, box) {
    return float(length(dict_keys(box[0])))
}

alloc STORAGE_SKIP := {getItem: 1, setItem: 1, removeItem: 1, clear: 1, key: 1, constructor: 1,
                       toString: 1, valueOf: 1, hasOwnProperty: 1, "__proto__": 1}

proc storage_get(h, box, k) {
    if has_key(STORAGE_SKIP, k) == false and has_key(box[0], k) {
        return box[0][k]
    }
    return MISS
}

proc storage_set(h, box, k, v) {
    if has_key(STORAGE_SKIP, k) or is_symbol_name(k) {
        return false
    }
    box[0][k] := to_str(v)
    return true
}

proc storage_keys(h, box) {
    return dict_keys(box[0])
}

# --- what a node can be asked to do ---------------------------------------------------------

# An argument that must be a node.
proc arg_node(args, i, what) {
    alloc v := arg(args, i)
    if is_node(v) {
        return NODES[H[v][3]]
    }
    throw_type("Failed to execute '" + what + "' on 'Node': parameter " + (i + 1) + " is not of type 'Node'.")
}

# For append() and its like: a node as it is, anything else as text.
proc node_or_text(v) {
    if is_node(v) {
        return NODES[H[v][3]]
    }
    return new_text(to_str(v))
}

proc n_append_child(this, args) {
    alloc parent := node_of(this, "appendChild")
    insert_before(parent, arg_node(args, 0, "appendChild"), false)
    return args[0]
}

proc n_insert_before(this, args) {
    alloc parent := node_of(this, "insertBefore")
    alloc node := arg_node(args, 0, "insertBefore")
    alloc ref := false
    if is_node(arg(args, 1)) {
        ref := NODES[H[args[1]][3]]
    }
    insert_before(parent, node, ref)
    return args[0]
}

proc n_remove_child(this, args) {
    alloc parent := node_of(this, "removeChild")
    alloc node := arg_node(args, 0, "removeChild")
    if PARENT[node.nid] != parent.nid {
        dom_error("NotFoundError", "Failed to execute 'removeChild' on 'Node': The node to be removed is not a child of this node.")
    }
    detach(node)
    return args[0]
}

proc n_replace_child(this, args) {
    alloc parent := node_of(this, "replaceChild")
    alloc node := arg_node(args, 0, "replaceChild")
    alloc old := arg_node(args, 1, "replaceChild")
    if PARENT[old.nid] != parent.nid {
        dom_error("NotFoundError", "Failed to execute 'replaceChild' on 'Node': The node to be replaced is not a child of this node.")
    }
    if old.nid != node.nid {
        insert_before(parent, node, old)
        detach(old)
    }
    return args[1]
}

proc n_clone_node(this, args) {
    alloc node := node_of(this, "cloneNode")
    return wrap(copy_node(node, to_bool(arg(args, 0))))
}

proc contains(node, other) {
    alloc id := other.nid
    loop id >= 0 {
        if id == node.nid {
            return true
        }
        id := PARENT[id]
    }
    return false
}

proc n_contains(this, args) {
    alloc node := node_of(this, "contains")
    if is_node(arg(args, 0)) == false {
        return false
    }
    return contains(node, NODES[H[args[0]][3]])
}

proc n_has_child_nodes(this, args) {
    return length(kids_of(node_of(this, "hasChildNodes"))) > 0
}

proc n_remove(this, args) {
    detach(node_of(this, "remove"))
    return U
}

proc n_append(this, args) {
    alloc parent := node_of(this, "append")
    for a in args {
        insert_before(parent, node_or_text(a), false)
    }
    return U
}

proc n_prepend(this, args) {
    alloc parent := node_of(this, "prepend")
    alloc first := false
    if length(parent.kids) > 0 {
        first := parent.kids[0]
    }
    for a in args {
        insert_before(parent, node_or_text(a), first)
    }
    return U
}

proc n_before(this, args) {
    alloc node := node_of(this, "before")
    alloc parent := parent_of(node)
    if parent == false {
        return U
    }
    for a in args {
        insert_before(parent, node_or_text(a), node)
    }
    return U
}

proc n_after(this, args) {
    alloc node := node_of(this, "after")
    alloc parent := parent_of(node)
    if parent == false {
        return U
    }
    alloc ref := sibling(node, 1, false)
    for a in args {
        insert_before(parent, node_or_text(a), ref)
    }
    return U
}

proc n_replace_with(this, args) {
    alloc node := node_of(this, "replaceWith")
    alloc parent := parent_of(node)
    if parent == false {
        return U
    }
    for a in args {
        insert_before(parent, node_or_text(a), node)
    }
    detach(node)
    return U
}

proc n_replace_children(this, args) {
    alloc parent := node_of(this, "replaceChildren")
    remove_all(parent)
    for a in args {
        insert_before(parent, node_or_text(a), false)
    }
    return U
}

proc el_of(this, what) {
    alloc node := node_of(this, what)
    if node.t != 1 {
        throw_type("Failed to execute '" + what + "': the node is not an Element")
    }
    return node
}

proc n_get_attribute(this, args) {
    alloc node := el_of(this, "getAttribute")
    alloc name := u.lower(to_str(arg(args, 0)))
    if has_key(node.attrs, name) {
        return node.attrs[name]
    }
    return 0
}

proc n_set_attribute(this, args) {
    alloc node := el_of(this, "setAttribute")
    set_attr(node, u.lower(to_str(arg(args, 0))), to_str(arg(args, 1)))
    return U
}

proc n_remove_attribute(this, args) {
    alloc node := el_of(this, "removeAttribute")
    remove_attr(node, u.lower(to_str(arg(args, 0))))
    return U
}

proc n_has_attribute(this, args) {
    alloc node := el_of(this, "hasAttribute")
    return has_key(node.attrs, u.lower(to_str(arg(args, 0))))
}

proc n_toggle_attribute(this, args) {
    alloc node := el_of(this, "toggleAttribute")
    alloc name := u.lower(to_str(arg(args, 0)))
    alloc want := has_key(node.attrs, name) == false
    if length(args) > 1 and type_of(args[1]) != 0 {
        want := to_bool(args[1])
    }
    if want {
        if has_key(node.attrs, name) == false {
            set_attr(node, name, "")
        }
    } else {
        remove_attr(node, name)
    }
    return want
}

proc n_get_attribute_names(this, args) {
    return new_array(dict_keys(el_of(this, "getAttributeNames").attrs))
}

proc n_has_attributes(this, args) {
    return length(dict_keys(el_of(this, "hasAttributes").attrs)) > 0
}

proc n_get_attribute_node(this, args) {
    alloc node := el_of(this, "getAttributeNode")
    alloc name := u.lower(to_str(arg(args, 0)))
    if has_key(node.attrs, name) == false {
        return 0
    }
    alloc a := new_object()
    put(a, "name", name)
    put(a, "value", node.attrs[name])
    put(a, "specified", true)
    return a
}

# The same with a namespace in front, which is not looked at.
proc local_name(v) {
    alloc name := to_str(v)
    alloc at := u.find(name, ":")
    if at >= 0 {
        name := name[at + 1:]
    }
    return u.lower(name)
}

proc n_get_attribute_ns(this, args) {
    return n_get_attribute(this, [local_name(arg(args, 1))])
}

proc n_set_attribute_ns(this, args) {
    return n_set_attribute(this, [local_name(arg(args, 1)), arg(args, 2)])
}

proc n_remove_attribute_ns(this, args) {
    return n_remove_attribute(this, [local_name(arg(args, 1))])
}

proc n_has_attribute_ns(this, args) {
    return n_has_attribute(this, [local_name(arg(args, 1))])
}

proc n_query_selector(this, args) {
    alloc node := node_of(this, "querySelector")
    if node.t == 3 or node.t == 8 {
        return 0
    }
    alloc found := query(node, to_str(arg(args, 0)), true)
    if length(found) == 0 {
        return 0
    }
    return wrap(found[0])
}

proc n_query_selector_all(this, args) {
    alloc node := node_of(this, "querySelectorAll")
    if node.t == 3 or node.t == 8 {
        return wrap_list([])
