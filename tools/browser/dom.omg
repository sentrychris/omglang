}

proc n_request_submit(this, args) {
    alloc node := el_of(this, "requestSubmit")
    if fire(node.nid, "submit", true, true, {}, "Event") {
        if has_key(HOST, "submit") {
            HOST["submit"](node)
        }
    }
    return U
}

proc n_reset(this, args) {
    alloc node := el_of(this, "reset")
    for ctl in controls_in(node, []) {
        if has_key(ctl, "value") {
            ctl.value := attr_or(ctl, "value", "")
            if ctl.tag == "textarea" {
                ctl.value := html.text_of(ctl)
            }
            ctl.caret := 0
        }
        if has_key(ctl, "checked") {
            ctl.checked := has_key(ctl.attrs, "checked")
        }
        if has_key(ctl, "sel") {
            ctl.sel := 100000
        }
    }
    DIRTY := true
    return U
}

# Where two nodes stand to each other, as compareDocumentPosition
# counts: 1 apart, 2 other first, 4 other after, 8 other holds this,
# 16 this holds other.
proc n_compare_document_position(this, args) {
    alloc a := node_of(this, "compareDocumentPosition")
    alloc b := arg_node(args, 0, "compareDocumentPosition")
    if a.nid == b.nid {
        return 0.0
    }
    alloc pa := []
    alloc id := a.nid
    loop id >= 0 {
        append(pa, id)
        id := PARENT[id]
    }
    alloc pb := []
    id := b.nid
    loop id >= 0 {
        append(pb, id)
        id := PARENT[id]
    }
    alloc i := length(pa) - 1
    alloc j := length(pb) - 1
    if pa[i] != pb[j] {
        return 35.0
    }
    loop i >= 0 and j >= 0 and pa[i] == pb[j] {
        i := i - 1
        j := j - 1
    }
    if i < 0 {
        return 20.0
    }
    if j < 0 {
        return 10.0
    }
    alloc common := NODES[pa[i + 1]]
    alloc ia := index_in(common, NODES[pa[i]])
    alloc ib := index_in(common, NODES[pb[j]])
    if ia < ib {
        return 4.0
    }
    return 2.0
}

proc n_get_root_node(this, args) {
    alloc node := node_of(this, "getRootNode")
    alloc id := node.nid
    loop PARENT[id] >= 0 {
        id := PARENT[id]
    }
    return wrap(NODES[id])
}

proc n_is_same_node(this, args) {
    return is_node(arg(args, 0)) and H[args[0]][3] == node_of(this, "isSameNode").nid
}

proc n_is_equal_node(this, args) {
    alloc a := node_of(this, "isEqualNode")
    if is_node(arg(args, 0)) == false {
        return false
    }
    alloc b := NODES[H[args[0]][3]]
    return a.t == b.t and html.outer_html(a) == html.outer_html(b)
}

proc n_normalize(this, args) {
    alloc node := node_of(this, "normalize")
    if node.t == 3 or node.t == 8 {
        return U
    }
    alloc out := []
    alloc last := false
    for k in node.kids {
        if k.t == 3 {
            if k.text == "" {
                PARENT[k.nid] := -1
            } elif last != false {
                last.text := last.text + k.text
                PARENT[k.nid] := -1
            } else {
                last := k
                append(out, k)
            }
        } else {
            last := false
            append(out, k)
            if k.t == 1 {
                n_normalize(wrap(k), [])
            }
        }
    }
    node.kids := out
    touched(node)
    return U
}

proc n_split_text(this, args) {
    alloc node := node_of(this, "splitText")
    if node.t != 3 {
        throw_type("Failed to execute 'splitText': the node is not a Text")
    }
    alloc cps := u.cps(node.text)
    alloc at := int(to_integer(arg(args, 0)))
    if at < 0 or at > length(cps) {
        dom_error("IndexSizeError", "The offset is larger than the text's length.")
    }
    alloc rest := new_text(u.encode_range(cps, at, length(cps)))
    node.text := u.encode_range(cps, 0, at)
    alloc parent := parent_of(node)
    if parent != false {
        insert_before(parent, rest, sibling(node, 1, false))
    }
    DIRTY := true
    return wrap(rest)
}

proc n_append_data(this, args) {
    alloc node := node_of(this, "appendData")
    if node.t == 3 or node.t == 8 {
        set_text_content(node, node.text + to_str(arg(args, 0)))
    }
    return U
}

proc n_node_to_string(this, args) {
    if is_node(this) {
        alloc node := NODES[H[this][3]]
        if node.t == 1 and (node.tag == "a" or node.tag == "area") {
            return reflect_get(node, REFLECT["href"])
        }
        return "[object " + to_str(get(get(this, "constructor"), "name")) + "]"
    }
    return "[object Object]"
}

proc n_get_context(this, args) {
    return 0
}

proc n_play(this, args) {
    return promise.to_promise(U)
}

# -- the document's own

proc n_create_element(this, args) {
    alloc name := u.lower(to_str(arg(args, 0)))
    if name == "" {
        dom_error("InvalidCharacterError", "The tag name provided ('') is not a valid name.")
    }
    return wrap(new_element(name))
}

proc n_create_element_ns(this, args) {
    return wrap(new_element(local_name(arg(args, 1))))
}

proc n_create_text_node(this, args) {
    return wrap(new_text(to_str(arg(args, 0))))
}

proc n_create_comment(this, args) {
    alloc node := {t: 8, text: to_str(arg(args, 0)), kids: []}
    register(node, -1)
    return wrap(node)
}

proc new_fragment() {
    alloc node := {t: 11, kids: []}
    register(node, -1)
    return node
}

proc n_create_document_fragment(this, args) {
    return wrap(new_fragment())
}

proc n_get_elements_by_name(this, args) {
    alloc want := to_str(arg(args, 0))
    alloc out := []
    for el in collect(DOC, "*", [], []) {
        if has_key(el.attrs, "name") and el.attrs["name"] == want {
            append(out, el)
        }
    }
    return wrap_list(out)
}

# document.write(): what is written goes where the script that
# writes it stands, or at the end of the body.
proc n_write(this, args) {
    alloc text := ""
    for a in args {
        text := text + to_str(a)
    }
    alloc parent := DOC.body
    alloc ref := false
    if CURRENT_SCRIPT != false and PARENT[CURRENT_SCRIPT.nid] >= 0 {
        parent := parent_of(CURRENT_SCRIPT)
        if has_key(CURRENT_SCRIPT, "wrote") == false {
            CURRENT_SCRIPT.wrote := sibling(CURRENT_SCRIPT, 1, false)
        }
        ref := CURRENT_SCRIPT.wrote
        if ref != false and PARENT[ref.nid] != parent.nid {
            ref := false
        }
        if parent.t != 1 or parent.tag == "head" or parent.tag == "html" {
            parent := DOC.body
            ref := false
        }
    }
    if parent == false {
        return U
    }
    for n in fragment_nodes(text, parent.tag) {
        insert_before(parent, n, ref)
    }
    return U
}

proc n_import_node(this, args) {
    return wrap(copy_node(arg_node(args, 0, "importNode"), to_bool(arg(args, 1))))
}

proc n_adopt_node(this, args) {
    detach(arg_node(args, 0, "adoptNode"))
    return args[0]
}

proc n_element_from_point(this, args) {
    if has_key(HOST, "hit") {
        return wrap(HOST["hit"](int(to_integer(arg(args, 0))), int(to_integer(arg(args, 1)))))
    }
    return 0
}

proc n_range_fragment(this, args) {
    alloc frag := new_fragment()
    for n in fragment_nodes(to_str(arg(args, 0)), "div") {
        insert_before(frag, n, false)
    }
    return wrap(frag)
}

proc n_create_range(this, args) {
    alloc r := new_object()
    for name in ["setStart", "setEnd", "setStartBefore", "setEndAfter", "collapse", "selectNode", "selectNodeContents", "detach", "deleteContents", "insertNode"] {
        def(r, name, n_nothing, 0)
    }
    def(r, "createContextualFragment", n_range_fragment, 1)
    def(r, "getBoundingClientRect", n_zero_rect, 0)
    def(r, "getClientRects", n_empty_array, 0)
    put(r, "collapsed", true)
    return r
}

proc n_zero_rect(this, args) {
    return new_rect(0, 0, 0, 0)
}

proc n_get_selection(this, args) {
    alloc s := new_object()
    for name in ["removeAllRanges", "addRange", "collapse", "empty", "selectAllChildren"] {
        def(s, name, n_nothing, 0)
    }
    def(s, "toString", n_empty_string, 0)
    put(s, "rangeCount", 0.0)
    put(s, "isCollapsed", true)
    put(s, "anchorNode", 0)
    put(s, "focusNode", 0)
    return s
}

proc n_empty_string(this, args) {
    return ""
}

# The content of a <template>: its children are moved into a fragment
# of their own, where no query and no script that walks the tree finds
# them.
proc template_content(node) {
    if has_key(node, "content") == false {
        alloc frag := new_fragment()
        alloc moving := node.kids
        node.kids := []
        for k in moving {
            PARENT[k.nid] := frag.nid
            append(frag.kids, k)
        }
        node.content := frag.nid
        node.frag := frag
        touched(node)
    }
    return NODES[node.content]
}

# --- events ---------------------------------------------------------------------------------
#
# An event is an object of class 38 whose payload is
# [0 name, 1 bubbles?, 2 can be cancelled?, 3 cancelled?, 4 stopped
# (1 after this target, 2 at once), 5 target, 6 the target being told
# now, 7 phase, 8 time, 9 on its way?, 10 made by the browser?].
# Anything else an event carries (clientX, key, detail) is an ordinary
# property.
#
# Anything can be listened to: a node has its number, and any other
# object is given one the first time, kept in a property scripts
# cannot reach.

proc new_event(name, bubbles, cancelable, kind) {
    alloc proto := P["Event"]
    if has_key(P, kind) {
        proto := P[kind]
    }
    alloc h := new_obj(C_EVENT, proto)
    H[h][3] := [name, bubbles, cancelable, false, 0, 0, 0, 0, time_ms() * 1.0 - START, false, false]
    return h
}

proc event_x(this) {
    if type_of(this) == 2 and this != 0 and H[this][0] == C_EVENT {
        return H[this][3]
    }
    throw_type("Illegal invocation")
}

proc g_ev_type(h, x) {
    return x[0]
}

proc g_ev_bubbles(h, x) {
    return x[1]
}

proc g_ev_cancelable(h, x) {
    return x[2]
}

proc g_ev_default_prevented(h, x) {
    return x[3]
}

proc g_ev_target(h, x) {
    return x[5]
}

proc g_ev_current_target(h, x) {
    return x[6]
}

proc g_ev_phase(h, x) {
    return float(x[7])
}

proc g_ev_time(h, x) {
    return x[8]
}

proc g_ev_trusted(h, x) {
    return x[10]
}

proc g_ev_cancel_bubble(h, x) {
    return x[4] != 0
}

proc s_ev_cancel_bubble(h, x, v) {
    if to_bool(v) and x[4] == 0 {
        x[4] := 1
    }
}

proc g_ev_return_value(h, x) {
    return x[3] == false
}

proc s_ev_return_value(h, x, v) {
    if to_bool(v) == false and x[2] {
        x[3] := true
    }
}

proc n_prevent_default(this, args) {
    alloc x := event_x(this)
    if x[2] {
        x[3] := true
    }
    return U
}

proc n_stop_propagation(this, args) {
    alloc x := event_x(this)
    if x[4] == 0 {
        x[4] := 1
    }
    return U
}

proc n_stop_immediate_propagation(this, args) {
    alloc x := event_x(this)
    x[4] := 2
    return U
}

proc n_composed_path(this, args) {
    alloc x := event_x(this)
    if x[5] == 0 {
        return new_array([])
    }
    alloc out := [x[5]]
    if is_node(x[5]) {
        alloc id := PARENT[H[x[5]][3]]
        loop id >= 0 {
            append(out, wrap(NODES[id]))
            id := PARENT[id]
        }
        append(out, I[0])
    }
    return new_array(out)
}

proc n_init_event(this, args) {
    alloc x := event_x(this)
    x[0] := to_str(arg(args, 0))
    x[1] := to_bool(arg(args, 1))
    x[2] := to_bool(arg(args, 2))
    if length(args) > 3 {
        put(this, "detail", args[3])
    }
    return U
}

# Copy what a script gave as the second argument of new Event().
proc init_event(h, init) {
    if X["is_obj"](init) == false {
        return true
    }
    alloc x := H[h][3]
    for k in own_keys(init, false) {
        alloc v := get(init, k)
        if k == "bubbles" {
            x[1] := to_bool(v)
        } elif k == "cancelable" {
            x[2] := to_bool(v)
        } else {
            put(h, k, v)
        }
    }
    return true
}

alloc EVENT_DEFAULTS := {
    CustomEvent: {detail: 0},
    MouseEvent: {clientX: 0.0, clientY: 0.0, pageX: 0.0, pageY: 0.0, screenX: 0.0, screenY: 0.0, offsetX: 0.0, offsetY: 0.0, button: 0.0, buttons: 0.0, detail: 0.0, altKey: false, ctrlKey: false, shiftKey: false, metaKey: false, relatedTarget: 0, which: 1.0},
    KeyboardEvent: {key: "", code: "", keyCode: 0.0, which: 0.0, charCode: 0.0, altKey: false, ctrlKey: false, shiftKey: false, metaKey: false, repeat: false, isComposing: false, location: 0.0},
    UIEvent: {detail: 0.0},
    FocusEvent: {relatedTarget: 0},
    InputEvent: {data: 0, inputType: "", isComposing: false},
    WheelEvent: {deltaX: 0.0, deltaY: 0.0, deltaZ: 0.0, deltaMode: 0.0, clientX: 0.0, clientY: 0.0},
    PointerEvent: {clientX: 0.0, clientY: 0.0, pageX: 0.0, pageY: 0.0, button: 0.0, buttons: 0.0, pointerId: 1.0, pointerType: "mouse", isPrimary: true, altKey: false, ctrlKey: false, shiftKey: false, metaKey: false},
    ErrorEvent: {message: "", filename: "", lineno: 0.0, colno: 0.0, error: 0},
    MessageEvent: {data: 0, origin: "", source: 0},
    HashChangeEvent: {oldURL: "", newURL: ""},
    PopStateEvent: {state: 0},
    ProgressEvent: {lengthComputable: false, loaded: 0.0, total: 0.0},
    StorageEvent: {key: 0, oldValue: 0, newValue: 0},
    TransitionEvent: {propertyName: "", elapsedTime: 0.0},
    AnimationEvent: {animationName: "", elapsedTime: 0.0},
    TouchEvent: {},
    SubmitEvent: {submitter: 0},
    Event: {}
}

proc set_event_defaults(h, kind) {
    if has_key(EVENT_DEFAULTS, kind) {
        alloc d := EVENT_DEFAULTS[kind]
        for k in dict_keys(d) {
            put(h, k, d[k])
        }
    }
    return true
}

proc n_event_ctor(this, args) {
    alloc kind := native_data()
    if type_of(new_target()) == 0 {
        throw_type("Failed to construct '" + kind + "': Please use the 'new' operator.")
    }
    if length(args) == 0 {
        throw_type("Failed to construct '" + kind + "': 1 argument required, but only 0 present.")
    }
    alloc h := new_event(to_str(args[0]), false, false, kind)
    set_event_defaults(h, kind)
    init_event(h, arg(args, 1))
    return h
}

proc n_create_event(this, args) {
    alloc kind := to_str(arg(args, 0))
    if kind == "HTMLEvents" or kind == "Events" {
        kind := "Event"
    } elif kind == "MouseEvents" {
        kind := "MouseEvent"
    } elif kind == "UIEvents" {
        kind := "UIEvent"
    } elif kind == "KeyEvents" or kind == "KeyboardEvents" {
        kind := "KeyboardEvent"
    }
    alloc h := new_event("", false, false, kind)
    set_event_defaults(h, kind)
    return h
}

# The number of anything that can be listened to.
proc target_nid(v) {
    if type_of(v) != 2 or v == 0 or v == I[0] {
        return 0
    }
    alloc o := H[v]
    if o[0] == 32 {
        return o[3]
    }
    if has_key(o[2], "@@target") {
        return int(o[2]["@@target"])
    }
    alloc id := register({t: 0, kids: []}, -1)
    WRAP[id] := v
    define_hidden(v, "@@target", float(id))
    return id
}

proc target_object(id) {
    if id == 0 {
        return I[0]
    }
    alloc h := WRAP[id]
    if h != 0 {
        return h
    }
    return wrap(NODES[id])
}

proc n_add_event_listener(this, args) {
    alloc id := target_nid(this)
    alloc name := to_str(arg(args, 0))
    alloc fn := arg(args, 1)
    if type_of(fn) != 2 or fn == 0 {
        return U
    }
    alloc capture := false
    alloc once := false
    alloc opts := arg(args, 2)
    if type_of(opts) == 2 and opts != 0 {
        capture := to_bool(get(opts, "capture"))
        once := to_bool(get(opts, "once"))
    } else {
        capture := to_bool(opts)
    }
    if LIS[id] == false {
        LIS[id] := {}
    }
    alloc d := LIS[id]
    if has_key(d, name) == false {
        d[name] := []
    }
    for l in d[name] {
        if l[3] and l[0] == fn and l[1] == capture {
            return U
        }
    }
    append(d[name], [fn, capture, once, true])
    return U
}

proc n_remove_event_listener(this, args) {
    alloc id := target_nid(this)
    alloc name := to_str(arg(args, 0))
    alloc fn := arg(args, 1)
    alloc capture := false
    alloc opts := arg(args, 2)
    if type_of(opts) == 2 and opts != 0 {
        capture := to_bool(get(opts, "capture"))
    } else {
        capture := to_bool(opts)
    }
    alloc d := LIS[id]
    if d == false or has_key(d, name) == false {
        return U
    }
    alloc keep := []
    for l in d[name] {
        if l[3] and l[0] == fn and l[1] == capture {
            l[3] := false
        } elif l[3] {
            append(keep, l)
        }
    }
    d[name] := keep
    return U
}

# The function in on<name>: a property a script set, or an
# attribute of the element (onclick="..."), made into a function the
# first time. 0 when there is none.
proc on_handler(id, name) {
    alloc key := "on" + name
    alloc h := 0
    if id == 0 {
        h := I[0]
    } else {
        h := WRAP[id]
    }
    if h != 0 {
        alloc v := get(h, key)
        if is_callable(v) {
            return v
        }
    }
    alloc node := NODES[id]
    if id == 0 and DOC != false and type_of(DOC.body) == 6 {
        # <body onload=""> speaks for the window
        if name == "load" or name == "resize" or name == "scroll" or name == "hashchange" or name == "popstate" or name == "beforeunload" or name == "unload" {
            node := DOC.body
        }
    }
    if node.t == 1 and has_key(node.attrs, key) {
        if has_key(node, "badon") and has_key(node.badon, key) {
            return 0
        }
        alloc fn := 0
        try {
            fn := js.make_function("event", node.attrs[key])
        } except e {
            promise.report(caught(e))
            if has_key(node, "badon") == false {
                node.badon := {}
            }
            node.badon[key] := true
            return 0
        }
        if id == 0 {
            put(I[0], key, fn)
        } else {
            put(wrap(node), key, fn)
        }
        return fn
    }
    return 0
}

proc call_listener(fn, target, ev) {
    try {
        if is_callable(fn) {
            return call(fn, target, [ev])
        }
        alloc he := get(fn, "handleEvent")
        if is_callable(he) {
            return call(he, fn, [ev])
        }
    } except e {
        promise.report(caught(e))
    }
    return U
}

proc run_listeners(id, ev, x, phase) {
    alloc d := LIS[id]
    alloc name := x[0]
    alloc handler := 0
    if phase != 1 {
        handler := on_handler(id, name)
    }
    alloc listed := d != false and has_key(d, name)
    if handler == 0 and listed == false {
        return true
    }
    alloc target := target_object(id)
    x[6] := target
    x[7] := phase
    if handler != 0 {
        alloc r := call_listener(handler, target, ev)
        if type_of(r) == 1 and r == false and x[2] {
            x[3] := true
        }
        if x[4] == 2 {
            return true
        }
    }
    if listed {
        alloc list := d[name]
        alloc n := length(list)
        alloc i := 0
        loop i < n {
            alloc l := list[i]
            i := i + 1
            if l[3] == false {
                continue
            }
            if (phase == 1 and l[1] == false) or (phase == 3 and l[1]) {
                continue
            }
            if l[2] {
                l[3] := false
            }
            call_listener(l[0], target, ev)
            if x[4] == 2 {
                break
            }
        }
    }
    return true
}

# Send event `ev` to the target with number `id`: down from the
# window, to the target, and back up when the event bubbles. True
# when nobody cancelled it.
proc dispatch(id, ev) {
    alloc x := H[ev][3]
    x[9] := true
    x[3] := false
    x[4] := 0
    x[5] := target_object(id)
    alloc path := [id]
    if id != 0 and NODES[id].t != 0 {
        alloc p := PARENT[id]
        loop p >= 0 {
            append(path, p)
            p := PARENT[p]
        }
        if path[length(path) - 1] == DOC_NID and x[0] != "load" {
            append(path, 0)
        }
    }
    alloc n := length(path)
    alloc i := n - 1
    loop i >= 1 and x[4] == 0 {
        run_listeners(path[i], ev, x, 1)
        i := i - 1
    }
    if x[4] == 0 {
        run_listeners(path[0], ev, x, 2)
    }
    if x[1] {
        i := 1
        loop i < n and x[4] == 0 {
            run_listeners(path[i], ev, x, 3)
            i := i + 1
        }
    }
    x[9] := false
    x[7] := 0
    x[6] := 0
    return x[3] == false
}

proc n_dispatch_event(this, args) {
    alloc ev := arg(args, 0)
    if type_of(ev) != 2 or ev == 0 or H[ev][0] != C_EVENT {
        throw_type("Failed to execute 'dispatchEvent' on 'EventTarget': parameter 1 is not of type 'Event'.")
    }
    return dispatch(target_nid(this), ev)
}

# Make an event and send it. `props` is an OMG dict of what else it
# carries. True when nobody cancelled it.
proc fire(id, name, bubbles, cancelable, props, kind) {
    alloc ev := new_event(name, bubbles, cancelable, kind)
    set_event_defaults(ev, kind)
    for k in dict_keys(props) {
        put(ev, k, props[k])
    }
    H[ev][3][10] := true
    return dispatch(id, ev)
}

# --- the document's properties --------------------------------------------------------------

proc g_document_element(h, node) {
    if has_key(node, "root") {
        return wrap(node.root)
    }
    return 0
}

proc g_head(h, node) {
    return wrap(node.head)
}

proc g_body(h, node) {
    return wrap(node.body)
}

proc title_node() {
    if type_of(DOC.head) != 6 {
        return false
    }
    for k in DOC.head.kids {
        if k.t == 1 and k.tag == "title" {
            return k
        }
    }
    return false
}

proc g_title(h, node) {
    alloc t := title_node()
    if t == false {
        return ""
    }
    return u.join(u.words(html.text_of(t)), " ")
}

proc s_title(h, node, v) {
    alloc t := title_node()
    if t == false {
        if type_of(DOC.head) != 6 {
            return true
        }
        t := new_element("title")
        insert_before(DOC.head, t, false)
    }
    set_text_content(t, to_str(v))
    if has_key(HOST, "title") {
        HOST["title"](to_str(v))
    }
}

proc g_cookie(h, node) {
    if has_key(HOST, "cookie_get") {
        return HOST["cookie_get"]()
    }
    return ""
}

proc s_cookie(h, node, v) {
    if has_key(HOST, "cookie_set") {
        HOST["cookie_set"](to_str(v))
    }
}

proc g_ready_state(h, node) {
    return READY
}

proc g_doc_url(h, node) {
    return ADDRESS
}

proc g_doc_location(h, node) {
    return LOCATION
}

proc s_doc_location(h, node, v) {
    navigate(to_str(v), false)
}

proc g_default_view(h, node) {
    return I[0]
}

proc g_active_element(h, node) {
    if FOCUS != false {
        return wrap(FOCUS)
    }
    return wrap(DOC.body)
}

proc g_current_script(h, node) {
    return wrap(CURRENT_SCRIPT)
}

proc g_forms(h, node) {
    return wrap_list(collect(DOC, "form", [], []))
}

proc g_images(h, node) {
    return wrap_list(collect(DOC, "img", [], []))
}

proc g_scripts(h, node) {
    return wrap_list(collect(DOC, "script", [], []))
}

proc g_links(h, node) {
    alloc out := []
    for a in collect(DOC, "a", [], []) {
        if has_key(a.attrs, "href") {
            append(out, a)
        }
    }
    return wrap_list(out)
}

proc g_charset(h, node) {
    return "UTF-8"
}

proc g_compat_mode(h, node) {
    if has_key(node, "quirks") and node.quirks {
        return "BackCompat"
    }
    return "CSS1Compat"
}

proc g_content_type(h, node) {
    return "text/html"
}

proc g_doctype(h, node) {
    if has_key(node, "quirks") and node.quirks {
        return 0
    }
    alloc o := new_object()
    put(o, "name", "html")
    put(o, "publicId", "")
    put(o, "systemId", "")
    put(o, "nodeType", 10.0)
    return o
}

proc g_empty_text(h, node) {
    return ""
}

proc g_domain(h, node) {
    alloc p := url.parse(ADDRESS)
    if p == false {
        return ""
    }
    return p.host
}

proc g_doc_hidden(h, node) {
    return false
}

proc g_visibility_state(h, node) {
    return "visible"
}

# --- style.sheet: rules added one at a time -------------------------------------------------
#
# Libraries that write CSS from scripts (styled-components, emotion)
# do not set the text of a <style>: they call sheet.insertRule() for
# each rule. The rules added that way are kept on the element, in
# node.rules, and the browser reads them after the element's text.
# cssRules shows those rules only, not the ones in the text.

proc sheet_of(node) {
    alloc key := "" + node.nid
    if has_key(SHEET_OBJ, key) {
        return SHEET_OBJ[key]
    }
    alloc h := new_obj(0, P["CSSStyleSheet"])
    define_hidden(h, "@@node", node.nid * 1.0)
    SHEET_OBJ[key] := h
    return h
}

proc sheet_node(this) {
    alloc id := U
    if type_of(this) == 2 and this != 0 {
        id := get(this, "@@node")
    }
    if type_of(id) != 3 {
        throw_type("Illegal invocation")
    }
    alloc node := NODES[int(id)]
    if has_key(node, "rules") == false {
        node.rules := []
    }
    return node
}

proc g_sheet(h, node) {
    if node.tag == "style" {
        return sheet_of(node)
    }
    return 0
}

proc g_style_sheets(h, node) {
    alloc out := []
    for el in collect(node, "style", [], []) {
        append(out, sheet_of(el))
    }
    return new_array(out)
}

proc n_insert_rule(this, args) {
    alloc node := sheet_node(this)
    alloc text := to_str(arg(args, 0))
    alloc n := length(node.rules)
    alloc at := 0
    if type_of(arg(args, 1)) != 0 {
        at := int(to_integer(args[1]))
    }
    if at < 0 or at > n {
        throw_val(dom_error("IndexSizeError", "The index provided (" + at + ") is larger than the maximum index (" + n + ")."))
    }
    if u.find(text, "{") <= 0 or u.find(text, "}") < 0 {
        throw_val(dom_error("SyntaxError", "Failed to parse the rule '" + text + "'."))
    }
    node.rules := node.rules[0:at] + [text] + node.rules[at:]
    SHEETS := true
    DIRTY := true
    return at * 1.0
}

proc n_delete_rule(this, args) {
    alloc node := sheet_node(this)
    alloc at := int(to_integer(arg(args, 0)))
    if at < 0 or at >= length(node.rules) {
        throw_val(dom_error("IndexSizeError", "The index provided (" + at + ") is larger than the maximum index."))
    }
    node.rules := node.rules[0:at] + node.rules[at + 1:]
    SHEETS := true
    DIRTY := true
    return U
}

proc n_css_rules(this, args) {
    alloc node := sheet_node(this)
    alloc out := []
    for text in node.rules {
        alloc r := X["new_object"]()
        put(r, "cssText", text)
        alloc brace := u.find(text, "{")
        if brace > 0 {
            put(r, "selectorText", u.trim(text[0:brace]))
        }
        put(r, "type", 1.0)
        put(r, "parentStyleSheet", this)
        append(out, r)
    }
    return new_array(out)
}

proc n_owner_node(this, args) {
    return wrap(sheet_node(this))
}

proc g_null(h, node) {
    return 0
}

proc g_design_mode(h, node) {
    return "off"
}

# --- going places ---------------------------------------------------------------------------

# Go to `where` (as written in the page). Another part of the same
# page is a matter of scrolling; anything else is for the browser,
# once the script that asked has returned.
proc navigate(where, replace) {
    alloc target := url.resolve(BASE, where)
    if target == "" {
        return false
    }
    if url.without_frag(target) == url.without_frag(ADDRESS) and u.contains(target, "#") {
        alloc old := ADDRESS
        if target != old {
            ADDRESS := target
            if has_key(HOST, "fragment") {
                HOST["fragment"](target, replace)
            }
            append(TASKS, [4, old, target])
        }
        return true
    }
    if has_key(HOST, "navigate") {
        HOST["navigate"](target, replace)
    }
    return true
}

proc here() {
    alloc p := url.parse(ADDRESS)
    if p == false {
        return {scheme: "about", host: "", port: 0, path: "blank", query: "", frag: ""}
    }
    return p
}

proc g_loc_href(h, x) {
    return ADDRESS
}

proc s_loc_href(h, x, v) {
    navigate(to_str(v), false)
}

proc g_loc_protocol(h, x) {
    return here().scheme + ":"
}

proc g_loc_host(h, x) {
    return host_text(here())
}

proc g_loc_hostname(h, x) {
    return here().host
}

proc g_loc_port(h, x) {
    alloc p := here()
    if p.port == 0 {
        return ""
    }
    return "" + p.port
}

proc g_loc_pathname(h, x) {
    return here().path
}

proc s_loc_pathname(h, x, v) {
    alloc p := here()
    p.path := to_str(v)
    navigate(url.to_string(p), false)
}

proc g_loc_search(h, x) {
    alloc q := here().query
    if q == "?" {
        return ""
    }
    return q
}

proc s_loc_search(h, x, v) {
    alloc p := here()
    alloc q := to_str(v)
    if q != "" and u.starts_with(q, "?") == false {
        q := "?" + q
    }
    p.query := q
    navigate(url.to_string(p), false)
}

proc g_loc_hash(h, x) {
    alloc f := here().frag
    if f == "#" {
        return ""
    }
    return f
}

proc s_loc_hash(h, x, v) {
    alloc f := to_str(v)
    if u.starts_with(f, "#") == false {
        f := "#" + f
    }
    navigate(url.without_frag(ADDRESS) + f, false)
}

proc g_loc_origin(h, x) {
    alloc p := here()
    if p.scheme != "http" and p.scheme != "https" {
        return "null"
    }
    return url.origin(p)
}

proc n_loc_assign(this, args) {
    navigate(to_str(arg(args, 0)), false)
    return U
}

proc n_loc_replace(this, args) {
    navigate(to_str(arg(args, 0)), true)
    return U
}

proc n_loc_reload(this, args) {
    if has_key(HOST, "navigate") {
        HOST["navigate"](ADDRESS, true)
    }
    return U
}

proc n_loc_to_string(this, args) {
    return ADDRESS
}

# -- history

alloc HIST := []         # the entries pushState made: [address, state]
alloc HIST_AT := 0

proc g_hist_length(h, x) {
    if has_key(HOST, "history_length") {
        return float(HOST["history_length"]())
    }
    return float(length(HIST))
}

proc g_hist_state(h, x) {
    if HIST_AT < length(HIST) {
        return HIST[HIST_AT][1]
    }
    return 0
}

proc g_hist_scroll(h, x) {
    return "auto"
}

proc push_state(args, replace) {
    alloc state := arg(args, 0)
    if type_of(state) == 0 {
        state := 0
    }
    alloc target := ADDRESS
    if length(args) > 2 and is_nullish(args[2]) == false {
        target := url.resolve(BASE, to_str(args[2]))
        if target == "" {
            target := ADDRESS
        }
    }
    if replace {
        HIST[HIST_AT] := [target, state]
    } else {
        HIST := HIST[0:HIST_AT + 1]
        append(HIST, [target, state])
        HIST_AT := length(HIST) - 1
    }
    ADDRESS := target
    if has_key(HOST, "push_state") {
        HOST["push_state"](target, replace)
    }
    return U
}

proc n_push_state(this, args) {
    return push_state(args, false)
}

proc n_replace_state(this, args) {
    return push_state(args, true)
}

proc n_hist_go(this, args) {
    alloc d := int(to_integer(arg(args, 0)))
    if has_key(HOST, "history") {
        HOST["history"](d)
    }
    return U
}

proc n_hist_back(this, args) {
    return n_hist_go(this, [-1.0])
}

proc n_hist_forward(this, args) {
    return n_hist_go(this, [1.0])
}

# The browser is going `step` entries along its history to `address`.
# True when that is a place this page made with pushState, and so a
# matter for the page (a popstate event) and not a new page.
proc history_step(step, address) {
    alloc to := HIST_AT + step
    if to < 0 or to >= length(HIST) or HIST[to][0] != address {
        return false
    }
    HIST_AT := to
    ADDRESS := address
    fire(0, "popstate", false, false, {state: HIST[to][1]}, "PopStateEvent")
    promise.run_microtasks()
    return true
}

# --- URL and URLSearchParams (and Headers and FormData, which are also lists of pairs) -------
#
# The payload of the three: [pairs, the URL object they belong to or
# 0, names in lower case?].

proc url_x(this) {
    if type_of(this) == 2 and this != 0 and H[this][0] == C_URL {
        return H[this][3]
    }
    throw_type("Illegal invocation")
}

proc url_parts(x) {
    alloc p := url.parse(x[0])
    if p == false {
        return {scheme: "about", host: "", port: 0, path: "blank", query: "", frag: ""}
    }
    return p
}

proc n_url_ctor(this, args) {
    if type_of(new_target()) == 0 {
        throw_type("Failed to construct 'URL': Please use the 'new' operator.")
    }
    alloc text := to_str(arg(args, 0))
    alloc whole := ""
    if length(args) > 1 and type_of(args[1]) != 0 {
        whole := url.resolve(to_str(args[1]), text)
    } elif url.scheme_len(u.trim(text)) > 0 {
        whole := url.resolve("about:blank", text)
    }
    if whole == "" or url.parse(whole) == false {
        throw_type("Failed to construct 'URL': Invalid URL")
    }
    alloc h := new_obj(C_URL, P["URL"])
    H[h][3] := [whole]
    return h
}

proc n_url_can_parse(this, args) {
    alloc text := to_str(arg(args, 0))
    alloc whole := ""
    if length(args) > 1 and type_of(args[1]) != 0 {
        whole := url.resolve(to_str(args[1]), text)
    } elif url.scheme_len(u.trim(text)) > 0 {
        whole := url.resolve("about:blank", text)
    }
    return whole != "" and url.parse(whole) != false
}

proc g_url_href(h, x) {
    return x[0]
}

proc s_url_href(h, x, v) {
    alloc whole := url.resolve("about:blank", to_str(v))
    if whole != "" {
        x[0] := whole
    }
}

proc g_url_protocol(h, x) {
    return url_parts(x).scheme + ":"
}

proc g_url_host(h, x) {
    return host_text(url_parts(x))
}

proc g_url_hostname(h, x) {
    return url_parts(x).host
}

proc g_url_port(h, x) {
    alloc p := url_parts(x)
    if p.port == 0 {
        return ""
    }
    return "" + p.port
}

proc g_url_pathname(h, x) {
    return url_parts(x).path
}

proc s_url_pathname(h, x, v) {
    alloc p := url_parts(x)
    p.path := to_str(v)
    x[0] := url.to_string(p)
}

proc g_url_search(h, x) {
    alloc q := url_parts(x).query
    if q == "?" {
        return ""
    }
    return q
}

proc s_url_search(h, x, v) {
    alloc p := url_parts(x)
    alloc q := to_str(v)
    if q != "" and u.starts_with(q, "?") == false {
        q := "?" + q
    }
    p.query := q
    x[0] := url.to_string(p)
}

proc g_url_hash(h, x) {
    alloc f := url_parts(x).frag
    if f == "#" {
        return ""
    }
    return f
}

proc s_url_hash(h, x, v) {
    alloc p := url_parts(x)
    alloc f := to_str(v)
    if f != "" and u.starts_with(f, "#") == false {
        f := "#" + f
    }
    p.frag := f
    x[0] := url.to_string(p)
}

proc g_url_origin(h, x) {
    alloc p := url_parts(x)
    if p.scheme != "http" and p.scheme != "https" {
        return "null"
    }
    return url.origin(p)
}

proc query_pairs(text) {
    alloc out := []
    if u.starts_with(text, "?") {
        text := text[1:]
    }
    if text == "" {
        return out
    }
    for part in u.split(text, "&") {
        if part == "" {
            continue
        }
        alloc at := u.find(part, "=")
        alloc k := part
        alloc v := ""
        if at >= 0 {
            k := part[0:at]
            v := part[at + 1:]
        }
        append(out, [bytes_to_string(url.unescape_bytes(u.replace(k, "+", " "))), bytes_to_string(url.unescape_bytes(u.replace(v, "+", " ")))])
    }
    return out
}

proc pairs_text(pairs) {
    alloc parts := []
    for p in pairs {
        append(parts, url.escape(p[0], true) + "=" + url.escape(p[1], true))
    }
    return u.join(parts, "&")
}

proc g_url_search_params(h, x) {
    alloc o := H[h]
    if has_key(o[2], "@@params") {
        alloc old := o[2]["@@params"]
        H[old][3][0] := query_pairs(g_url_search(h, x))
        return old
    }
    alloc sp := new_obj(C_PARAMS, P["URLSearchParams"])
    H[sp][3] := [query_pairs(g_url_search(h, x)), h, false]
    define_hidden(h, "@@params", sp)
    return sp
}

proc n_url_to_string(this, args) {
    return url_x(this)[0]
}

alloc BLOBS := 0

proc n_create_object_url(this, args) {
    BLOBS := BLOBS + 1
    return "blob:null/" + BLOBS
}

proc params_x(this) {
    if type_of(this) == 2 and this != 0 and H[this][0] == C_PARAMS {
        return H[this][3]
    }
    throw_type("Illegal invocation")
}

# The pairs changed: the URL they belong to follows.
proc params_changed(x) {
    if x[1] != 0 {
        alloc ux := H[x[1]][3]
        alloc p := url_parts(ux)
        alloc q := pairs_text(x[0])
        if q != "" {
            q := "?" + q
        }
        p.query := q
        ux[0] := url.to_string(p)
    }
    return true
}

proc pair_name(x, v) {
    alloc s := to_str(v)
    if x[2] {
        return u.lower(s)
    }
    return s
}

# Pairs from what a script gave: text ("a=1&b=2"), an object, or a
# list of [name, value].
proc pairs_from(init, x) {
    alloc out := []
    if type_of(init) == 0 or (type_of(init) == 2 and init == 0) {
        return out
    }
    if type_of(init) == 4 {
        return query_pairs(init)
    }
    if type_of(init) != 2 {
        return query_pairs(to_str(init))
    }
    if H[init][0] == C_PARAMS {
        for p in H[init][3][0] {
            append(out, [pair_name(x, p[0]), p[1]])
        }
        return out
    }
    if X["is_array"](init) {
        for item in items_of(init) {
            append(out, [pair_name(x, X["get_elem"](item, 0.0)), to_str(X["get_elem"](item, 1.0))])
        }
        return out
    }
    for k in own_keys(init, false) {
        append(out, [pair_name(x, k), to_str(get(init, k))])
    }
    return out
}

proc n_params_ctor(this, args) {
    if type_of(new_target()) == 0 {
        throw_type("Failed to construct 'URLSearchParams': Please use the 'new' operator.")
    }
    alloc h := new_obj(C_PARAMS, P["URLSearchParams"])
    alloc x := [[], 0, false]
    x[0] := pairs_from(arg(args, 0), x)
    H[h][3] := x
    return h
}

proc n_headers_ctor(this, args) {
    if type_of(new_target()) == 0 {
        throw_type("Failed to construct 'Headers': Please use the 'new' operator.")
    }
    alloc h := new_obj(C_PARAMS, P["Headers"])
    alloc x := [[], 0, true]
    x[0] := pairs_from(arg(args, 0), x)
    H[h][3] := x
    return h
}

# What a form would send: [name, value] for each control that counts.
proc form_pairs(form) {
    alloc out := []
    for ctl in controls_in(form, []) {
        if has_key(ctl.attrs, "name") == false or has_key(ctl.attrs, "disabled") {
            continue
        }
        alloc tag := ctl.tag
        alloc ty := u.lower(attr_or(ctl, "type", "text"))
        if tag == "button" or (tag == "input" and (ty == "submit" or ty == "reset" or ty == "button" or ty == "image" or ty == "file")) {
            continue
        }
        if tag == "input" and (ty == "checkbox" or ty == "radio") and is_checked(ctl) == false {
            continue
        }
        append(out, [ctl.attrs["name"], control_value(ctl)])
    }
    return out
}

proc n_form_data_ctor(this, args) {
    if type_of(new_target()) == 0 {
        throw_type("Failed to construct 'FormData': Please use the 'new' operator.")
    }
    alloc h := new_obj(C_PARAMS, P["FormData"])
    alloc x := [[], 0, false]
    if is_node(arg(args, 0)) {
        x[0] := form_pairs(NODES[H[args[0]][3]])
    }
    H[h][3] := x
    return h
}

proc n_params_get(this, args) {
    alloc x := params_x(this)
    alloc name := pair_name(x, arg(args, 0))
    if x[2] {
        # the values of a header that came twice are joined
        alloc all := []
        for p in x[0] {
            if p[0] == name {
                append(all, p[1])
            }
        }
        if length(all) == 0 {
            return 0
        }
        return u.join(all, ", ")
    }
    for p2 in x[0] {
        if p2[0] == name {
            return p2[1]
        }
    }
    return 0
}

proc n_params_get_all(this, args) {
    alloc x := params_x(this)
    alloc name := pair_name(x, arg(args, 0))
    alloc out := []
    for p in x[0] {
        if p[0] == name {
            append(out, p[1])
        }
    }
    return new_array(out)
}

proc n_params_has(this, args) {
    alloc x := params_x(this)
    alloc name := pair_name(x, arg(args, 0))
    for p in x[0] {
        if p[0] == name {
            return true
        }
    }
    return false
}

proc n_params_append(this, args) {
    alloc x := params_x(this)
    append(x[0], [pair_name(x, arg(args, 0)), to_str(arg(args, 1))])
    params_changed(x)
    return U
}

proc n_params_set(this, args) {
    alloc x := params_x(this)
    alloc name := pair_name(x, arg(args, 0))
    alloc value := to_str(arg(args, 1))
    alloc out := []
    alloc done := false
    for p in x[0] {
        if p[0] == name {
            if done == false {
                append(out, [name, value])
                done := true
            }
        } else {
            append(out, p)
        }
    }
    if done == false {
        append(out, [name, value])
    }
    x[0] := out
    params_changed(x)
    return U
}

proc n_params_delete(this, args) {
    alloc x := params_x(this)
    alloc name := pair_name(x, arg(args, 0))
    alloc out := []
    for p in x[0] {
        if p[0] != name {
            append(out, p)
        }
    }
    x[0] := out
    params_changed(x)
    return U
}

proc n_params_to_string(this, args) {
    return pairs_text(params_x(this)[0])
}

proc n_params_for_each(this, args) {
    alloc x := params_x(this)
    for p in x[0] {
        call(arg(args, 0), arg(args, 1), [p[1], p[0], this])
    }
    return U
}

proc params_list(this, mode) {
    alloc out := []
    for p in params_x(this)[0] {
        if mode == 0 {
            append(out, p[0])
        } elif mode == 1 {
            append(out, p[1])
        } else {
            append(out, new_array([p[0], p[1]]))
        }
    }
    alloc arr := new_array(out)
    return call(get(arr, "values"), arr, [])
}

proc n_params_keys(this, args) {
    return params_list(this, 0)
}

proc n_params_values(this, args) {
    return params_list(this, 1)
}

proc n_params_entries(this, args) {
    return params_list(this, 2)
}

proc n_params_sort(this, args) {
    alloc x := params_x(this)
    alloc out := []
    for p in x[0] {
        append(out, p)
        alloc j := length(out) - 1
        loop j > 0 and out[j - 1][0] > p[0] {
            out[j] := out[j - 1]
            j := j - 1
        }
        out[j] := p
    }
    x[0] := out
    params_changed(x)
    return U
}

proc g_params_size(h, x) {
    return float(length(x[0]))
}

# --- the window -----------------------------------------------------------------------------

proc g_inner_width(this, args) {
    return float(view()[0])
}

proc g_inner_height(this, args) {
    return float(view()[1])
}

proc g_scroll_x(this, args) {
    return float(view()[2])
}

proc g_scroll_y(this, args) {
    return float(view()[3])
}

proc g_win_location(this, args) {
    return LOCATION
}

proc s_win_location(this, args) {
    navigate(to_str(arg(args, 0)), false)
    return U
}

proc g_win_origin(this, args) {
    return g_loc_origin(0, 0)
}

proc n_console(this, args) {
    alloc level := native_data()
    alloc text := js.format_args(args)
    if has_key(HOST, "log") {
        HOST["log"](level, text)
    } else {
        append(LOG, text)
    }
    return U
}

proc n_console_assert(this, args) {
    if to_bool(arg(args, 0)) == false {
        alloc text := "Assertion failed"
        if length(args) > 1 {
            text := text + ": " + js.format_args(args[1:])
        }
        if has_key(HOST, "log") {
            HOST["log"]("error", text)
        } else {
            append(LOG, text)
        }
    }
    return U
}

proc n_alert(this, args) {
    alloc text := ""
    if length(args) > 0 {
        text := to_str(args[0])
    }
    if has_key(HOST, "alert") {
        HOST["alert"](text)
    } else {
        append(LOG, "alert: " + text)
    }
    return U
}

proc n_confirm(this, args) {
    n_alert(this, args)
    return true
}

proc n_prompt(this, args) {
    n_alert(this, args)
    if length(args) > 1 and type_of(args[1]) != 0 {
        return to_str(args[1])
    }
    return 0
}

proc n_get_computed_style(this, args) {
    alloc node := arg_node(args, 0, "getComputedStyle")
    alloc h := new_obj(C_COMPUTED, P["CSSStyleDeclaration"])
    H[h][3] := node.nid
    return h
}

proc n_match_media(this, args) {
    alloc text := to_str(arg(args, 0))
    alloc o := new_obj(0, P["EventTarget"])
    alloc holds := false
    try {
        holds := css.media_query(text)
    } except e {
        holds := false
    }
    put(o, "matches", holds)
    put(o, "media", text)
    put(o, "onchange", 0)
    def(o, "addListener", n_nothing, 1)
    def(o, "removeListener", n_nothing, 1)
    return o
}

proc now_ms() {
    return time_ms() * 1.0 - START
}

proc n_performance_now(this, args) {
    return now_ms()
}

proc n_raf_run(this, args) {
    alloc fn := native_data()
    return call(fn, U, [now_ms()])
}

proc n_request_animation_frame(this, args) {
    alloc fn := arg(args, 0)
    if is_callable(fn) == false {
        throw_type("Failed to execute 'requestAnimationFrame' on 'Window': parameter 1 is not of type 'Function'.")
    }
    return float(promise.add_timer(new_native_with(n_raf_run, "", 0, fn), 16, -1, []))
}

proc n_time_remaining(this, args) {
    return 50.0
}

proc n_idle_run(this, args) {
    alloc fn := native_data()
    alloc deadline := new_object()
    put(deadline, "didTimeout", false)
    def(deadline, "timeRemaining", n_time_remaining, 0)
    return call(fn, U, [deadline])
}

proc n_request_idle_callback(this, args) {
    alloc fn := arg(args, 0)
    if is_callable(fn) == false {
        return 0.0
    }
    return float(promise.add_timer(new_native_with(n_idle_run, "", 0, fn), 1, -1, []))
}

proc n_cancel_timer(this, args) {
    alloc v := to_num(arg(args, 0))
    if v == v and v > 0.0 and v < 9007199254740992.0 {
        promise.cancel_timer(int(v))
    }
    return U
}

proc scroll_args(args, by) {
    alloc v := view()
    alloc x := 0.0
    alloc y := 0.0
    alloc a := arg(args, 0)
    if type_of(a) == 2 and a != 0 {
        alloc left := get(a, "left")
        alloc top := get(a, "top")
        if by == false {
            x := v[2] * 1.0
            y := v[3] * 1.0
        }
        if type_of(left) != 0 {
            x := to_num(left)
        }
        if type_of(top) != 0 {
            y := to_num(top)
        }
    } else {
        x := to_num(a)
        y := to_num(arg(args, 1))
    }
    if x != x {
        x := 0.0
    }
    if y != y {
        y := 0.0
    }
    if by {
        x := x + v[2]
        y := y + v[3]
    }
    if has_key(HOST, "scroll") {
        HOST["scroll"](int(x), int(y))
    }
    return U
}

proc n_scroll_to(this, args) {
    return scroll_args(args, false)
}

proc n_scroll_by(this, args) {
    return scroll_args(args, true)
}

proc n_post_message(this, args) {
    append(TASKS, [8, arg(args, 0)])
    return U
}

proc n_structured_clone(this, args) {
    alloc json := get(I[0], "JSON")
    alloc text := call(get(json, "stringify"), json, [arg(args, 0)])
    if type_of(text) != 4 {
        return arg(args, 0)
    }
    return call(get(json, "parse"), json, [text])
}

proc n_report_error(this, args) {
    promise.report(arg(args, 0))
    return U
}

proc n_open(this, args) {
    if length(args) > 0 and to_str(args[0]) != "" {
        navigate(to_str(args[0]), false)
    }
    return 0
}

proc n_image_ctor(this, args) {
    alloc node := new_element(native_data())
    if length(args) > 0 and type_of(args[0]) != 0 {
        node.attrs["width"] := to_str(args[0])
    }
    if length(args) > 1 and type_of(args[1]) != 0 {
        node.attrs["height"] := to_str(args[1])
    }
    return wrap(node)
}

proc n_option_ctor(this, args) {
    alloc node := new_element("option")
    if length(args) > 0 and type_of(args[0]) != 0 {
        insert_before(node, new_text(to_str(args[0])), false)
    }
    if length(args) > 1 and type_of(args[1]) != 0 {
        node.attrs["value"] := to_str(args[1])
    }
    return wrap(node)
}

proc n_illegal_ctor(this, args) {
    throw_type("Illegal constructor")
}

proc n_event_target_ctor(this, args) {
    return new_obj(0, P["EventTarget"])
}

proc n_dom_exception(this, args) {
    alloc msg := ""
    if length(args) > 0 and type_of(args[0]) != 0 {
        msg := to_str(args[0])
    }
    alloc e := make_error(8, msg)
    H[e][1] := P["DOMException"]
    alloc name := "Error"
    if length(args) > 1 and type_of(args[1]) != 0 {
        name := to_str(args[1])
    }
    define_hidden(e, "name", name)
    define_hidden(e, "code", 0.0)
    return e
}

proc n_random_uuid(this, args) {
    alloc b := random_bytes(16)
    b[6] := (b[6] & 15) | 64
    b[8] := (b[8] & 63) | 128
    alloc hex := "0123456789abcdef"
    alloc out := ""
    alloc i := 0
    loop i < 16 {
        if i == 4 or i == 6 or i == 8 or i == 10 {
            out := out + "-"
        }
        out := out + hex[b[i] >> 4] + hex[b[i] & 15]
        i := i + 1
    }
    return out
}

proc n_get_random_values(this, args) {
    alloc a := arg(args, 0)
    if X["is_array"](a) {
        alloc items := items_of(a)
        alloc b := random_bytes(length(items) * 4)
        alloc i := 0
        loop i < length(items) {
            items[i] := (b[i * 4] | (b[i * 4 + 1] << 8) | (b[i * 4 + 2] << 16) | (b[i * 4 + 3] << 24)) * 1.0
            i := i + 1
        }
    }
    return a
}

proc n_css_supports(this, args) {
    return false
}

proc n_css_escape(this, args) {
    alloc s := to_str(arg(args, 0))
    alloc out := ""
    for ch in s {
        alloc c := string_bytes(ch)[0]
        if (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 45 or c == 95 or c >= 128 {
            out := out + ch
        } else {
            out := out + "\\" + ch
        }
    }
    return out
}

# -- observers: nothing is watched. An IntersectionObserver is told
# once that what it observes is in view, which is what pages that
# load pictures late wait for; a ResizeObserver is told the size once.

proc n_observer_ctor(this, args) {
    alloc kind := native_data()
    if type_of(new_target()) == 0 {
        throw_type("Failed to construct '" + kind + "': Please use the 'new' operator.")
    }
    alloc o := new_obj(0, P[kind])
    define_hidden(o, "@@callback", arg(args, 0))
    define_hidden(o, "@@kind", kind)
    return o
}

proc n_observe(this, args) {
    if type_of(this) != 2 or this == 0 or has_own(this, "@@kind") == false {
        return U
    }
    alloc kind := get(this, "@@kind")
    if (kind == "IntersectionObserver" or kind == "ResizeObserver") and is_node(arg(args, 0)) {
        append(TASKS, [5, this, args[0], kind])
    }
    return U
}

proc run_observer(task) {
    alloc ob := task[1]
    alloc el := task[2]
    alloc node := NODES[H[el][3]]
    alloc r := rect_of(node)
    alloc v := view()
    alloc entry := new_object()
    put(entry, "target", el)
    if task[3] == "IntersectionObserver" {
        put(entry, "isIntersecting", true)
        put(entry, "intersectionRatio", 1.0)
        put(entry, "boundingClientRect", new_rect(r[0] - v[2], r[1] - v[3], r[2], r[3]))
        put(entry, "intersectionRect", new_rect(r[0] - v[2], r[1] - v[3], r[2], r[3]))
        put(entry, "rootBounds", new_rect(0, 0, v[0], v[1]))
        put(entry, "time", now_ms())
    } else {
        put(entry, "contentRect", new_rect(0, 0, r[2], r[3]))
        alloc size := new_object()
        put(size, "inlineSize", r[2] * 1.0)
        put(size, "blockSize", r[3] * 1.0)
        put(entry, "contentBoxSize", new_array([size]))
        put(entry, "borderBoxSize", new_array([size]))
    }
    alloc cb := get(ob, "@@callback")
    if is_callable(cb) {
        call(cb, ob, [new_array([entry]), ob])
    }
    return true
}

proc n_abort(this, args) {
    alloc signal := get(this, "signal")
    if type_of(signal) == 2 and signal != 0 and to_bool(get(signal, "aborted")) == false {
        put(signal, "aborted", true)
        alloc reason := arg(args, 0)
        if type_of(reason) == 0 {
            reason := make_error(8, "signal is aborted without reason")
            define_hidden(reason, "name", "AbortError")
        }
        put(signal, "reason", reason)
        fire(target_nid(signal), "abort", false, false, {}, "Event")
    }
    return U
}

proc n_abort_controller(this, args) {
    if type_of(new_target()) == 0 {
        throw_type("Failed to construct 'AbortController': Please use the 'new' operator.")
    }
    alloc o := new_obj(0, P["AbortController"])
    alloc signal := new_obj(0, P["EventTarget"])
    put(signal, "aborted", false)
    put(signal, "reason", U)
    put(signal, "onabort", 0)
    put(o, "signal", signal)
    return o
}

proc n_ce_define(this, args) {
    define_hidden(this, "@@ce:" + to_str(arg(args, 0)), arg(args, 1))
    return U
}

proc n_ce_get(this, args) {
    alloc key := "@@ce:" + to_str(arg(args, 0))
    if has_own(this, key) {
        return get(this, key)
    }
    return U
}

proc n_ce_when_defined(this, args) {
    return promise.new_promise()
}

# --- fetch and XMLHttpRequest ---------------------------------------------------------------
#
# The browser fetches one thing at a time and waits for it, so a
# request a script makes is put off until the script has returned;
# the page stands still while it is fetched.

# Ask the browser. Gives the dict net.omg gives: {status, error, url,
# body, headers}.
proc host_fetch(where, method, headers, body) {
    if has_key(HOST, "fetch") == false {
        return {status: 0, error: "no network here", url: where, body: bytes_repeat(0, 0), headers: {}}
    }
    return HOST["fetch"](where, method, headers, body)
}

proc body_text(r) {
    alloc charset := "utf-8"
    if has_key(r.headers, "content-type") {
        alloc ct := u.lower(r.headers["content-type"])
        alloc at := u.find(ct, "charset=")
        if at >= 0 {
            charset := u.trim(u.replace(u.split(ct[at + 8:], ";")[0], "\"", ""))
        }
    }
    return bytes_to_string(html.to_utf8(r.body, charset))
}

alloc STATUS_TEXT := {"200": "OK", "201": "Created", "204": "No Content", "301": "Moved Permanently", "302": "Found", "304": "Not Modified", "400": "Bad Request", "401": "Unauthorized", "403": "Forbidden", "404": "Not Found", "405": "Method Not Allowed", "500": "Internal Server Error", "502": "Bad Gateway", "503": "Service Unavailable"}

proc status_text(code) {
    if has_key(STATUS_TEXT, "" + code) {
        return STATUS_TEXT["" + code]
    }
    return ""
}

proc new_headers(d) {
    alloc h := new_obj(C_PARAMS, P["Headers"])
    alloc pairs := []
    for k in dict_keys(d) {
        append(pairs, [u.lower(k), "" + d[k]])
    }
    H[h][3] := [pairs, 0, true]
    return h
}

proc new_response(text, status, where, headers) {
    alloc o := new_obj(0, P["Response"])
    put(o, "status", status * 1.0)
    put(o, "ok", status >= 200 and status < 300)
    put(o, "statusText", status_text(status))
    put(o, "url", where)
    put(o, "redirected", false)
    put(o, "type", "basic")
    put(o, "bodyUsed", false)
    put(o, "headers", headers)
    define_hidden(o, "@@body", text)
    return o
}

proc response_body(this) {
    if type_of(this) != 2 or this == 0 or has_own(this, "@@body") == false {
        throw_type("Illegal invocation")
    }
    put(this, "bodyUsed", true)
    return get(this, "@@body")
}

proc n_response_text(this, args) {
    return promise.to_promise(response_body(this))
}

proc n_response_json(this, args) {
    alloc text := response_body(this)
    alloc p := promise.new_promise()
    alloc json := get(I[0], "JSON")
    try {
        promise.settle(p, true, call(get(json, "parse"), json, [text]))
    } except e {
        promise.settle(p, false, caught(e))
    }
    return p
}

proc n_response_clone(this, args) {
    alloc text := get(this, "@@body")
    return new_response(text, int(to_num(get(this, "status"))), to_str(get(this, "url")), get(this, "headers"))
}

proc n_response_unsupported(this, args) {
    alloc p := promise.new_promise()
    promise.settle(p, false, make_error(9, "This browser keeps the body of a response as text only"))
    return p
}

proc n_response_ctor(this, args) {
    alloc text := ""
    if length(args) > 0 and is_nullish(args[0]) == false {
        text := to_str(args[0])
    }
    alloc status := 200
    alloc headers := new_headers({})
    alloc init := arg(args, 1)
    if type_of(init) == 2 and init != 0 {
        if type_of(get(init, "status")) != 0 {
            status := int(to_integer(get(init, "status")))
        }
        H[headers][3][0] := pairs_from(get(init, "headers"), H[headers][3])
    }
    return new_response(text, status, "", headers)
}

# What a script may give as the body of a request, as text, and the
# kind of content it is ("" when the script must say).
proc request_body(v) {
    if is_nullish(v) {
        return [false, ""]
    }
    if type_of(v) == 2 and H[v][0] == C_PARAMS {
        return [pairs_text(H[v][3][0]), "application/x-www-form-urlencoded;charset=UTF-8"]
    }
    if type_of(v) == 4 {
        return [v, "text/plain;charset=UTF-8"]
    }
    return [to_str(v), "text/plain;charset=UTF-8"]
}

proc has_header(pairs, name) {
    for p in pairs {
        if u.lower(p[0]) == name {
            return true
        }
    }
    return false
}

proc n_fetch(this, args) {
    alloc p := promise.new_promise()
    alloc input := arg(args, 0)
    alloc where := ""
    alloc method := "GET"
    alloc headers := []
    alloc body := [false, ""]
    alloc init := arg(args, 1)
    if type_of(input) == 2 and input != 0 and has_own(input, "@@request") {
        where := to_str(get(input, "url"))
        method := to_str(get(input, "method"))
        headers := pairs_from(get(input, "headers"), [[], 0, true])
        body := request_body(get(input, "@@reqbody"))
    } else {
        where := to_str(input)
    }
    if type_of(init) == 2 and init != 0 {
        if type_of(get(init, "method")) != 0 {
            method := u.upper(to_str(get(init, "method")))
        }
        if type_of(get(init, "headers")) != 0 {
            headers := pairs_from(get(init, "headers"), [[], 0, true])
        }
        if type_of(get(init, "body")) != 0 {
            body := request_body(get(init, "body"))
        }
        alloc signal := get(init, "signal")
        if type_of(signal) == 2 and signal != 0 and to_bool(get(signal, "aborted")) {
            promise.settle(p, false, get(signal, "reason"))
            return p
        }
    }
    alloc target := url.resolve(BASE, where)
    if target == "" {
        promise.settle(p, false, make_error(9, "Failed to parse URL from " + where))
        return p
    }
    if body[0] != false and body[1] != "" and has_header(headers, "content-type") == false {
        append(headers, ["content-type", body[1]])
    }
    append(TASKS, [1, p, target, method, headers, body[0]])
    return p
}

proc run_fetch(task) {
    alloc r := host_fetch(task[2], task[3], task[4], task[5])
    if r.status == 0 {
        promise.settle(task[1], false, make_error(9, "Failed to fetch (" + r.error + ")"))
        return true
    }
    promise.settle(task[1], true, new_response(body_text(r), r.status, r.url, new_headers(r.headers)))
    return true
}

proc n_request_ctor(this, args) {
    alloc o := new_obj(0, P["Request"])
    alloc input := arg(args, 0)
    alloc init := arg(args, 1)
    alloc where := to_str(input)
    if type_of(input) == 2 and input != 0 and has_own(input, "@@request") {
        where := to_str(get(input, "url"))
    }
    alloc target := url.resolve(BASE, where)
    put(o, "url", target)
    put(o, "method", "GET")
    alloc hs := new_headers({})
    put(o, "headers", hs)
    define_hidden(o, "@@request", true)
    define_hidden(o, "@@reqbody", U)
    if type_of(init) == 2 and init != 0 {
        if type_of(get(init, "method")) != 0 {
            put(o, "method", u.upper(to_str(get(init, "method"))))
        }
        if type_of(get(init, "headers")) != 0 {
            H[hs][3][0] := pairs_from(get(init, "headers"), H[hs][3])
        }
        if type_of(get(init, "body")) != 0 {
            define_hidden(o, "@@reqbody", get(init, "body"))
        }
    }
    return o
}

# An XMLHttpRequest is an object of class 39; its payload:
# [0 number, 1 method, 2 address, 3 asynchronous?, 4 headers to send,
# 5 readyState, 6 status, 7 the answer as text, 8 the answer's
# headers, 9 responseType, 10 where the answer came from, 11 sent?,
# 12 timeout, 13 withCredentials].

proc xhr_x(this) {
    if type_of(this) == 2 and this != 0 and H[this][0] == C_XHR {
        return H[this][3]
    }
    throw_type("Illegal invocation")
}

proc n_xhr_ctor(this, args) {
    if type_of(new_target()) == 0 {
        throw_type("Failed to construct 'XMLHttpRequest': Please use the 'new' operator.")
    }
    alloc h := new_obj(C_XHR, P["XMLHttpRequest"])
    alloc id := register({t: 0, kids: []}, -1)
    WRAP[id] := h
    define_hidden(h, "@@target", float(id))
    H[h][3] := [id, "GET", "", true, [], 0, 0, "", {}, "", "", false, 0.0, false]
    return h
}

proc xhr_state(h, x, state) {
    x[5] := state
    fire(x[0], "readystatechange", false, false, {}, "Event")
    return true
}

proc n_xhr_open(this, args) {
    alloc x := xhr_x(this)
    x[1] := u.upper(to_str(arg(args, 0)))
    x[2] := url.resolve(BASE, to_str(arg(args, 1)))
    x[3] := true
    if length(args) > 2 and type_of(args[2]) != 0 {
        x[3] := to_bool(args[2])
    }
    x[4] := []
    x[6] := 0
    x[7] := ""
    x[8] := {}
    x[11] := false
    xhr_state(this, x, 1)
    return U
}

proc n_xhr_set_request_header(this, args) {
    alloc x := xhr_x(this)
    append(x[4], [to_str(arg(args, 0)), to_str(arg(args, 1))])
    return U
}

proc run_xhr(h, body) {
    alloc x := H[h][3]
    if x[11] == false {
        # abort() came first
        return false
    }
    alloc r := host_fetch(x[2], x[1], x[4], body)
    alloc progress := {lengthComputable: false, loaded: 0.0, total: 0.0}
    if r.status == 0 {
        x[6] := 0
        x[5] := 4
        fire(x[0], "readystatechange", false, false, {}, "Event")
        fire(x[0], "error", false, false, progress, "ProgressEvent")
        fire(x[0], "loadend", false, false, progress, "ProgressEvent")
        return false
    }
    x[6] := r.status
    x[7] := body_text(r)
    x[8] := r.headers
    x[10] := r.url
    progress := {lengthComputable: true, loaded: length(r.body) * 1.0, total: length(r.body) * 1.0}
    xhr_state(h, x, 2)
    xhr_state(h, x, 3)
    xhr_state(h, x, 4)
    fire(x[0], "load", false, false, progress, "ProgressEvent")
    fire(x[0], "loadend", false, false, progress, "ProgressEvent")
    return true
}

proc n_xhr_send(this, args) {
    alloc x := xhr_x(this)
    if x[5] != 1 {
        dom_error("InvalidStateError", "Failed to execute 'send' on 'XMLHttpRequest': The object's state must be OPENED.")
    }
    alloc body := request_body(arg(args, 0))
    if body[0] != false and body[1] != "" and has_header(x[4], "content-type") == false {
        append(x[4], ["content-type", body[1]])
    }
    x[11] := true
    if x[3] {
        append(TASKS, [2, this, body[0]])
    } else {
        run_xhr(this, body[0])
    }
    return U
}

proc n_xhr_abort(this, args) {
    alloc x := xhr_x(this)
    if x[11] and x[5] != 4 {
        x[11] := false
        x[5] := 0
        fire(x[0], "abort", false, false, {}, "ProgressEvent")
        fire(x[0], "loadend", false, false, {}, "ProgressEvent")
    }
    return U
}

proc n_xhr_get_response_header(this, args) {
    alloc x := xhr_x(this)
    alloc name := u.lower(to_str(arg(args, 0)))
    if has_key(x[8], name) {
        return "" + x[8][name]
    }
    return 0
}

proc n_xhr_get_all_response_headers(this, args) {
    alloc x := xhr_x(this)
    alloc out := ""
    for k in dict_keys(x[8]) {
        out := out + k + ": " + x[8][k] + "\r\n"
    }
    return out
}

proc g_xhr_ready_state(h, x) {
    return float(x[5])
}

proc g_xhr_status(h, x) {
    return float(x[6])
}

proc g_xhr_status_text(h, x) {
    return status_text(x[6])
}

proc g_xhr_response_text(h, x) {
    return x[7]
}

proc g_xhr_response(h, x) {
    if x[9] == "json" {
        if x[5] != 4 {
            return 0
        }
        alloc json := get(I[0], "JSON")
        try {
            return call(get(json, "parse"), json, [x[7]])
        } except e {
            caught(e)
            return 0
        }
    }
    return x[7]
}

proc g_xhr_response_type(h, x) {
    return x[9]
}

proc s_xhr_response_type(h, x, v) {
    x[9] := to_str(v)
}

proc g_xhr_response_url(h, x) {
    return x[10]
}

proc g_xhr_timeout(h, x) {
    return x[12]
}

proc s_xhr_timeout(h, x, v) {
    x[12] := to_num(v)
}

proc g_xhr_with_credentials(h, x) {
    return x[13]
}

proc s_xhr_with_credentials(h, x, v) {
    x[13] := to_bool(v)
}

proc g_xhr_upload(h, x) {
    alloc o := H[h]
    if has_key(o[2], "@@upload") {
        return o[2]["@@upload"]
    }
    alloc up := new_obj(0, P["EventTarget"])
    define_hidden(h, "@@upload", up)
    return up
}

proc g_xhr_null(h, x) {
    return 0
}

# --- scripts --------------------------------------------------------------------------------

alloc SCRIPT_TYPES := {"": 1, "text/javascript": 1, "application/javascript": 1, "application/x-javascript": 1,
                       "text/ecmascript": 1, "application/ecmascript": 1, "text/jscript": 1, "text/javascript1.5": 1}
alloc INLINE_COUNT := 0

proc script_runs(node) {
    alloc ty := u.lower(u.trim(attr_or(node, "type", "")))
    alloc semi := u.find(ty, ";")
    if semi >= 0 {
        ty := u.trim(ty[0:semi])
    }
    if has_key(SCRIPT_TYPES, ty) == false {
        return false
    }
    alloc lang := u.lower(u.trim(attr_or(node, "language", "")))
    return lang == "" or u.starts_with(lang, "javascript") or lang == "jscript" or lang == "ecmascript"
}

# Old pages hide their scripts from browsers that know none: the
# text starts with "<!--", which JavaScript takes for a comment.
proc unhide(text) {
    alloc t := u.trim(text)
    if u.starts_with(t, "<!--") == false {
        return text
    }
    alloc at := u.find(text, "<!--")
    alloc out := text[0:at] + "//" + text[at + 4:]
    alloc t2 := u.trim(out)
    if u.ends_with(t2, "-->") {
        alloc lines := u.split(t2, "\n")
        alloc last := u.trim(lines[length(lines) - 1])
        if last == "-->" {
            alloc end := u.find(out, "-->")
            alloc cut := length(t2) - 3
            out := t2[0:cut] + "//"
        }
    }
    return out
}

# Run the script of a <script> element: fetched when it names a
# file, its own text otherwise.
proc run_script_node(node, later) {
    if script_runs(node) == false {
        return false
    }
    alloc bytes := bytes_repeat(0, 0)
    alloc name := ""
    alloc external := has_key(node.attrs, "src")
    if external {
        alloc where := url.resolve(BASE, node.attrs["src"])
        if where == "" {
            return false
        }
        alloc r := host_fetch(where, "GET", [], false)
        if r.status < 200 or r.status >= 300 {
            promise.report("Could not load the script " + where)
            fire(node.nid, "error", false, false, {}, "Event")
            return false
        }
        alloc charset := u.lower(attr_or(node, "charset", ""))
        if has_key(r.headers, "content-type") {
            alloc ct := u.lower(r.headers["content-type"])
            alloc at := u.find(ct, "charset=")
            if at >= 0 {
                charset := u.trim(u.replace(u.split(ct[at + 8:], ";")[0], "\"", ""))
            }
        }
        if charset == "" or charset == "utf-8" or charset == "utf8" {
            bytes := r.body
        } else {
            bytes := html.to_utf8(r.body, charset)
        }
        name := r.url
    } else {
        alloc text := html.text_of(node)
        if u.trim(text) == "" {
            return false
        }
        bytes := string_bytes(unhide(text))
        INLINE_COUNT := INLINE_COUNT + 1
        name := "script " + INLINE_COUNT + " of the page"
    }
    alloc before := CURRENT_SCRIPT
    CURRENT_SCRIPT := node
    alloc out := js.run(bytes, name)
    CURRENT_SCRIPT := before
    if out[0] == false {
        promise.report(out[1])
    }
    promise.run_microtasks()
    if external {
        fire(node.nid, "load", false, false, {}, "Event")
    }
    return true
}

# Run the scripts the page came with, in the order they stand in.
# `stop` is a proc that says when to give up (the page asked to go
# somewhere else).
proc run_scripts(stop) {
    for node in collect(DOC, "script", [], []) {
        if has_key(node, "ran") or is_connected(node) == false {
            continue
        }
        node.ran := true
        run_script_node(node, false)
        if stop() {
            return false
        }
    }
    READY := "interactive"
    fire(DOC_NID, "readystatechange", false, false, {}, "Event")
    fire(DOC_NID, "DOMContentLoaded", true, false, {}, "Event")
    promise.run_microtasks()
    return true
}

# Everything the page needs has come: tell it.
proc finish_load() {
    READY := "complete"
    fire(DOC_NID, "readystatechange", false, false, {}, "Event")
    fire(0, "load", false, false, {}, "Event")
    fire(0, "pageshow", false, false, {persisted: false}, "Event")
    promise.run_microtasks()
    return true
}

# --- work that waits ------------------------------------------------------------------------

proc run_task(task) {
    alloc kind := task[0]
    try {
        if kind == 0 {
            if is_connected(task[1]) {
                run_script_node(task[1], true)
            }
        } elif kind == 1 {
            run_fetch(task)
        } elif kind == 2 {
            run_xhr(task[1], task[2])
        } elif kind == 3 {
            fire(task[1].nid, task[2], false, false, {}, "Event")
        } elif kind == 4 {
            fire(0, "hashchange", false, false, {oldURL: task[1], newURL: task[2]}, "HashChangeEvent")
        } elif kind == 5 {
            run_observer(task)
        } elif kind == 8 {
            fire(0, "message", false, false, {data: task[1], origin: g_loc_origin(0, 0), source: I[0]}, "MessageEvent")
        }
    } except e {
        promise.report(caught(e))
    }
    return true
}

proc say_errors() {
    for v in js.take_errors() {
        alloc text := "Uncaught " + X["describe"](v)
        if type_of(v) == 4 {
            text := v
        }
        if has_key(HOST, "log") {
            HOST["log"]("error", text)
        } else {
            append(LOG, text)
        }
    }
    return true
}

# Do what waits: the requests scripts made, the timers that are due.
# True when something ran.
proc pump() {
    alloc did := false
    alloc n := 0
    loop TASK_AT < length(TASKS) and n < 8 {
        alloc task := TASKS[TASK_AT]
        TASKS[TASK_AT] := 0
        TASK_AT := TASK_AT + 1
        run_task(task)
        promise.run_microtasks()
        did := true
        n := n + 1
    }
    if TASK_AT > 0 and TASK_AT >= length(TASKS) {
        TASKS := []
        TASK_AT := 0
    }
    alloc due := promise.next_due()
    if due >= 0 and due <= time_ms() {
        promise.run_timers()
        did := true
    }
    if promise.run_microtasks() > 0 {
        did := true
    }
    say_errors()
    return did
}

# How long the browser may sleep before pump() has work: 0 when
# there is some now, -1 when none is in sight.
proc wait_ms() {
    if TASK_AT < length(TASKS) {
        return 0
    }
    alloc due := promise.next_due()
    if due < 0 {
        return -1
    }
    alloc w := due - time_ms()
    if w < 0 {
        return 0
    }
    return w
}

# [did the tree change?, did a style sheet?] since the last call.
# What changed since the browser last asked: [the tree?, the style
# sheets?, where styles are stale]. The last is false when all of
# them may be, else a list of [chain, places] (see chain_of) of the
# elements to work out again along with what is below them.
proc take_dirty() {
    alloc roots := false
    if RESTYLE_ALL == false and SHEETS == false and length(RESTYLE) <= 24 {
        roots := []
        for key in dict_keys(RESTYLE) {
            alloc node := NODES[u.to_int(key, 0)]
            if type_of(node) != 6 or is_connected(node) == false {
                continue
            }
            alloc ch := chain_of(node)
            alloc inside := false
            alloc i := 0
            loop i < length(ch[0]) - 1 {
                if has_key(RESTYLE, "" + ch[0][i].nid) {
                    inside := true
                    break
                }
                i := i + 1
            }
            if inside == false {
                append(roots, ch)
            }
        }
    }
    alloc out := [DIRTY, SHEETS, roots]
    DIRTY := false
    SHEETS := false
    RESTYLE := {}
    RESTYLE_ALL := false
    RESTYLE := {}
    RESTYLE_ALL := false
    return out
}

proc is_dirty() {
    return DIRTY or SHEETS
}

# An event from the window (a click, a key): send it, then let the
# promises it settled run. True when the page did not cancel it.
proc fire_node(node, name, bubbles, cancelable, props, kind) {
    if has_key(node, "nid") == false {
        return true
    }
    alloc ok := fire(node.nid, name, bubbles, cancelable, props, kind)
    promise.run_microtasks()
    say_errors()
    return ok
}

proc fire_window(name, props, kind) {
    alloc ok := fire(0, name, false, false, props, kind)
    promise.run_microtasks()
    say_errors()
    return ok
}

proc set_focus(node) {
    FOCUS := node
    return true
}

# The person followed a link to another part of the page, or went
# back to one.
proc moved_to(address) {
    alloc old := ADDRESS
    if address != old {
        ADDRESS := address
        append(TASKS, [4, old, address])
    }
    return true
}

proc set_address(address) {
    ADDRESS := address
    return true
}

proc take_log() {
    alloc out := LOG
    LOG := []
    return out
}

# Run a piece of script in the page (for tests, and "javascript:"
# links). Gives [true, value as text] or [false, what was thrown].
proc evaluate(text) {
    alloc r := js.run(string_bytes(text), "evaluate")
    promise.run_microtasks()
    if r[0] == false {
        say_errors()
        return [false, X["describe"](r[1])]
    }
    say_errors()
    return [true, js.format_args([r[1]])]
}

# Does the page have anything for the engine to do?
proc wants_engine(node) {
    for k in node.kids {
        if k.t == 1 {
            if k.tag == "script" {
                if script_runs(k) {
                    return true
                }
            } else {
                for name in dict_keys(k.attrs) {
                    if length(name) > 2 and name[0:2] == "on" {
                        return true
                    }
                }
                if u.starts_with(u.lower(u.trim(attr_or(k, "href", ""))), "javascript:") {
                    return true
                }
                if wants_engine(k) {
                    return true
                }
            }
        }
    }
    return false
}

# --- putting it all in place ----------------------------------------------------------------

# A kind of object scripts know by name ("Node", "Element"): a
# prototype, and a constructor that hangs on the window.
proc iface_with(name, parent, fn, nargs, data) {
    alloc proto := new_obj(0, parent)
    alloc ctor := new_native_with(fn, name, nargs, data)
    define_hidden(ctor, "prototype", proto)
    define_hidden(proto, "constructor", ctor)
    define_hidden(proto, "@@toStringTag", name)
    define_hidden(I[0], name, ctor)
    P[name] := proto
    return proto
}

proc iface(name, parent) {
    return iface_with(name, parent, n_illegal_ctor, 0, 0)
}

alloc TAG_NAMES := {
    a: "HTMLAnchorElement", area: "HTMLAreaElement", audio: "HTMLAudioElement", br: "HTMLBRElement",
    base: "HTMLBaseElement", body: "HTMLBodyElement", button: "HTMLButtonElement",
    canvas: "HTMLCanvasElement", dl: "HTMLDListElement", details: "HTMLDetailsElement",
    dialog: "HTMLDialogElement", div: "HTMLDivElement", embed: "HTMLEmbedElement",
    fieldset: "HTMLFieldSetElement", form: "HTMLFormElement", h1: "HTMLHeadingElement",
    h2: "HTMLHeadingElement", h3: "HTMLHeadingElement", h4: "HTMLHeadingElement",
    h5: "HTMLHeadingElement", h6: "HTMLHeadingElement", head: "HTMLHeadElement", hr: "HTMLHRElement",
    html: "HTMLHtmlElement", iframe: "HTMLIFrameElement", img: "HTMLImageElement",
    input: "HTMLInputElement", label: "HTMLLabelElement", legend: "HTMLLegendElement",
    li: "HTMLLIElement", link: "HTMLLinkElement", meta: "HTMLMetaElement", ol: "HTMLOListElement",
    optgroup: "HTMLOptGroupElement", option: "HTMLOptionElement", p: "HTMLParagraphElement",
    pre: "HTMLPreElement", script: "HTMLScriptElement", select: "HTMLSelectElement",
