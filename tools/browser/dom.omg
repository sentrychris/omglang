        HOST["focus"](false)
    }
    return U
}

proc n_click(this, args) {
    alloc node := node_of(this, "click")
    if fire(node.nid, "click", true, true, {button: 0.0, clientX: 0.0, clientY: 0.0, detail: 1.0}, "MouseEvent") {
        if has_key(HOST, "activate") {
            HOST["activate"](node)
        }
    }
    return U
}

proc n_submit(this, args) {
    alloc node := el_of(this, "submit")
    if has_key(HOST, "submit") {
        HOST["submit"](node)
    }
