                                            sp := sp + 1
                                            pc := pc + 3
                                        }
                                    }
                                } else {
                                    # 83 FORIN       [o] -> [iterator over its keys]
                                    SP := sp
                                    S[sp - 1] := [3, enum_keys(S[sp - 1]), 0]
                                    pc := pc + 1
                                }
                            }
                        } else {
                            if op < 86 {
                                if op < 85 {
                                    # 84 ITERVAL r   push the next value, undefined when there is none
                                    SP := sp
                                    f[5] := pc
                                    a := iter_step(R[code[pc + 1]])
                                    if type_of(a) == 5 {
                                        a := U
                                    }
                                    S[sp] := a
                                    sp := sp + 1
                                    pc := pc + 2
                                } else {
                                    # 85 ITERREST r  push an array of what is left
                                    SP := sp
                                    f[5] := pc
                                    e := R[code[pc + 1]]
                                    r := []
                                    loop true {
                                        a := iter_step(e)
                                        if type_of(a) == 5 {
                                            break
                                        }
                                        append(r, a)
                                    }
                                    S[sp] := new_array(r)
                                    sp := sp + 1
                                    pc := pc + 2
                                }
                            } else {
                                if op < 87 {
                                    # 86 DEFAULT a   [v]: undefined, drop it and go on; else jump
                                    if type_of(S[sp - 1]) == 0 {
                                        sp := sp - 1
                                        pc := pc + 2
                                    } else {
                                        pc := code[pc + 1]
                                    }
                                } else {
                                    if op < 88 {
                                        # 87 OBJREST k   [o] -> [o rest], rest being o less the keys K[k]
                                        SP := sp
                                        a := new_obj(0, OBJECT_PROTO)
                                        copy_props(a, S[sp - 1], K[code[pc + 1]])
                                        S[sp] := a
                                        sp := sp + 1
                                        pc := pc + 2
                                    } else {
                                        # 88 INITEL      [o key v] -> [o]
                                        sp := sp - 2
                                        SP := sp + 2
                                        define(S[sp - 1], to_key(S[sp]), S[sp + 1])
                                        pc := pc + 1
                                    }
                                }
                            }
                        }
                    }
                }
            } else {
                if op < 105 {
                    if op < 97 {
                        if op < 93 {
                            if op < 91 {
                                if op < 90 {
                                    # 89 INITGET k   [o fn] -> [o]
                                    sp := sp - 1
                                    define_accessor(S[sp - 1], K[code[pc + 1]], 0, S[sp])
                                    pc := pc + 2
                                } else {
                                    # 90 INITSET k
                                    sp := sp - 1
                                    define_accessor(S[sp - 1], K[code[pc + 1]], 1, S[sp])
                                    pc := pc + 2
                                }
                            } else {
                                if op < 92 {
                                    # 91 INITGETEL   [o key fn] -> [o]
                                    sp := sp - 2
                                    SP := sp + 2
                                    define_accessor(S[sp - 1], to_key(S[sp]), 0, S[sp + 1])
                                    pc := pc + 1
                                } else {
                                    # 92 INITSETEL
                                    sp := sp - 2
                                    SP := sp + 2
                                    define_accessor(S[sp - 1], to_key(S[sp]), 1, S[sp + 1])
                                    pc := pc + 1
                                }
                            }
                        } else {
                            if op < 95 {
                                if op < 94 {
                                    # 93 SPREADOBJ   [o src] -> [o]
                                    sp := sp - 1
                                    SP := sp + 1
                                    copy_props(S[sp - 1], S[sp], [])
                                    pc := pc + 1
                                } else {
                                    # 94 APPENDSPREAD  [array iterable] -> [array]
                                    sp := sp - 1
                                    SP := sp + 1
                                    f[5] := pc
                                    r := iter_list(S[sp])
                                    o := H[S[sp - 1]]
                                    for a in r {
                                        arr_set(o, o[6], a)
                                    }
                                    pc := pc + 1
                                }
                            } else {
                                if op < 96 {
                                    # 95 CALLSPREAD  [f this array] -> [result]
                                    sp := sp - 2
                                    SP := sp + 2
                                    f[5] := pc
                                    fn := S[sp - 1]
                                    if is_callable(fn) == false {
                                        not_callable(f, pc, fn)
                                    }
                                    a := call(fn, S[sp], items_of(S[sp + 1])[0:])
                                    S[sp - 1] := a
                                    pc := pc + 1
                                } else {
                                    # 96 NEWSPREAD   [f array] -> [object]
                                    sp := sp - 1
                                    SP := sp + 1
                                    f[5] := pc
                                    fn := S[sp - 1]
                                    a := construct(fn, items_of(S[sp])[0:], fn)
                                    S[sp - 1] := a
                                    pc := pc + 1
                                }
                            }
                        }
                    } else {
                        if op < 101 {
                            if op < 99 {
                                if op < 98 {
                                    # 97 CONCAT n    [v1..vn] -> [one string]
                                    n := code[pc + 1]
                                    sp := sp - n
                                    SP := sp + n
                                    f[5] := pc
                                    a := concat_strs(S[sp:sp + n])
                                    S[sp] := a
                                    sp := sp + 1
                                    pc := pc + 2
                                } else {
                                    # 98 REGEX k
                                    SP := sp
                                    e := K[code[pc + 1]]
                                    S[sp] := REGEX_NEW(e[0], e[1])
                                    sp := sp + 1
                                    pc := pc + 2
                                }
                            } else {
                                if op < 100 {
                                    # 99 TPLOBJ k    the strings of a tagged template
                                    S[sp] := template_object(K[code[pc + 1]])
                                    sp := sp + 1
                                    pc := pc + 2
                                } else {
                                    # 100 DEFCLASS s  [super? ctor] -> [ctor proto]
                                    SP := sp
                                    f[5] := pc
                                    if code[pc + 1] == 1 {
                                        a := S[sp - 1]
                                        b := def_class(a, true, S[sp - 2])
                                        S[sp - 2] := a
                                        S[sp - 1] := b
                                    } else {
                                        S[sp] := def_class(S[sp - 1], false, 0)
                                        sp := sp + 1
                                    }
                                    pc := pc + 2
                                }
                            }
                        } else {
                            if op < 103 {
                                if op < 102 {
                                    # 101 DEFMETHOD k flags  [ctor proto fn] -> [ctor proto]
                                    sp := sp - 1
                                    def_method(S[sp - 2], S[sp - 1], K[code[pc + 1]], S[sp], code[pc + 2])
                                    pc := pc + 3
                                } else {
                                    # 102 DEFMETHODEL flags  [ctor proto key fn] -> [ctor proto]
                                    sp := sp - 2
                                    SP := sp + 2
                                    def_method(S[sp - 2], S[sp - 1], to_key(S[sp]), S[sp + 1], code[pc + 1])
                                    pc := pc + 2
                                }
                            } else {
                                if op < 104 {
                                    # 103 GETSUPER k  super.k
                                    SP := sp
                                    f[5] := pc
                                    S[sp] := get_r(super_home(f), K[code[pc + 1]], f[3])
                                    sp := sp + 1
                                    pc := pc + 2
                                } else {
                                    # 104 SUPERCALL n  [a1..an] -> [this]
                                    n := code[pc + 1]
                                    sp := sp - n
                                    SP := sp + n
                                    f[5] := pc
                                    if n == 0 {
                                        a := super_call(f, [])
                                    } else {
                                        a := super_call(f, S[sp:sp + n])
                                    }
                                    S[sp] := a
                                    sp := sp + 1
                                    pc := pc + 2
                                }
                            }
                        }
                    }
                } else {
                    if op < 113 {
                        if op < 109 {
                            if op < 107 {
                                if op < 106 {
                                    # 105 SUPERCALLSPREAD  [array] -> [this]
                                    SP := sp
                                    f[5] := pc
                                    a := super_call(f, items_of(S[sp - 1])[0:])
                                    S[sp - 1] := a
                                    pc := pc + 1
                                } else {
                                    # 106 CALLEE      the function that is running
                                    S[sp] := f[4]
                                    sp := sp + 1
                                    pc := pc + 1
                                }
                            } else {
                                if op < 108 {
                                    # 107 ARGUMENTS
                                    S[sp] := new_array(f[9][0:])
                                    sp := sp + 1
                                    pc := pc + 1
                                } else {
                                    # 108 REST i      the arguments from the i-th on, as an array
                                    e := f[9]
                                    i := code[pc + 1]
                                    if i < length(e) {
                                        S[sp] := new_array(e[i:])
                                    } else {
                                        S[sp] := new_array([])
                                    }
                                    sp := sp + 1
                                    pc := pc + 2
                                }
                            }
                        } else {
                            if op < 111 {
                                if op < 110 {
                                    # 109 NEWTARGET
                                    S[sp] := f[10]
                                    sp := sp + 1
                                    pc := pc + 1
                                } else {
                                    # 110 YIELD       [v] -> stop here; the value sent in is on the stack after
                                    sp := sp - 1
                                    a := S[sp]
                                    f[5] := pc + 1
                                    f[7] := E
                                    YSTACK := S[f[12]:sp]
                                    YIELDED := 1
                                    return a
                                }
                            } else {
                                if op < 112 {
                                    # 111 AWAIT
                                    sp := sp - 1
                                    a := S[sp]
                                    f[5] := pc + 1
                                    f[7] := E
                                    YSTACK := S[f[12]:sp]
                                    YIELDED := 2
                                    return a
                                } else {
                                    # 112 OPTJ a      [v]: null or undefined, make it undefined and jump
                                    a := S[sp - 1]
                                    ta := type_of(a)
                                    if ta == 0 or (ta == 2 and a == 0) {
                                        S[sp - 1] := U
                                        pc := code[pc + 1]
                                    } else {
                                        pc := pc + 2
                                    }
                                }
                            }
                        }
                    } else {
                        if op < 117 {
                            if op < 115 {
                                if op < 114 {
                                    # 113 OPTJ2 a     [f this]: the same, looking at f
                                    a := S[sp - 2]
                                    ta := type_of(a)
                                    if ta == 0 or (ta == 2 and a == 0) {
                                        sp := sp - 1
                                        S[sp - 1] := U
                                        pc := code[pc + 1]
                                    } else {
                                        pc := pc + 2
                                    }
                                } else {
                                    # 114 SETFIELDS   [ctor proto fn] -> [ctor proto], fn sets the fields of an instance
                                    sp := sp - 1
                                    H[S[sp - 2]][3][5] := S[sp]
                                    H[S[sp]][3][4] := S[sp - 1]
                                    pc := pc + 1
                                }
                            } else {
                                if op < 116 {
                                    # 115 GETSUPEREL  [key] -> [super[key]]
                                    SP := sp
                                    f[5] := pc
                                    S[sp - 1] := get_r(super_home(f), to_key(S[sp - 1]), f[3])
                                    pc := pc + 1
                                } else {
                                    # 116 NOP
                                    pc := pc + 1
                                }
                            }
                        } else {
                            if op < 119 {
                                if op < 118 {
                                    # 117 STATICINIT  [ctor proto fn] -> [ctor proto], fn run with the class as this
                                    sp := sp - 1
                                    SP := sp + 1
                                    f[5] := pc
                                    H[S[sp]][3][4] := S[sp - 2]
                                    call(S[sp], S[sp - 2], [])
                                    pc := pc + 1
                                } else {
                                    # 118 ROT3        [a b c] -> [b c a]
                                    a := S[sp - 3]
                                    S[sp - 3] := S[sp - 2]
                                    S[sp - 2] := S[sp - 1]
                                    S[sp - 1] := a
                                    pc := pc + 1
                                }
                            } else {
                                if op < 120 {
                                    # 119 SETPROTO    [o v] -> [o], __proto__ in a literal
                                    sp := sp - 1
                                    set_proto_of(S[sp - 1], S[sp])
                                    pc := pc + 1
                                } else {
                                    if op < 121 {
                                        # 120 THROWCONST  assignment to a constant
                                        SP := sp
                                        f[5] := pc
                                        throw_type("Assignment to constant variable.")
                                    } else {
                                        # 121 TOKEY       [v] -> [the property key it names]
                                        a := S[sp - 1]
                                        if type_of(a) != 4 {
                                            SP := sp
                                            S[sp - 1] := to_key(a)
                                        }
                                        pc := pc + 1
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# An error got out of exec(): find the try that takes it, in the
# frames this run() owns, and set the machine to go on there. If there
# is none, the error goes on to whoever called run().
proc recover(e, base) {
    if THROWN == false {
        caught(e)
    }
    THROWN := false
    loop true {
        alloc f := CUR
        alloc n := f[13]
        if n > 0 {
            n := n - 1
            f[13] := n
            alloc h := f[8][n]
            f[5] := h[0]
            f[7] := h[2]
            alloc sp := f[12] + h[1]
            S[sp] := EXC
            SP := sp + 1
            return true
        }
        if FP <= base {
            THROWN := true
            raise("js")
        }
        FP := FP - 1
        CUR := FR[FP]
    }
}

proc run(base) {
    loop true {
        alloc ok := false
        alloc v := U
        try {
            v := exec(base)
            ok := true
        } except e {
            recover(e, base)
        }
        if ok {
            return v
        }
    }
}

# Run the template of a whole script.
proc run_script(t) {
    alloc fn := new_obj(2, FUNCTION_PROTO)
    alloc x := [0, t, false, U, 0, 0, false]
    H[fn][3] := x
    return invoke(fn, x, t, GLOBAL, [], U, 0)
}

# A function value from a template, closed over nothing.
proc closure_of(t) {
    alloc fn := new_obj(2, FUNCTION_PROTO)
    H[fn][3] := [0, t, false, U, 0, 0, false]
    return fn
}

# --- the start --------------------------------------------------------------------------------

alloc I_LIST_ITER_PROTO := 25

# A new, empty world: a heap with the objects everything else hangs
# from. The library files then fill them.
proc init() {
    # H and I are emptied, not made anew: the library files hold on to them
    FREE := []
    alloc k := length(H) - 1
    NFREE := k
    loop k >= 1 {
        H[k] := 0
        append(FREE, k)
        k := k - 1
    }
    k := 0
    loop k < 64 {
        I[k] := 0
        k := k + 1
    }
    ALLOCS := 0
    SP := 0
    FR := []
    FP := 0
    CUR := false
    EXC := 0
    THROWN := false
    RESUME_THROW := false
    YIELDED := 0
    TPL_ROOTS := []
    SYM_OF := {}
    OBJECT_PROTO := new_obj(0, 0)
    H[OBJECT_PROTO][4] := 4
    I[1] := OBJECT_PROTO
    alloc i := 2
    loop i <= 31 {
        if i != 20 {
            alloc h := new_obj(0, OBJECT_PROTO)
            H[h][4] := 4
            I[i] := h
        }
        i := i + 1
    }
    for sub in [9, 10, 11, 12, 21, 22] {
        H[I[sub]][1] := I[8]
    }
    H[I[14]][1] := I[13]
    H[I[25]][1] := I[13]
    FUNCTION_PROTO := I[2]
    ARRAY_PROTO := I[3]
    STRING_PROTO := I[4]
    NUMBER_PROTO := I[5]
    BOOLEAN_PROTO := I[6]
    SYMBOL_PROTO := I[7]
    GLOBAL := new_obj(0, OBJECT_PROTO)
    I[0] := GLOBAL
    def(I[13], "@@iterator", n_iter_self, 0)
    def(I[25], "next", n_iter_next, 0)
    def(I[14], "next", n_gen_next, 1)
    def(I[14], "throw", n_gen_throw, 1)
    def(I[14], "return", n_gen_return, 1)
    return true
}

proc global_object() {
    return GLOBAL
}

proc intrinsic(i) {
    return I[i]
}

proc undefined() {
    return U
}

# Everything here that the library files use, as values they can call
# at the cost of a call inside this file (a call through the name of
# an imported file costs seven times as much). The lists are the ones
# this file works on: H the heap, I the intrinsic objects.
proc exports() {
    return {
        H: H, I: I,
        heap: heap, arg: arg, new_obj: new_obj, intrinsics: intrinsics,
        set_host_hooks: set_host_hooks, set_promise_hooks: set_promise_hooks,
        set_regex_hook: set_regex_hook, set_compile_hook: set_compile_hook,
        new_target: new_target, native_fn: native_fn, nan: nan, inf: inf, is_obj: is_obj,
        is_nullish: is_nullish, is_callable: is_callable, is_array: is_array,
        class_of: class_of, num_to_str: num_to_str, num_key: num_key,
        is_space_byte: is_space_byte, str_to_num: str_to_num, typeof_str: typeof_str,
        to_bool: to_bool, to_num: to_num, to_str: to_str, to_key: to_key,
        to_integer: to_integer, wrap32: wrap32, to_int32: to_int32, to_uint32: to_uint32,
        floor_f: floor_f, trunc_f: trunc_f, rel_index: rel_index, line_of: line_of,
        stack_trace: stack_trace, make_error: make_error, throw_val: throw_val,
        throw_type: throw_type, throw_range: throw_range, throw_ref: throw_ref,
        throw_syntax: throw_syntax, throw_error: throw_error, caught: caught, show: show,
        describe: describe, index_of_key: index_of_key, func_name: func_name,
        func_prop: func_prop, get_r: get_r, get: get, getv: getv, get_elem: get_elem,
        arr_set: arr_set, arr_set_length: arr_set_length, put_r: put_r, put: put, putv: putv,
        put_elem: put_elem, define: define, hide: hide, define_hidden: define_hidden,
        define_accessor: define_accessor, has_own: has_own, has_prop: has_prop,
        own_raw: own_raw, delete_prop: delete_prop, note_symbol: note_symbol,
        key_value: key_value, trap_of: trap_of, unproxy: unproxy,
        f32_bits: f32_bits, f32_value: f32_value, bytes_num: bytes_num, num_bytes: num_bytes,
        ta_get: ta_get, ta_set: ta_set, is_symbol_key: is_symbol_key,
        own_keys: own_keys, enum_keys: enum_keys, new_object: new_object, new_array: new_array,
        items_of: items_of, new_native: new_native, new_native_with: new_native_with,
        native_data: native_data, def: def, str_join: str_join, def_ctor: def_ctor,
        array_like_list: array_like_list, def_getter: def_getter, def_setter: def_setter,
        new_symbol: new_symbol, invoke: invoke, new_coroutine: new_coroutine,
        co_resume: co_resume, async_step: async_step, call: call, call0: call0, call1: call1,
        construct: construct, ctor_result: ctor_result, to_prim: to_prim, to_object: to_object,
        add_slow: add_slow, lt_slow: lt_slow, le_slow: le_slow, strict_eq: strict_eq,
        same_value: same_value, loose_eq: loose_eq, is_neg_zero: is_neg_zero, div_f: div_f,
        div_slow: div_slow, mod_f: mod_f, mod_slow: mod_slow, pow_f: pow_f,
        instance_of: instance_of, has_in: has_in, get_global: get_global, make_iter: make_iter,
        iter_step: iter_step, iter_list: iter_list, iter_result: iter_result,
        new_iter_object: new_iter_object, n_iter_next: n_iter_next, n_iter_self: n_iter_self,
        gen_resume: gen_resume, n_gen_next: n_gen_next, n_gen_throw: n_gen_throw,
        n_gen_return: n_gen_return, make_closure: make_closure, def_class: def_class,
        def_method: def_method, super_call: super_call, super_home: super_home,
        copy_props: copy_props, template_object: template_object, concat_strs: concat_strs,
        delete_elem: delete_elem, typeof_global: typeof_global, set_proto_of: set_proto_of,
        not_callable: not_callable, run_script: run_script, closure_of: closure_of, init: init,
        global_object: global_object, intrinsic: intrinsic, undefined: undefined
    }
}
