;;;omg

# tools/video/h264.omg
#
# An H.264 (AVC) video decoder.
#
#     import "h264.omg" as h264
#     h264.reset()
#     h264.set_config(avcc_bytes)          # the avcC box of an MP4 file
#     alloc pic := h264.decode(sample)     # one MP4 sample -> a picture, or false
#     ...
#     h264.release(pic)
#
# What it decodes: progressive 8-bit 4:2:0 streams of the Baseline
# profile: I and P slices, CAVLC, any number of reference frames and
# slices per picture, the in-loop deblocking filter. Anything else is
# refused with an error that says what was met.
#
# A picture is three flat lists of numbers, one per plane, in pic.y,
# pic.u and pic.v; the sizes are in info().
#
# Everything is in this one file on purpose: a call into another module
# goes through a name lookup, and the procs here call each other a few
# million times a second.

# === Tables of the standard ==================================================

# Zigzag scan: the raster position (x + 4 * y) of the k-th coefficient.
alloc ZZ := [0, 1, 4, 8, 5, 2, 3, 6, 9, 12, 13, 10, 7, 11, 14, 15]

# 4x4 blocks are coded in this order: the position of the n-th, in blocks.
alloc BLK_X := [0, 1, 0, 1, 2, 3, 2, 3, 0, 1, 0, 1, 2, 3, 2, 3]
alloc BLK_Y := [0, 0, 1, 1, 0, 0, 1, 1, 2, 2, 3, 3, 2, 2, 3, 3]
# The reverse: the coding number of the block at x + 4 * y.
alloc BLK_N := [0, 1, 4, 5, 2, 3, 6, 7, 8, 9, 12, 13, 10, 11, 14, 15]

# Dequantisation: the three multipliers for each qp % 6.
alloc DQ_V := [10, 16, 13, 11, 18, 14, 13, 20, 16, 14, 23, 18, 16, 25, 20, 18, 29, 23]
# Which of the three a raster position uses.
alloc DQ_CLASS := [0, 2, 0, 2, 2, 1, 2, 1, 0, 2, 0, 2, 2, 1, 2, 1]

# Chroma qp for a luma qp (after the offset), from 30 up.
alloc CQP_HIGH := [29, 30, 31, 32, 32, 33, 34, 34, 35, 35, 36, 36, 37, 37, 37, 38, 38, 38, 39, 39, 39, 39]

alloc DEFAULT_4X4_INTRA := [6, 13, 13, 20, 20, 20, 28, 28, 28, 28, 32, 32, 32, 37, 37, 42]
alloc DEFAULT_4X4_INTER := [10, 14, 14, 20, 20, 20, 24, 24, 24, 24, 27, 27, 27, 30, 30, 34]

# coeff_token: code length and code bits for (total coefficients * 4 +
# trailing ones), for the three ranges of the context nC.
