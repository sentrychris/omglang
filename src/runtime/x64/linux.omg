
# runtime/x64/linux.omg
#
# The operating system layer of the runtime for Linux on x86-64: the
# os_* procs the rest of the runtime is written against, on top of
# system calls made directly. Raw mode, the last file of the runtime
# unit (see core.omg). Nothing here goes through a C library.
#
# A system call returns a negative errno, -1 to -4095, when it fails.

alloc SYS_READ := 0
alloc SYS_WRITE := 1
alloc SYS_OPEN := 2
alloc SYS_CLOSE := 3
alloc SYS_STAT := 4
alloc SYS_LSEEK := 8
alloc SYS_POLL := 7
alloc SYS_MMAP := 9
alloc SYS_MUNMAP := 11
alloc SYS_RT_SIGACTION := 13
alloc SYS_RT_SIGPROCMASK := 14
alloc SYS_IOCTL := 16
alloc SYS_DUP2 := 33
alloc SYS_NANOSLEEP := 35
alloc SYS_GETPID := 39
alloc SYS_SOCKET := 41
alloc SYS_CONNECT := 42
alloc SYS_ACCEPT := 43
alloc SYS_SENDTO := 44
alloc SYS_BIND := 49
alloc SYS_LISTEN := 50
alloc SYS_GETPEERNAME := 52
alloc SYS_SETSOCKOPT := 54
alloc SYS_FORK := 57
alloc SYS_EXECVE := 59
alloc SYS_WAIT4 := 61
alloc SYS_FCNTL := 72
alloc SYS_GETCWD := 79
alloc SYS_MKDIR := 83
alloc SYS_READLINK := 89
alloc SYS_CHMOD := 90
alloc SYS_GETRLIMIT := 97
alloc SYS_GETUID := 102
alloc SYS_SETSID := 112
alloc SYS_SETRLIMIT := 160
alloc SYS_GETDENTS64 := 217
alloc SYS_CLOCK_GETTIME := 228
alloc SYS_EXIT_GROUP := 231
alloc SYS_SIGNALFD4 := 289
alloc SYS_PIPE2 := 293

alloc ENOENT := 2
alloc EINTR := 4
alloc EAGAIN := 11
alloc EACCES := 13
alloc EEXIST := 17
alloc ENOTDIR := 20
alloc E_NO_HOST := 1000        # ours: a host name that cannot be resolved

alloc O_CREAT := 64
alloc O_NOCTTY := 256
alloc O_TRUNC := 512
alloc O_APPEND := 1024
alloc O_NONBLOCK := 2048
alloc O_DIRECTORY := 65536
alloc O_CLOEXEC := 524288

alloc TCGETS := 21505
alloc TCSETS := 21506
alloc TIOCSCTTY := 21518
alloc TIOCSWINSZ := 21524
alloc TIOCGPTN := 2147767344
alloc TIOCSPTLCK := 1074025521

alloc os_nargs := 0
alloc os_argv := 0
alloc os_envp := 0

proc os_sys1(n, a) {
    return __syscall(n, a, 0, 0, 0, 0, 0)
}

proc os_sys2(n, a, b) {
    return __syscall(n, a, b, 0, 0, 0, 0)
}

proc os_sys3(n, a, b, c) {
    return __syscall(n, a, b, c, 0, 0, 0)
}

# Did a system call fail?
proc os_failed(r) {
    return r < 0 and r > -4096
}

proc os_exit(code) {
    if os_raw_on {
        os_set_raw(0)
    }
    os_sys1(SYS_EXIT_GROUP, code)
    return 0
}

# Write all n bytes at p, however many calls that takes. Returns 0, or
# the negative errno that stopped it.
proc os_write_all(fd, p, n) {
    loop n > 0 {
        alloc r := os_sys3(SYS_WRITE, fd, p, n)
        if r < 0 {
            if r != 0 - EINTR {
                return r
            }
        } else {
            p := p + r
            n := n - r
        }
    }
    return 0
}

proc os_die(text) {
    os_write_all(2, text + S_DATA, __peek64(text + S_BYTES))
    return os_exit(1)
}

# Whole pages from the system, zero-filled. `size` is a multiple of 4096.
proc os_alloc(size) {
    # PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS
    alloc p := __syscall(SYS_MMAP, 0, size, 3, 34, -1, 0)
    if os_failed(p) {
        os_die("out of memory\n")
    }
    return p
}

proc os_free(p, size) {
    os_sys2(SYS_MUNMAP, p, size)
    return 0
}

# Called first of all. The entry code left the initial stack pointer in
# rt_entry_rsp; the kernel put the argument count there, then the
# argument pointers, a null, and the environment pointers.
proc os_init() {
    alloc sp := rt_entry_rsp
    os_nargs := __peek64(sp)
    os_argv := sp + 8
    os_envp := os_argv + (os_nargs + 1) * 8

    # The stack grows on demand up to the soft limit in force at the
    # time, so a small limit is first raised to 64 MiB, the depth the
    # other ways of running a program allow. Generated code compares
    # the stack pointer with rt_stack_limit on entry to every proc and
    # raises an ordinary error in time.
    alloc size := 8388608
    alloc buf := os_alloc(4096)
    if os_sys2(SYS_GETRLIMIT, 3, buf) == 0 {
        alloc cur := __peek64(buf)
        alloc max := __peek64(buf + 8)
        alloc want := 67108864
        if cur != -1 and __ult(cur, want) {
            alloc to := want
            if max != -1 and __ult(max, want) {
                to := max
            }
            __poke64(buf, to)
            if os_sys2(SYS_SETRLIMIT, 3, buf) == 0 {
                cur := to
            }
        }
        if cur == -1 {
            size := 268435456
        } else {
            size := cur
        }
    }
    os_free(buf, 4096)
    # Room for the environment above the first frame, and for the
    # frames that format and report the error.
    alloc reserve := 1048576
    if size < 4194304 {
        reserve := size >> 2
    }
    rt_stack_limit := sp - size + reserve
    return 0
}

proc os_argc() {
    return os_nargs
}

# Argument i as an owned string.
proc os_arg(i) {
    return rt_str_from_c(__peek64(os_argv + i * 8))
}

# The working directory as an owned string.
proc os_getcwd() {
    alloc buf := rt_alloc(4096)
    alloc r := os_sys2(SYS_GETCWD, buf, 4096)
    alloc s := "."
    if os_failed(r) == 0 {
        s := rt_str_from_c(buf)
    }
    rt_free(buf, 4096)
    return s
}

# --- files -----------------------------------------------------------------

# What the system says about error `code`.
proc os_err_text(code) {
    if code == 1 { return "Operation not permitted" }
    if code == 2 { return "No such file or directory" }
    if code == 4 { return "Interrupted system call" }
    if code == 5 { return "Input/output error" }
    if code == 8 { return "Exec format error" }
    if code == 9 { return "Bad file descriptor" }
    if code == 11 { return "Resource temporarily unavailable" }
    if code == 12 { return "Cannot allocate memory" }
    if code == 13 { return "Permission denied" }
    if code == 17 { return "File exists" }
    if code == 20 { return "Not a directory" }
    if code == 21 { return "Is a directory" }
    if code == 22 { return "Invalid argument" }
    if code == 24 { return "Too many open files" }
    if code == 25 { return "Inappropriate ioctl for device" }
    if code == 26 { return "Text file busy" }
    if code == 28 { return "No space left on device" }
    if code == 30 { return "Read-only file system" }
    if code == 32 { return "Broken pipe" }
    if code == 36 { return "File name too long" }
    if code == 39 { return "Directory not empty" }
    if code == 40 { return "Too many levels of symbolic links" }
    if code == 98 { return "Address already in use" }
    if code == 99 { return "Cannot assign requested address" }
    if code == 101 { return "Network is unreachable" }
    if code == 104 { return "Connection reset by peer" }
    if code == 110 { return "Connection timed out" }
    if code == 111 { return "Connection refused" }
    if code == 113 { return "No route to host" }
    if code == E_NO_HOST { return "cannot resolve the host name" }
    return "error"
}

proc os_is_abs(path) {
    return __peek8(path + S_DATA) == 47
}

# Open a file: kind 0 to read, 1 to write from empty, 2 to append,
# 3 to read and write, 4 to read and write from empty. Returns the
# descriptor or a negative errno.
proc os_open(path, kind) {
    alloc flags := 0
    if kind == 1 { flags := 1 | O_CREAT | O_TRUNC }
    if kind == 2 { flags := 1 | O_CREAT | O_APPEND }
    if kind == 3 { flags := 2 }
    if kind == 4 { flags := 2 | O_CREAT | O_TRUNC }
    return os_sys3(SYS_OPEN, path + S_DATA, flags, 438)
}

proc os_close(fd) {
    return os_sys1(SYS_CLOSE, fd)
}

# Read up to n bytes: the count, 0 at the end, or a negative errno.
proc os_read(fd, p, n) {
    loop true {
        alloc r := os_sys3(SYS_READ, fd, p, n)
        if r != 0 - EINTR {
            return r
        }
    }
    return 0
}

proc os_stdin_read(p, n) {
    return os_read(0, p, n)
}

proc os_seek(fd, off) {
    return os_sys3(SYS_LSEEK, fd, off, 0)
}

proc os_tell(fd) {
    return os_sys3(SYS_LSEEK, fd, 0, 1)
}

# The st_mode of a path, or -1 when there is nothing there.
proc os_mode(cpath) {
    alloc buf := rt_alloc(160)
    alloc r := os_sys2(SYS_STAT, cpath, buf)
    alloc mode := -1
    if r == 0 {
        mode := __peek32(buf + 24)
    }
    rt_free(buf, 160)
    return mode
}

# The size of a path in bytes and the time it was last written, in
# milliseconds since 1970, into the two words at `out`. Returns 0, or a
# negative errno.
proc os_stat(path, out) {
    alloc buf := rt_alloc(160)
    alloc r := os_sys2(SYS_STAT, path + S_DATA, buf)
    if r == 0 {
        __poke64(out, __peek64(buf + 48))
        __poke64(out + 8, __peek64(buf + 88) * 1000 + __peek64(buf + 96) // 1000000)
    }
    rt_free(buf, 160)
    return r
}

proc os_exists(path) {
    return os_mode(path + S_DATA) >= 0
}

proc os_is_dir(path) {
    alloc mode := os_mode(path + S_DATA)
    return mode >= 0 and (mode & 61440) == 16384
}

# Append the names in a directory to `list`, leaving out . and ..
proc os_list_dir(path, list) {
    alloc fd := os_sys3(SYS_OPEN, path + S_DATA, O_DIRECTORY, 0)
    if fd < 0 {
        return fd
    }
    alloc buf := rt_alloc(32768)
    alloc result := 0
    loop true {
        alloc n := os_sys3(SYS_GETDENTS64, fd, buf, 32768)
        if n <= 0 {
            result := n
            break
        }
        alloc at := 0
        loop at < n {
            alloc ent := buf + at
            alloc name := ent + 19
            alloc dot := __peek8(name) == 46
            alloc skip := dot and (__peek8(name + 1) == 0 or (__peek8(name + 1) == 46 and __peek8(name + 2) == 0))
            if skip == 0 {
                rt_list_push(list, T_STR, rt_str_from_c(name))
            }
            at := at + __peek16(ent + 16)
        }
    }
    rt_free(buf, 32768)
    os_close(fd)
    return result
}

# Create one directory; one that is already there is not an error.
proc os_mkdir(cpath) {
    alloc r := os_sys2(SYS_MKDIR, cpath, 511)
    if r == 0 - EEXIST {
        alloc mode := os_mode(cpath)
        if mode >= 0 and (mode & 61440) == 16384 {
            return 0
        }
    }
    return r
}

proc os_chmod(path, mode) {
    return os_sys2(SYS_CHMOD, path + S_DATA, mode)
}

# --- the process and the clock ------------------------------------------------

proc os_platform() {
    return "linux-x64"
}

proc os_getpid() {
    return os_sys1(SYS_GETPID, 0)
}

# The path of the running program, or 0.
proc os_exe_path() {
    alloc buf := rt_alloc(4096)
    alloc n := os_sys3(SYS_READLINK, "/proc/self/exe" + S_DATA, buf, 4095)
    alloc s := 0
    if n > 0 {
        s := rt_str_from(buf, n)
    }
    rt_free(buf, 4096)
    return s
}

# Milliseconds since 1970.
proc os_time_ms() {
    alloc ts := rt_alloc(16)
    os_sys2(SYS_CLOCK_GETTIME, 0, ts)
    alloc ms := __peek64(ts) * 1000 + __peek64(ts + 8) // 1000000
    rt_free(ts, 16)
    return ms
}

proc os_sleep_ms(ms) {
    alloc ts := rt_alloc(16)
    __poke64(ts, ms // 1000)
    __poke64(ts + 8, (ms % 1000) * 1000000)
    # An interrupted sleep leaves what remains in the same place.
    loop os_sys2(SYS_NANOSLEEP, ts, ts) == 0 - EINTR {
    }
    rt_free(ts, 16)
    return 0
}

# The value of an environment variable as a C string, or 0. `name` is
# a string that ends with "=".
proc os_getenv(name) {
    alloc n := __peek64(name + S_BYTES)
    alloc p := os_envp
    loop __peek64(p) != 0 {
        if __memcmp(__peek64(p), name + S_DATA, n) == 0 {
            return __peek64(p) + n
        }
        p := p + 8
    }
    return 0
}

proc os_cstr_len(p) {
    alloc n := 0
    loop __peek8(p + n) != 0 {
        n := n + 1
    }
    return n
}

# Replace this process with the program argv[0], looked for along PATH
# when it is not a path itself. Returns only on failure, with the
# negative errno.
proc os_execvp(argv, envp) {
    alloc file := __peek64(argv)
    alloc flen := os_cstr_len(file)
    alloc i := 0
    loop i < flen {
        if __peek8(file + i) == 47 {
            return os_sys3(SYS_EXECVE, file, argv, envp)
        }
        i := i + 1
    }
    alloc path := os_getenv("PATH=")
    if path == 0 {
        path := "/usr/local/bin:/usr/bin:/bin" + S_DATA
    }
    alloc result := 0 - ENOENT
    alloc buf := rt_alloc(4096 + flen + 2)
    loop true {
        alloc n := 0
        loop __peek8(path + n) != 0 and __peek8(path + n) != 58 {
            n := n + 1
        }
        if n > 0 and n < 4096 {
            __memcpy(buf, path, n)
            __poke8(buf + n, 47)
            __memcpy(buf + n + 1, file, flen + 1)
            alloc r := os_sys3(SYS_EXECVE, buf, argv, envp)
            if r == 0 - EACCES {
                result := r
            } elif r != 0 - ENOENT and r != 0 - ENOTDIR {
                return r
            }
        }
        if __peek8(path + n) == 0 {
            break
        }
        path := path + n + 1
    }
    return result
}

# Run argv as a child and wait for it. Returns its exit code (128 + the
# signal number when a signal ended it, -1 when it cannot be told); when
# it could not be started, rt_spawn_error is set to the errno.
proc os_subprocess(list, argv) {
    # A pipe that closes by itself when the child starts its program
    # tells the parent whether that worked.
    alloc mem := rt_alloc(16)
    alloc r := os_sys2(SYS_PIPE2, mem, O_CLOEXEC)
    if r < 0 {
        rt_free(mem, 16)
        rt_spawn_error := 0 - r
        return -1
    }
    alloc rd := __peek32(mem)
    alloc wr := __peek32(mem + 4)
    alloc pid := os_sys1(SYS_FORK, 0)
    if pid < 0 {
        os_close(rd)
        os_close(wr)
        rt_free(mem, 16)
        rt_spawn_error := 0 - pid
        return -1
    }
    if pid == 0 {
        os_close(rd)
        os_sig_release()
        alloc e := os_execvp(argv, os_envp)
        __poke32(mem, 0 - e)
        os_sys3(SYS_WRITE, wr, mem, 4)
        os_sys1(SYS_EXIT_GROUP, 127)
    }
    os_close(wr)
    alloc exec_errno := 0
    if os_read(rd, mem, 4) == 4 {
        exec_errno := __peek32(mem)
    }
    os_close(rd)
    __poke32(mem + 8, 0)
    loop __syscall(SYS_WAIT4, pid, mem + 8, 0, 0, 0, 0) == 0 - EINTR {
    }
    alloc status := __peek32(mem + 8)
    rt_free(mem, 16)
    if exec_errno != 0 {
        rt_spawn_error := exec_errno
        return -1
    }
    alloc sig := status & 127
    if sig == 0 {
        return (status >> 8) & 255
    }
    if sig != 127 {
        return 128 + sig
    }
    return -1
}

alloc os_reaping := 0

# fork(): 0 in the child, the child's id in the parent. Children are
# not waited for, so the system is told to clear them away itself.
proc os_fork() {
    if os_reaping == 0 {
        os_reaping := 1
        alloc act := rt_alloc(32)
        __memset(act, 0, 32)
        __poke64(act, 1)                     # SIG_IGN
        __syscall(SYS_RT_SIGACTION, 17, act, 0, 8, 0, 0)    # SIGCHLD
        rt_free(act, 32)
    }
    return os_sys1(SYS_FORK, 0)
}

# --- requests to stop ------------------------------------------------------------
#
# SIGINT (Ctrl-C) and SIGTERM. Once the program has asked, the two are
# held back from their usual effect and collected through a descriptor
# instead, which costs no handler code and lets os_poll_wait wake up for
# them like for any socket.

alloc SIG_STOP_MASK := 16386   # bit (n - 1) for signals 2 and 15
alloc os_sigfd := 0            # the descriptor + 1, once asked for
alloc os_sig_count := 0

proc os_interrupts() {
    alloc mem := rt_alloc(128)
    if os_sigfd == 0 {
        __poke64(mem, SIG_STOP_MASK)
        __syscall(SYS_RT_SIGPROCMASK, 0, mem, 0, 8, 0, 0)      # SIG_BLOCK
        alloc fd := __syscall(SYS_SIGNALFD4, -1, mem, 8, O_NONBLOCK | O_CLOEXEC, 0, 0)
        if fd < 0 {
            # No such descriptor to be had: leave the signals alone.
            __syscall(SYS_RT_SIGPROCMASK, 1, mem, 0, 8, 0, 0)
            fd := -2
        }
        os_sigfd := fd + 1
    }
    # One 128-byte record for each signal that has arrived.
    loop os_sigfd > 0 and os_sys3(SYS_READ, os_sigfd - 1, mem, 128) == 128 {
        os_sig_count := os_sig_count + 1
    }
    rt_free(mem, 128)
    return os_sig_count
}

# In a child about to become another program: give it the usual
# meaning of the signals back.
proc os_sig_release() {
    if os_sigfd > 0 {
        alloc mem := rt_alloc(16)
        __poke64(mem, SIG_STOP_MASK)
        __syscall(SYS_RT_SIGPROCMASK, 1, mem, 0, 8, 0, 0)      # SIG_UNBLOCK
        rt_free(mem, 16)
    }
    return 0
}

# --- the terminal ------------------------------------------------------------

alloc os_raw_on := 0
alloc os_termios := 0          # the settings found, to put back

# Raw mode: no line editing, no echo, no signal keys, no flow control,
# and a read that returns at once when no key is waiting.
proc os_set_raw(on) {
    alloc t := rt_alloc(64)
    alloc r := os_sys3(SYS_IOCTL, 0, TCGETS, t)
    if r < 0 {
        rt_free(t, 64)
        return r
    }
    if on {
        if os_termios == 0 {
            os_termios := rt_alloc(64)
            __memcpy(os_termios, t, 64)
        }
        __poke32(t + 12, __peek32(t + 12) & ~11)        # ICANON | ECHO | ISIG
        __poke32(t, __peek32(t) & ~1024)                # IXON
        __poke8(t + 22, 0)                              # VTIME
        __poke8(t + 23, 0)                              # VMIN
    } elif os_termios != 0 {
        __memcpy(t, os_termios, 64)
    } else {
        __poke32(t + 12, __peek32(t + 12) | 11)
        __poke32(t, __peek32(t) | 1024)
    }
    r := os_sys3(SYS_IOCTL, 0, TCSETS, t)
    rt_free(t, 64)
    if r < 0 {
        return r
    }
    os_raw_on := on
    return 0
}

# One byte from standard input, or -1 when none is to be had.
proc os_read_key() {
    alloc buf := rt_alloc(16)
    alloc r := os_sys3(SYS_READ, 0, buf, 1)
    alloc c := -1
    if r == 1 {
        c := __peek8(buf)
    }
    rt_free(buf, 16)
    return c
}

# --- pseudo-terminals --------------------------------------------------------------

# Start argv on a new pseudo-terminal; returns the descriptor of our
# end of it, set not to block, or a negative errno.
proc os_pty_spawn(list, argv) {
    alloc master := os_sys3(SYS_OPEN, "/dev/ptmx" + S_DATA, 2 | O_NOCTTY, 0)
    if master < 0 {
        return master
    }
    alloc mem := rt_alloc(16)
    __poke32(mem, 0)
    os_sys3(SYS_IOCTL, master, TIOCSPTLCK, mem)
    alloc r := os_sys3(SYS_IOCTL, master, TIOCGPTN, mem)
    alloc number := __peek32(mem)
    rt_free(mem, 16)
    if r < 0 {
        os_close(master)
        return r
    }
    alloc b := rt_buf_new()
    rt_buf_str(b, "/dev/pts/")
    rt_buf_int(b, number)
    alloc name := rt_buf_finish(b)
    # The child's environment: ours, with TERM set.
    alloc count := 0
    loop __peek64(os_envp + count * 8) != 0 {
        count := count + 1
    }
    alloc envp := rt_alloc(8 * (count + 2))
    alloc k := 0
    alloc i := 0
    loop i < count {
        alloc ent := __peek64(os_envp + i * 8)
        if __memcmp(ent, "TERM=" + S_DATA, 5) != 0 {
            __poke64(envp + k * 8, ent)
            k := k + 1
        }
        i := i + 1
    }
    __poke64(envp + k * 8, "TERM=xterm-256color" + S_DATA)
    __poke64(envp + (k + 1) * 8, 0)
    alloc pid := os_sys1(SYS_FORK, 0)
    if pid == 0 {
        os_sig_release()
        os_sys1(SYS_SETSID, 0)
        alloc slave := os_sys3(SYS_OPEN, name + S_DATA, 2, 0)
        if slave < 0 {
            os_sys1(SYS_EXIT_GROUP, 127)
        }
        os_sys3(SYS_IOCTL, slave, TIOCSCTTY, 0)
        os_sys2(SYS_DUP2, slave, 0)
        os_sys2(SYS_DUP2, slave, 1)
        os_sys2(SYS_DUP2, slave, 2)
        if slave > 2 {
            os_close(slave)
        }
        os_close(master)
        os_execvp(argv, envp)
        os_sys1(SYS_EXIT_GROUP, 127)
    }
    rt_free(envp, 8 * (count + 2))
    rt_drop(T_STR, name)
    if pid < 0 {
        os_close(master)
        return pid
    }
    alloc fl := os_sys3(SYS_FCNTL, master, 3, 0)
    os_sys3(SYS_FCNTL, master, 4, fl | O_NONBLOCK)
    return master
}

# What the program wrote: the byte count, 0 when there is nothing new,
# -1 once it has gone.
proc os_pty_read(fd, buf, n) {
    alloc r := os_sys3(SYS_READ, fd, buf, n)
    if r > 0 {
        return r
    }
    if r == 0 - EAGAIN {
        return 0
    }
    return -1
}

proc os_pty_write(fd, p, n) {
    return os_sys3(SYS_WRITE, fd, p, n)
}

proc os_pty_close(fd) {
    return os_close(fd)
}

proc os_pty_resize(fd, rows, cols) {
    alloc ws := rt_alloc(16)
    __poke16(ws, rows)
    __poke16(ws + 2, cols)
    __poke32(ws + 4, 0)
    os_sys3(SYS_IOCTL, fd, TIOCSWINSZ, ws)
    rt_free(ws, 16)
    return 0
}

# --- TCP -------------------------------------------------------------------------
#
# IPv4 only, and without a C library there is no name service: a host
# is a dotted address, "localhost", or a name listed in /etc/hosts.

# Parse a dotted address of n bytes at p into the 4 bytes at `out`.
proc os_parse_ipv4(p, n, out) {
    alloc part := 0
    alloc i := 0
    loop part < 4 {
        alloc v := 0
        alloc digits := 0
        loop i < n and __peek8(p + i) >= 48 and __peek8(p + i) <= 57 and digits < 4 {
            v := v * 10 + (__peek8(p + i) - 48)
            digits := digits + 1
            i := i + 1
        }
        if digits == 0 or v > 255 {
            return 0
        }
        __poke8(out + part, v)
        part := part + 1
        if part < 4 {
            if i >= n or __peek8(p + i) != 46 {
                return 0
            }
            i := i + 1
        }
    }
    return i == n
}

# Look a name up in /etc/hosts; fills in `out` and returns 1 if found.
proc os_hosts_lookup(host, out) {
    alloc fd := os_sys3(SYS_OPEN, "/etc/hosts" + S_DATA, 0, 0)
    if fd < 0 {
        return 0
    }
    alloc b := rt_read_all(fd)
    os_close(fd)
    alloc data := __peek64(b)
    alloc size := __peek64(b + 8)
    alloc hn := __peek64(host + S_BYTES)
    alloc found := 0
    alloc at := 0
    loop at < size and found == 0 {
        alloc end := at
        loop end < size and __peek8(data + end) != 10 {
            end := end + 1
        }
        # One line: an address, then names, up to any '#'.
        alloc i := at
        loop i < end and rt_is_space(__peek8(data + i)) == 0 and __peek8(data + i) != 35 {
            i := i + 1
        }
        alloc addr_end := i
        loop i < end and __peek8(data + i) != 35 and found == 0 {
            loop i < end and rt_is_space(__peek8(data + i)) {
                i := i + 1
            }
            alloc start := i
            loop i < end and rt_is_space(__peek8(data + i)) == 0 and __peek8(data + i) != 35 {
                i := i + 1
            }
            if i - start == hn and hn > 0 and __memcmp(data + start, host + S_DATA, hn) == 0 {
                found := os_parse_ipv4(data + at, addr_end - at, out)
            }
        }
        at := end + 1
    }
    rt_free(data, __peek64(b + 16))
    rt_free(b, 24)
    return found
}

# A 16-byte IPv4 socket address for host and port, or 0.
proc os_sockaddr(host, port) {
    alloc sa := rt_alloc(16)
    __memset(sa, 0, 16)
    __poke16(sa, 2)                              # AF_INET
    __poke8(sa + 2, port >> 8)
    __poke8(sa + 3, port & 255)
    alloc n := __peek64(host + S_BYTES)
    if n == 0 {
        return sa
    }
    if os_parse_ipv4(host + S_DATA, n, sa + 4) {
        return sa
    }
    if rt_str_eq(host, "localhost") {
        __poke8(sa + 4, 127)
        __poke8(sa + 7, 1)
        return sa
    }
    if os_hosts_lookup(host, sa + 4) {
        return sa
    }
    rt_free(sa, 16)
    return 0
}

proc os_tcp_listen(host, port) {
    alloc sa := os_sockaddr(host, port)
    if sa == 0 {
        return 0 - E_NO_HOST
    }
    alloc s := os_sys3(SYS_SOCKET, 2, 1, 0)
    if s >= 0 {
        alloc one := rt_alloc(16)
        __poke32(one, 1)
        __syscall(SYS_SETSOCKOPT, s, 1, 2, one, 4, 0)       # SO_REUSEADDR
        rt_free(one, 16)
        alloc r := os_sys3(SYS_BIND, s, sa, 16)
        if r == 0 {
            r := os_sys2(SYS_LISTEN, s, 511)
        }
        if r < 0 {
            os_close(s)
            s := r
        }
    }
    rt_free(sa, 16)
    return s
}

# Is this result the error of a non-blocking call that would have had
# to wait?
proc os_would_block(r) {
    return r == 0 - EAGAIN
}

# A connection fresh from accept or connect: send what is written at
# once (TCP_NODELAY). A program that writes a reply in two pieces would
# otherwise have the second held back until the first is acknowledged,
# which the other side may put off for 40 ms.
proc os_tcp_tune(s) {
    alloc one := rt_alloc(16)
    __poke32(one, 1)
    __syscall(SYS_SETSOCKOPT, s, 6, 1, one, 4, 0)
    rt_free(one, 16)
    return 0
}

proc os_tcp_accept(s) {
    loop true {
        alloc r := os_sys3(SYS_ACCEPT, s, 0, 0)
        if r != 0 - EINTR {
            if r >= 0 {
                os_tcp_tune(r)
            }
            return r
        }
    }
    return 0
}

proc os_tcp_connect(host, port) {
    alloc sa := os_sockaddr(host, port)
    if sa == 0 {
        return 0 - E_NO_HOST
    }
    alloc s := os_sys3(SYS_SOCKET, 2, 1, 0)
    if s >= 0 {
        alloc r := os_sys3(SYS_CONNECT, s, sa, 16)
        if r < 0 {
            os_close(s)
            s := r
        } else {
            os_tcp_tune(s)
        }
    }
    rt_free(sa, 16)
    return s
}

proc os_tcp_read(s, p, n) {
    return os_read(s, p, n)
}

# Send n bytes at p: all of them on a blocking socket, as many as there
# is room for on a non-blocking one. Returns the count sent, or a
# negative errno. MSG_NOSIGNAL: a connection the other side has closed
# is an error to report, not a signal that ends the program.
proc os_tcp_write(s, p, n) {
    alloc sent := 0
    loop n > 0 {
        alloc r := __syscall(SYS_SENDTO, s, p, n, 16384, 0, 0)
        if r < 0 {
            if r == 0 - EAGAIN {
                break
            }
            if r != 0 - EINTR {
                return r
            }
        } else {
            p := p + r
            n := n - r
            sent := sent + r
        }
    }
    return sent
}

proc os_tcp_close(s) {
    return os_close(s)
}

proc os_tcp_nonblocking(s, on) {
    alloc fl := os_sys3(SYS_FCNTL, s, 3, 0)                 # F_GETFL
    if fl < 0 {
        return fl
    }
    fl := fl | O_NONBLOCK
    if on == 0 {
        fl := fl - O_NONBLOCK
    }
    return os_sys3(SYS_FCNTL, s, 4, fl)                     # F_SETFL
}

# The other end of a connection as text (see rt_peer_v4), or 0.
proc os_tcp_peer(s) {
    alloc sa := rt_alloc(32)
    __memset(sa, 0, 32)
    __poke32(sa + 28, 28)
    alloc r := os_sys3(SYS_GETPEERNAME, s, sa, sa + 28)
    alloc text := 0
    alloc port := __peek8(sa + 2) * 256 + __peek8(sa + 3)
    if r == 0 and __peek16(sa) == 2 {                       # AF_INET
        text := rt_peer_v4(sa + 4, port)
    } elif r == 0 and __peek16(sa) == 10 {                  # AF_INET6
        text := rt_peer_v6(sa + 8, port)
    }
    rt_free(sa, 32)
    return text
}

# --- waiting for several sockets ----------------------------------------------
#
# An array of the system's pollfd: [0] descriptor (32 bits) [4] what
# to wait for (16 bits) [6] what happened (16 bits). One spare entry at
# the end is for the descriptor that reports requests to stop.

alloc POLLIN := 1
alloc POLLOUT := 4
alloc POLL_TROUBLE := 56       # POLLERR | POLLHUP | POLLNVAL

# Bytes for an array of n entries.
proc os_poll_size(n) {
    return (n + 1) * 8
}

# Entry i: wait for socket s to be readable (want 1) or writable (2).
proc os_poll_set(arr, i, s, want) {
    __poke32(arr + i * 8, s)
    if want == 1 {
        __poke16(arr + i * 8 + 4, POLLIN)
    } else {
        __poke16(arr + i * 8 + 4, POLLOUT)
    }
    __poke16(arr + i * 8 + 6, 0)
    return 0
}

# Wait up to `timeout` milliseconds (negative: without limit) for one
# of n entries. Returns 0 or more, or a negative errno.
proc os_poll_wait(arr, n, timeout) {
    alloc count := n
    if os_sigfd > 0 {
        __poke32(arr + n * 8, os_sigfd - 1)
        __poke16(arr + n * 8 + 4, POLLIN)
        __poke16(arr + n * 8 + 6, 0)
        count := n + 1
    }
    if timeout < 0 {
        timeout := -1
    } elif timeout > 2147483647 {
        timeout := 2147483647
    }
    alloc r := os_sys3(SYS_POLL, arr, count, timeout)
    if r == 0 - EINTR {
        return 0
    }
    return r
}

# What happened to entry i: 1 when it can be read, 2 when it can be
# written. Trouble counts as whichever was asked about.
proc os_poll_got(arr, i) {
    alloc want := __peek16(arr + i * 8 + 4)
    alloc got := __peek16(arr + i * 8 + 6)
    if (got & (want | POLL_TROUBLE)) == 0 {
        return 0
    }
    if want == POLLIN {
        return 1
    }
    return 2
}

# --- a window -------------------------------------------------------------------
#
# A window is opened by speaking the X11 protocol to the display server
# over a socket, with no library in between. What is here is the least
# that shows pictures and hears keys: connect and authenticate, create
# and map one window, PutImage for the pixels, and the four kinds of
# event the runtime cares about. Requests and events are little-endian
# records whose layouts are in the protocol specification ("X Window
# System Protocol", X.Org); the numbers below are from there.

alloc xw_fd := -1
alloc xw_lost := 0             # the server went away and nobody has been told yet
alloc xw_wid := 0
alloc xw_gc := 0
alloc xw_depth := 0
alloc xw_maxreq := 0           # longest request the server takes, in 4-byte units
alloc xw_kmin := 0             # first key code
alloc xw_kcount := 0
alloc xw_kper := 0             # key symbols per key code
alloc xw_keys := 0             # the keyboard mapping: 4 bytes per symbol
alloc xw_keys_size := 0
alloc xw_proto := 0            # the atom WM_PROTOCOLS
alloc xw_delete := 0           # the atom WM_DELETE_WINDOW
alloc xw_w := 0
alloc xw_h := 0
alloc xw_q := 0                # a page for building requests and reading events
alloc xw_extra := 0            # the tail of the last reply
alloc xw_extra_size := 0

proc xw_pad(n) {
    return (n + 3) & -4
}

proc xw_drop() {
    if xw_fd >= 0 {
        os_close(xw_fd)
    }
    xw_fd := -1
    return 0
}

# Read exactly n bytes. 0, or -1 when the server has gone.
proc xw_read(p, n) {
    loop n > 0 {
        alloc r := os_read(xw_fd, p, n)
        if r <= 0 {
            return -1
        }
        p := p + r
        n := n - r
    }
    return 0
}

proc xw_send(p, n) {
    if xw_fd < 0 {
        return -1
    }
    if os_tcp_write(xw_fd, p, n) < 0 {
        xw_drop()
        xw_lost := 1
        return -1
    }
    return 0
}

# Wait for the reply to the request just sent: its first 32 bytes go to
# p, the rest to xw_extra. Events that arrive first are let go. 0, or
# -1 when the server answered with an error or went away.
proc xw_reply(p) {
    loop true {
        if xw_read(p, 32) < 0 {
            return -1
        }
        alloc kind := __peek8(p)
        if kind == 0 {
            return -1
        }
        if kind == 1 {
            alloc more := __peek32(p + 4) * 4
            if xw_extra != 0 {
                rt_free(xw_extra, xw_extra_size)
                xw_extra := 0
            }
            if more > 0 {
                xw_extra := rt_alloc(more)
                xw_extra_size := more
                if xw_read(xw_extra, more) < 0 {
                    return -1
                }
            }
            return 0
        }
    }
    return -1
}

# The number the server knows a name by.
proc xw_atom(name) {
    alloc n := __peek64(name + S_BYTES)
    alloc q := xw_q
    __memset(q, 0, 8 + xw_pad(n))
    __poke8(q, 16)                               # InternAtom
    __poke16(q + 2, 2 + xw_pad(n) // 4)
    __poke16(q + 4, n)
    __memcpy(q + 8, name + S_DATA, n)
    xw_send(q, 8 + xw_pad(n))
    if xw_reply(q) < 0 {
        return 0
    }
    return __peek32(q + 8)
}

# Set a property of the window: `n` items of `format` bits each at p.
proc xw_property(prop, type, format, p, n) {
    alloc bytes := n * (format // 8)
    alloc q := xw_q
    __memset(q, 0, 24 + xw_pad(bytes))
    __poke8(q, 18)                               # ChangeProperty, mode Replace
    __poke16(q + 2, 6 + xw_pad(bytes) // 4)
    __poke32(q + 4, xw_wid)
    __poke32(q + 8, prop)
    __poke32(q + 12, type)
    __poke8(q + 16, format)
    __poke32(q + 20, n)
    __memcpy(q + 24, p, bytes)
    return xw_send(q, 24 + xw_pad(bytes))
}

# Connect to display number `num` on this machine: the socket is a file
# in /tmp/.X11-unix, or (second try) the same name in the abstract
# namespace, which is spelt with a leading NUL.
proc xw_connect_local(num) {
    alloc b := rt_buf_new()
    rt_buf_str(b, "/tmp/.X11-unix/X")
    rt_buf_int(b, num)
    alloc path := rt_buf_finish(b)
    alloc n := __peek64(path + S_BYTES)
    alloc sa := rt_alloc(128)
    alloc s := -1
    alloc pass := 0
    loop pass < 2 and s < 0 {
        __memset(sa, 0, 128)
        __poke16(sa, 1)                          # AF_UNIX
        __memcpy(sa + 2 + pass, path + S_DATA, n)
        s := os_sys3(SYS_SOCKET, 1, 524289, 0)   # SOCK_STREAM | SOCK_CLOEXEC
        if s >= 0 {
            if os_sys3(SYS_CONNECT, s, sa, 3 + n) < 0 {
                os_close(s)
                s := -1
            }
        }
        pass := pass + 1
    }
    rt_free(sa, 128)
    rt_drop(T_STR, path)
    return s
}

# Look in the X authority file for the secret ("cookie") that lets a
# program use display `num`. The file is a run of records: a 16-bit
# family, then four fields led by their 16-bit length (address, display
# number, method name, secret), all big-endian. Returns the address of
# the secret's length field, or 0; `file` gets the buffer to free.
proc xw_cookie(num, file) {
    alloc path := 0
    alloc env := os_getenv("XAUTHORITY=")
    if env != 0 and __peek8(env) != 0 {
        path := rt_str_from_c(env)
    } else {
        alloc home := os_getenv("HOME=")
        if home == 0 {
            return 0
        }
        alloc b := rt_buf_new()
        rt_buf_add(b, home, os_cstr_len(home))
        rt_buf_str(b, "/.Xauthority")
        path := rt_buf_finish(b)
    }
    alloc fd := os_open(path, 0)
    rt_drop(T_STR, path)
    if fd < 0 {
        return 0
    }
    alloc data := rt_read_all(fd)
    os_close(fd)
    __poke64(file, data)
    alloc want := rt_buf_new()
    rt_buf_int(want, num)
    alloc wn := __peek64(want + 8)
    alloc p := __peek64(data)
    alloc end := p + __peek64(data + 8)
    alloc found := 0
    loop found == 0 and p + 10 <= end {
        alloc q := p + 2
        alloc alen := __peek8(q) * 256 + __peek8(q + 1)
        q := q + 2 + alen
        if q + 2 > end { break }
        alloc nlen := __peek8(q) * 256 + __peek8(q + 1)
        alloc number := q + 2
        q := number + nlen
        if q + 2 > end { break }
        alloc mlen := __peek8(q) * 256 + __peek8(q + 1)
        alloc method := q + 2
        q := method + mlen
        if q + 2 > end { break }
        alloc slen := __peek8(q) * 256 + __peek8(q + 1)
        if q + 2 + slen > end { break }
        alloc number_ok := nlen == 0
        if nlen == wn {
            number_ok := __memcmp(number, __peek64(want), wn) == 0
        }
        if number_ok and mlen == 18 {
            if __memcmp(method, "MIT-MAGIC-COOKIE-1" + S_DATA, 18) == 0 {
                found := q
            }
        }
        p := q + 2 + slen
    }
    rt_free(__peek64(want), __peek64(want + 16))
    rt_free(want, 24)
    return found
}

# Which key a key symbol is, in the runtime's own numbering (see
# rt_win_key_name): the character for the printable ones, 256 and up
# for the rest, 0 for a key that is not reported.
proc xw_key(sym) {
    if sym >= 32 and sym < 127 { return sym }
    if sym == 65307 { return 256 }               # Escape
    if sym == 65293 or sym == 65421 { return 257 }
    if sym == 65361 { return 258 }
    if sym == 65363 { return 259 }
    if sym == 65362 { return 260 }
    if sym == 65364 { return 261 }
    if sym == 65289 { return 262 }
    if sym == 65288 { return 263 }
    if sym == 65535 { return 264 }
    if sym == 65360 { return 265 }
    if sym == 65367 { return 266 }
    if sym == 65365 { return 267 }
    if sym == 65366 { return 268 }
    if sym >= 65470 and sym <= 65481 { return 270 + sym - 65470 }
    return 0
}

# Open the window. Returns 0, or a string that says what went wrong.
proc os_win_open(title, w, h) {
    alloc d := os_getenv("DISPLAY=")
    if d == 0 {
        return "DISPLAY is not set, so there is no X server to show a window on"
    }
    alloc dn := os_cstr_len(d)
    alloc colon := -1
    alloc i := 0
    loop i < dn {
        if __peek8(d + i) == 58 {
            colon := i
        }
        i := i + 1
    }
    if colon < 0 or colon + 1 >= dn {
        return "DISPLAY is not of the form host:number"
    }
    alloc num := 0
    i := colon + 1
    loop i < dn and __peek8(d + i) >= 48 and __peek8(d + i) <= 57 {
        num := num * 10 + __peek8(d + i) - 48
        i := i + 1
    }
    alloc s := -1
    if colon == 0 or (colon == 4 and __memcmp(d, "unix" + S_DATA, 4) == 0) {
        s := xw_connect_local(num)
    } else {
        alloc host := rt_str_from(d, colon)
        s := os_tcp_connect(host, 6000 + num)
        rt_drop(T_STR, host)
    }
    if s < 0 {
        return "cannot reach the X server that DISPLAY names"
    }
    xw_fd := s
    xw_lost := 0
    if xw_q == 0 {
        xw_q := os_alloc(4096)
    }
    alloc q := xw_q

    # Say hello: byte order, protocol 11.0, and the secret if there is one.
    alloc file := rt_alloc(16)
    __poke64(file, 0)
    alloc cookie := xw_cookie(num, file)
    alloc clen := 0
    __memset(q, 0, 64)
    __poke8(q, 108)                              # "l": least significant byte first
    __poke16(q + 2, 11)
    alloc hello := 12
    if cookie != 0 {
        clen := __peek8(cookie) * 256 + __peek8(cookie + 1)
        if clen > 256 {
            clen := 0
        }
    }
    if clen > 0 {
        __poke16(q + 6, 18)
        __poke16(q + 8, clen)
        __memcpy(q + 12, "MIT-MAGIC-COOKIE-1" + S_DATA, 18)
        __memset(q + 32, 0, xw_pad(clen))
        __memcpy(q + 32, cookie + 2, clen)
        hello := 32 + xw_pad(clen)
    }
    alloc data := __peek64(file)
    if data != 0 {
        rt_free(__peek64(data), __peek64(data + 16))
        rt_free(data, 24)
    }
    rt_free(file, 16)
    xw_send(q, hello)
    if xw_read(q, 8) < 0 {
        xw_drop()
        return "the X server closed the connection"
    }
    alloc status := __peek8(q)
    alloc reason_len := __peek8(q + 1)
    alloc more := __peek16(q + 6) * 4
    alloc rep := rt_alloc(more + 8)
    if xw_read(rep, more) < 0 {
        xw_drop()
        return "the X server closed the connection"
    }
    if status != 1 {
        alloc why := "the X server refused the connection"
        if status == 0 and reason_len > 0 and reason_len <= more {
            alloc text := rt_str_from(rep, reason_len)
            why := rt_str_concat("the X server refused the connection: ", text)
        }
        rt_free(rep, more + 8)
        xw_drop()
        return why
    }
    # Offsets below are those of the whole reply, of which rep holds
    # everything after the first 8 bytes.
    alloc r := rep - 8
    alloc id_base := __peek32(r + 12)
    alloc vendor := __peek16(r + 24)
    xw_maxreq := __peek16(r + 26)
    alloc nformats := __peek8(r + 29)
    alloc msb_first := __peek8(r + 30)
    xw_kmin := __peek8(r + 34)
    xw_kcount := __peek8(r + 35) - xw_kmin + 1
    alloc formats := r + 40 + xw_pad(vendor)
    alloc screen := formats + nformats * 8
    alloc root := __peek32(screen)
    xw_depth := __peek8(screen + 38)
    alloc bpp := 0
    i := 0
    loop i < nformats {
        if __peek8(formats + i * 8) == xw_depth {
            bpp := __peek8(formats + i * 8 + 1)
        }
        i := i + 1
    }
    rt_free(rep, more + 8)
    if bpp != 32 or msb_first != 0 or xw_depth < 24 {
        xw_drop()
        return "the display is not one of 24-bit colour, which is all this knows how to draw on"
    }
    xw_wid := id_base + 1
    xw_gc := id_base + 2

    # Names the window manager goes by.
    xw_proto := xw_atom("WM_PROTOCOLS")
    xw_delete := xw_atom("WM_DELETE_WINDOW")
    alloc net_name := xw_atom("_NET_WM_NAME")
    alloc utf8 := xw_atom("UTF8_STRING")

    # The keyboard: which symbols each key code stands for.
    __memset(q, 0, 8)
    __poke8(q, 101)                              # GetKeyboardMapping
    __poke16(q + 2, 2)
    __poke8(q + 4, xw_kmin)
    __poke8(q + 5, xw_kcount)
    xw_send(q, 8)
    xw_kper := 0
    if xw_reply(q) == 0 {
        xw_kper := __peek8(q + 1)
        if xw_keys != 0 {
            rt_free(xw_keys, xw_keys_size)
        }
        xw_keys := xw_extra
        xw_keys_size := xw_extra_size
        xw_extra := 0
        if xw_keys_size < xw_kcount * xw_kper * 4 {
            xw_kper := 0
        }
    }

    __memset(q, 0, 40)
    __poke8(q, 1)                                # CreateWindow, depth as the parent's
    __poke16(q + 2, 10)
    __poke32(q + 4, xw_wid)
    __poke32(q + 8, root)
    __poke16(q + 16, w)
    __poke16(q + 18, h)
    __poke16(q + 22, 1)                          # InputOutput
    __poke32(q + 28, 2050)                       # values: background pixel, event mask
    __poke32(q + 32, 0)                          # black
    __poke32(q + 36, 163841)                     # KeyPress | Exposure | StructureNotify
    xw_send(q, 40)

    alloc tn := __peek64(title + S_BYTES)
    if tn > 1024 {
        tn := 1024
    }
    xw_property(39, 31, 8, title + S_DATA, tn)   # WM_NAME, of type STRING
    if net_name != 0 and utf8 != 0 {
        xw_property(net_name, utf8, 8, title + S_DATA, tn)
    }
    if xw_proto != 0 and xw_delete != 0 {
        # ask to be told, not killed, when the user closes the window
        alloc cell := rt_alloc(16)
        __poke32(cell, xw_delete)
        xw_property(xw_proto, 4, 32, cell, 1)    # of type ATOM
        rt_free(cell, 16)
    }

    __memset(q, 0, 16)
    __poke8(q, 55)                               # CreateGC
    __poke16(q + 2, 4)
    __poke32(q + 4, xw_gc)
    __poke32(q + 8, xw_wid)
    xw_send(q, 16)

    __memset(q, 0, 8)
    __poke8(q, 8)                                # MapWindow
    __poke16(q + 2, 2)
    __poke32(q + 4, xw_wid)
    xw_send(q, 8)
    xw_w := w
    xw_h := h
    if xw_fd < 0 {
        return "the X server closed the connection"
    }
    return 0
}

# Put w x h pixels (4 bytes each) at the top left of the window. One
# request cannot carry more than xw_maxreq words, so a large picture
# goes in bands.
proc os_win_blit(buf, w, h) {
    alloc q := xw_q
    alloc band := (xw_maxreq - 6) // w
    if band < 1 {
        return 0
    }
    alloc y := 0
    loop y < h and xw_fd >= 0 {
        alloc rows := h - y
        if rows > band {
            rows := band
        }
        __poke8(q, 72)                           # PutImage
        __poke8(q + 1, 2)                        # ZPixmap
        __poke16(q + 2, 6 + rows * w)
        __poke32(q + 4, xw_wid)
        __poke32(q + 8, xw_gc)
        __poke16(q + 12, w)
        __poke16(q + 14, rows)
        __poke16(q + 16, 0)
        __poke16(q + 18, y)
        __poke8(q + 20, 0)
        __poke8(q + 21, xw_depth)
        __poke16(q + 22, 0)
        xw_send(q, 24)
        xw_send(buf + y * w * 4, rows * w * 4)
        y := y + rows
    }
    return 0
}

# The next thing that happened, without waiting: 0 nothing, 1 a key
# (its number in out), 2 the window is to close, 3 it changed size
# (width and height in out), 4 it needs painting again.
proc os_win_event(out) {
    alloc q := xw_q
    loop true {
        if xw_fd < 0 {
            if xw_lost {
                xw_lost := 0
                return 2
            }
            return 0
        }
        __poke32(q, xw_fd)
        __poke16(q + 4, POLLIN)
        __poke16(q + 6, 0)
        if os_sys3(SYS_POLL, q, 1, 0) <= 0 {
            return 0
        }
        if xw_read(q, 32) < 0 {
            xw_drop()
            return 2
        }
        alloc code := __peek8(q) & 127
        if code == 1 {
            # a reply nobody waits for: skip its tail
            alloc more := __peek32(q + 4) * 4
            loop more > 0 {
                alloc step := more
                if step > 4096 {
                    step := 4096
                }
                if xw_read(q, step) < 0 {
                    xw_drop()
                    return 2
                }
                more := more - step
            }
        } elif code == 2 {                       # KeyPress
            alloc at := __peek8(q + 1) - xw_kmin
            if xw_kper > 0 and at >= 0 and at < xw_kcount {
                alloc sym := __peek32(xw_keys + at * xw_kper * 4)
                if (__peek16(q + 28) & 1) != 0 and xw_kper > 1 {
                    # Shift is down: the second symbol, when it is a character
                    alloc upper := __peek32(xw_keys + (at * xw_kper + 1) * 4)
                    if upper >= 32 and upper < 127 {
                        sym := upper
                    }
                }
                alloc key := xw_key(sym)
                if key != 0 {
                    __poke64(out, key)
                    return 1
                }
            }
        } elif code == 12 {                      # Expose
            if __peek16(q + 16) == 0 {
                return 4
            }
        } elif code == 22 {                      # ConfigureNotify
            alloc nw := __peek16(q + 20)
            alloc nh := __peek16(q + 22)
            if (nw != xw_w or nh != xw_h) and nw > 0 and nh > 0 {
                xw_w := nw
                xw_h := nh
                __poke64(out, nw)
                __poke64(out + 8, nh)
                return 3
            }
        } elif code == 33 {                      # ClientMessage
            if __peek32(q + 8) == xw_proto and __peek32(q + 12) == xw_delete {
                return 2
            }
        } elif code == 17 {                      # DestroyNotify: someone else closed it
            if __peek32(q + 8) == xw_wid {
                xw_drop()
                return 2
            }
        }
    }
    return 0
}

proc os_win_close() {
    xw_drop()
    xw_lost := 0
    return 0
}

# --- sound ---------------------------------------------------------------------
#
# Sound goes to the sound server, over its Unix socket, in the server's
# own protocol: PulseAudio's "native" protocol, which PipeWire speaks
# as well (pipewire-pulse), so this covers the desktops there are, and
# WSL. Nothing is linked in: the protocol is a few commands, each a
# 20-byte header (length, channel, three words unused here) and a body
# of tagged values ('L' and four bytes for a number, 't' and a C string,
# and so on). Sound itself is the same header with the stream's channel
# number, and the samples as the body.
#
# The server says how many bytes it wants (REQUEST), and only that many
# are ever sent, which is what keeps audio_write from waiting.

alloc PA_NONE := 4294967295
alloc PA_TARGET_MS := 500      # how much sound waits in the server

alloc pa_fd := -1
alloc pa_tag := 0              # commands are numbered; the reply names the number
alloc pa_channel := 0          # the stream, as the server numbers it
alloc pa_credit := 0           # bytes asked for and not sent yet
alloc pa_sent := 0             # bytes sent in all
alloc pa_heard := 0            # bytes heard, as last worked out
alloc pa_frame := 0            # bytes for one moment: 2 a channel
alloc pa_rate := 0             # bytes a second
alloc pa_head := 0             # 20 bytes
alloc pa_body := 0             # the body of the packet last read
alloc pa_body_size := 0
alloc pa_body_len := 0
alloc pa_wrote_at := 0         # when sound was last sent, in ms
alloc pa_told := 1             # has the server been told to play out what it holds?
alloc pa_paused := 0

proc pa_drop() {
    if pa_fd >= 0 {
        os_close(pa_fd)
    }
    pa_fd := -1
    return 0
}

proc pa_raw32(b, v) {
    rt_buf_byte(b, (v >> 24) & 255)
    rt_buf_byte(b, (v >> 16) & 255)
    rt_buf_byte(b, (v >> 8) & 255)
    rt_buf_byte(b, v & 255)
    return 0
}

proc pa_u32(b, v) {
    rt_buf_byte(b, 76)                           # 'L'
    return pa_raw32(b, v)
}

proc pa_string(b, s) {
    rt_buf_byte(b, 116)                          # 't'
    rt_buf_str(b, s)
    return rt_buf_byte(b, 0)
}

proc pa_bool(b, v) {
    if v {
        return rt_buf_byte(b, 49)                # '1'
    }
    return rt_buf_byte(b, 48)                    # '0'
}

# A list of properties with one entry, which is all that is needed.
proc pa_props(b, key, value) {
    alloc n := __peek64(value + S_BYTES) + 1
    rt_buf_byte(b, 80)                           # 'P'
    pa_string(b, key)
    pa_u32(b, n)
    rt_buf_byte(b, 120)                          # 'x'
    pa_raw32(b, n)
    rt_buf_str(b, value)
    rt_buf_byte(b, 0)
    return rt_buf_byte(b, 78)                    # 'N': no more
}

# Start a command: the header, then its number and its tag.
proc pa_begin(cmd) {
    alloc b := rt_buf_new()
    pa_raw32(b, 0)
    pa_raw32(b, PA_NONE)
    pa_raw32(b, 0)
    pa_raw32(b, 0)
    pa_raw32(b, 0)
    pa_tag := pa_tag + 1
    pa_u32(b, cmd)
    pa_u32(b, pa_tag)
    return b
}

proc pa_send(b) {
    alloc p := __peek64(b)
    alloc n := __peek64(b + 8)
    alloc len := n - 20
    __poke8(p, (len >> 24) & 255)
    __poke8(p + 1, (len >> 16) & 255)
    __poke8(p + 2, (len >> 8) & 255)
    __poke8(p + 3, len & 255)
    alloc r := -1
    if pa_fd >= 0 {
        r := os_tcp_write(pa_fd, p, n)
    }
    rt_free(p, __peek64(b + 16))
    rt_free(b, 24)
    if r < 0 {
        pa_drop()
        return -1
    }
    return 0
}

proc pa_be32(p) {
    return (__peek8(p) << 24) | (__peek8(p + 1) << 16) | (__peek8(p + 2) << 8) | __peek8(p + 3)
}

proc pa_read(p, n) {
    loop n > 0 {
        alloc r := os_read(pa_fd, p, n)
        if r <= 0 {
            return -1
        }
        p := p + r
        n := n - r
    }
    return 0
}

# Read one packet into pa_body. Returns the command it carries, -1 when
# the server has gone, -2 for a packet that is not a command.
proc pa_packet() {
    if pa_fd < 0 or pa_read(pa_head, 20) < 0 {
        pa_drop()
        return -1
    }
    alloc len := pa_be32(pa_head)
    if len > 1048576 {
        pa_drop()
        return -1
    }
    if len > pa_body_size {
        if pa_body != 0 {
            rt_free(pa_body, pa_body_size)
        }
        pa_body_size := len + 256
        pa_body := rt_alloc(pa_body_size)
    }
    pa_body_len := len
    if pa_read(pa_body, len) < 0 {
        pa_drop()
        return -1
    }
    if pa_be32(pa_head + 4) != PA_NONE or len < 10 {
        return -2
    }
    alloc cmd := pa_be32(pa_body + 1)
    if cmd == 61 and len >= 20 {                 # REQUEST: the server wants more
        if pa_be32(pa_body + 11) == pa_channel {
            pa_credit := pa_credit + pa_be32(pa_body + 16)
        }
    } elif cmd == 64 {                           # the stream was killed
        pa_drop()
        return -1
    }
    return cmd
}

# Take in whatever the server has sent, without waiting.
proc pa_pump() {
    loop pa_fd >= 0 {
        __poke32(pa_head, pa_fd)
        __poke16(pa_head + 4, POLLIN)
        __poke16(pa_head + 6, 0)
        if os_sys3(SYS_POLL, pa_head, 1, 0) <= 0 {
            break
        }
        pa_packet()
    }
    return 0
}

# Wait for the reply to the command just sent. 0, or -1 when the server
# said no, went away, or has said nothing for three seconds.
proc pa_reply() {
    loop true {
        __poke32(pa_head, pa_fd)
        __poke16(pa_head + 4, POLLIN)
        __poke16(pa_head + 6, 0)
        if pa_fd < 0 or os_sys3(SYS_POLL, pa_head, 1, 3000) == 0 {
            pa_drop()
            return -1
        }
        alloc cmd := pa_packet()
        if cmd == -1 {
            return -1
        }
        if cmd == 0 or cmd == 2 {                # ERROR, REPLY
            if pa_be32(pa_body + 6) == pa_tag {
                if cmd == 0 {
                    return -1
                }
                return 0
            }
        }
    }
    return -1
}

proc pa_connect_path(p, n) {
    if n > 100 {
        return -1
    }
    alloc sa := rt_alloc(128)
    __memset(sa, 0, 128)
    __poke16(sa, 1)                              # AF_UNIX
    __memcpy(sa + 2, p, n)
    alloc s := os_sys3(SYS_SOCKET, 1, 524289, 0) # SOCK_STREAM | SOCK_CLOEXEC
    if s >= 0 {
        if os_sys3(SYS_CONNECT, s, sa, 3 + n) < 0 {
            os_close(s)
            s := -1
        }
    }
    rt_free(sa, 128)
    return s
}

# The socket is named by PULSE_SERVER (as unix:/path or /path), or is
# pulse/native under PULSE_RUNTIME_PATH's or XDG_RUNTIME_DIR's folder,
# or under /run/user/<user number>.
proc pa_connect() {
    alloc env := os_getenv("PULSE_SERVER=")
    if env != 0 and __peek8(env) != 0 {
        if __memcmp(env, "unix:" + S_DATA, 5) == 0 {
            env := env + 5
        }
        if __peek8(env) != 47 {
            return -1                            # a server on another machine
        }
        return pa_connect_path(env, os_cstr_len(env))
    }
    alloc b := rt_buf_new()
    env := os_getenv("PULSE_RUNTIME_PATH=")
    if env != 0 and __peek8(env) != 0 {
        rt_buf_add(b, env, os_cstr_len(env))
        rt_buf_str(b, "/native")
    } else {
        env := os_getenv("XDG_RUNTIME_DIR=")
        if env != 0 and __peek8(env) != 0 {
            rt_buf_add(b, env, os_cstr_len(env))
        } else {
            rt_buf_str(b, "/run/user/")
            rt_buf_int(b, os_sys1(SYS_GETUID, 0))
        }
        rt_buf_str(b, "/pulse/native")
    }
    alloc s := pa_connect_path(__peek64(b), __peek64(b + 8))
    rt_free(__peek64(b), __peek64(b + 16))
    rt_free(b, 24)
    return s
}

# The secret that says this program may use the server: 256 bytes in a
# file named by PULSE_COOKIE, or ~/.config/pulse/cookie, or
# ~/.pulse-cookie. A server that asks for none takes whatever is sent.
proc pa_cookie(out) {
    __memset(out, 0, 256)
    alloc pass := 0
    loop pass < 3 {
        alloc path := 0
        if pass == 0 {
            alloc env := os_getenv("PULSE_COOKIE=")
            if env != 0 and __peek8(env) != 0 {
                path := rt_str_from_c(env)
            }
        } else {
            alloc home := os_getenv("HOME=")
            if home != 0 {
                alloc b := rt_buf_new()
                rt_buf_add(b, home, os_cstr_len(home))
                if pass == 1 {
                    rt_buf_str(b, "/.config/pulse/cookie")
                } else {
                    rt_buf_str(b, "/.pulse-cookie")
                }
                path := rt_buf_finish(b)
            }
        }
        if path != 0 {
            alloc fd := os_open(path, 0)
            rt_drop(T_STR, path)
            if fd >= 0 {
                alloc got := os_read(fd, out, 256)
                os_close(fd)
                if got == 256 {
                    return 0
                }
                __memset(out, 0, 256)
            }
        }
        pass := pass + 1
    }
    return 0
}

# Open a stream. Returns 0, or a string that says what went wrong.
proc os_snd_open(rate, channels) {
    if pa_head == 0 {
        pa_head := rt_alloc(32)
    }
    pa_fd := pa_connect()
    if pa_fd < 0 {
        return "no sound server answers (PulseAudio or PipeWire, at $XDG_RUNTIME_DIR/pulse/native or $PULSE_SERVER)"
    }
    pa_tag := 0
    # who we are: protocol version 13 (the oldest with these commands), and the cookie
    alloc b := pa_begin(8)                       # AUTH
    pa_u32(b, 13)
    alloc cookie := rt_alloc(256)
    pa_cookie(cookie)
    rt_buf_byte(b, 120)                          # 'x'
    pa_raw32(b, 256)
    rt_buf_add(b, cookie, 256)
    rt_free(cookie, 256)
    if pa_send(b) < 0 or pa_reply() < 0 {
        pa_drop()
        return "the sound server turned the program away"
    }
    b := pa_begin(9)                             # SET_CLIENT_NAME
    pa_props(b, "application.name", "OMG")
    if pa_send(b) < 0 or pa_reply() < 0 {
        pa_drop()
        return "the sound server turned the program away"
    }
    pa_frame := 2 * channels
    pa_rate := rate * pa_frame
    alloc want := pa_rate * PA_TARGET_MS // 1000
    b := pa_begin(3)                             # CREATE_PLAYBACK_STREAM
    rt_buf_byte(b, 97)                           # 'a': 16 bits little-endian, channels, rate
    rt_buf_byte(b, 3)
    rt_buf_byte(b, channels)
    pa_raw32(b, rate)
    rt_buf_byte(b, 109)                          # 'm': mono, or left and right
    rt_buf_byte(b, channels)
    if channels == 1 {
        rt_buf_byte(b, 0)
    } else {
        rt_buf_byte(b, 1)
        rt_buf_byte(b, 2)
    }
    pa_u32(b, PA_NONE)                           # any device
    rt_buf_byte(b, 78)                           # 'N': no device name
    pa_u32(b, PA_NONE)                           # the most the server may hold: its choice
    pa_bool(b, 0)                                # not paused
    pa_u32(b, want)                              # how much it should like to hold
    pa_u32(b, want // 4)                         # how much before it starts (again)
    pa_u32(b, pa_rate // 50)                     # ask again for every fiftieth of a second played
    pa_u32(b, 0)
    rt_buf_byte(b, 118)                          # 'v': volume of each channel, 0x10000 = as it is
    rt_buf_byte(b, channels)
    pa_raw32(b, 65536)
    if channels == 2 {
        pa_raw32(b, 65536)
    }
    alloc i := 0
    loop i < 8 {                                 # seven flags, and "muted": all off
        pa_bool(b, 0)
        i := i + 1
    }
    pa_bool(b, 1)                                # count the device's own delay in the total
    pa_props(b, "media.name", "OMG")
    if pa_send(b) < 0 or pa_reply() < 0 {
        pa_drop()
        return "the sound server refused the stream"
    }
    # The reply: command and tag, then the stream's number, the server's
    # number for it, and how much it wants.
    alloc p := pa_body + 10
    pa_channel := pa_be32(p + 1)
    pa_credit := pa_be32(p + 11)
    pa_sent := 0
    pa_heard := 0
    pa_told := 1
    pa_paused := 0
    return 0
}

# A server keeps back sound that is too short to be worth starting on:
# PulseAudio at the start of a stream (it waits for a share of what it
# was asked to hold), PipeWire whenever less is left than it plays in
# one go, which is always so at the end. Both play all they hold once
# told that the stream is draining; so they are told when nothing has
# been written for a fifth of a second. No answer is waited for (it
# comes when the sound is out, and is passed over like any other
# packet that is not being waited for).
proc pa_finish() {
    if pa_told or pa_paused or pa_fd < 0 or os_time_ms() - pa_wrote_at < 200 {
        return 0
    }
    pa_told := 1
    alloc b := pa_begin(12)                      # DRAIN_PLAYBACK_STREAM
    pa_u32(b, pa_channel)
    return pa_send(b)
}

# How many bytes the stream will take now; -1 when it has gone.
proc os_snd_room() {
    pa_pump()
    pa_finish()
    if pa_fd < 0 {
        return -1
    }
    return pa_credit
}

proc os_snd_write(p, n) {
    if pa_fd < 0 {
        return -1
    }
    alloc h := pa_head
    __poke8(h, (n >> 24) & 255)
    __poke8(h + 1, (n >> 16) & 255)
    __poke8(h + 2, (n >> 8) & 255)
    __poke8(h + 3, n & 255)
    __poke8(h + 4, (pa_channel >> 24) & 255)
    __poke8(h + 5, (pa_channel >> 16) & 255)
    __poke8(h + 6, (pa_channel >> 8) & 255)
    __poke8(h + 7, pa_channel & 255)
    __memset(h + 8, 0, 12)
    if os_tcp_write(pa_fd, h, 20) < 0 or os_tcp_write(pa_fd, p, n) < 0 {
        pa_drop()
        return -1
    }
    pa_credit := pa_credit - n
    pa_sent := pa_sent + n
    pa_wrote_at := os_time_ms()
    pa_told := 0
    return n
}

proc pa_be64(p) {
    return (pa_be32(p) << 32) | pa_be32(p + 4)
}

# How many moments of sound have been heard. The server is asked: it
# answers with how far it has read into what it was sent, and how long
# what it has read takes to reach the loudspeaker.
proc os_snd_played() {
    pa_pump()
    pa_finish()
    if pa_fd < 0 {
        return pa_heard // pa_frame
    }
    alloc b := pa_begin(14)                      # GET_PLAYBACK_LATENCY
    pa_u32(b, pa_channel)
    rt_buf_byte(b, 84)                           # 'T': the time here, which is only sent back
    pa_raw32(b, 0)
    pa_raw32(b, 0)
    if pa_send(b) < 0 or pa_reply() < 0 or pa_body_len < 65 {
        return pa_heard // pa_frame
    }
    # 'U' delay in the device, 'U' unused, whether it is playing, two
    # times, 'R' bytes written, 'R' bytes read
    alloc delay := pa_be64(pa_body + 11)
    alloc playing := __peek8(pa_body + 28) == 49
    alloc read := pa_be64(pa_body + 57)
    alloc heard := read - delay * pa_rate // 1000000
    if playing == 0 and read >= pa_sent {
        heard := pa_sent                         # it has run dry: all of it was heard
    }
    if heard > pa_sent {
        heard := pa_sent
    }
    heard := heard - heard % pa_frame
    if heard > pa_heard {
        pa_heard := heard
    }
    return pa_heard // pa_frame
}

proc os_snd_pause(on) {
    if pa_fd < 0 {
        return -1
    }
    alloc b := pa_begin(41)                      # CORK_PLAYBACK_STREAM
    pa_u32(b, pa_channel)
    pa_bool(b, on)
    if pa_send(b) < 0 {
        return -1
    }
    pa_paused := on
    pa_wrote_at := os_time_ms()
    return pa_reply()
}

proc os_snd_close() {
    pa_drop()
    return 0
}
